root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,axaml,xml,manifest,json,yml}]
indent_size = 2

[*.cs]
# Logging volume is low (lifecycle events, not hot paths); structured LogXxx calls are fine.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

[tests/**.cs]
# Test method names use underscores for readability.
dotnet_diagnostic.CA1707.severity = none
