<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Shorekeeper.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Shorekeeper.UI/Themes/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Shorekeeper.UI/Themes/Motion.axaml" />
    <StyleInclude Source="avares://Shorekeeper.UI/Themes/Menus.axaml" />
    <Style Selector=":is(Window)">
      <Setter Property="Background" Value="{DynamicResource Sk.WindowBackground}" />
    </Style>
  </Application.Styles>
</Application>
