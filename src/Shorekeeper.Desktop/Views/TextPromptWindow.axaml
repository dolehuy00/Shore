<Window xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Shorekeeper.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shorekeeper.Desktop.ViewModels"
        x:Class="Shorekeeper.Desktop.Views.TextPromptWindow"
        x:DataType="vm:TextPromptViewModel"
        Title="{Binding Title}"
        Icon="/Assets/shorekeeper.png"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBox.multiline">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Height" Value="140" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
  </Window.Styles>
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="{Binding Label}" />
    <TextBox Text="{Binding Text}" AcceptsReturn="{Binding IsMultiline}" Classes.multiline="{Binding IsMultiline}" />
    <CheckBox IsVisible="{Binding HasOption}" IsChecked="{Binding IsOptionChecked}">
      <TextBlock Text="{Binding OptionText}" TextWrapping="Wrap" />
    </CheckBox>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{l:T 'Hủy'}" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Content="{Binding OkText}" Command="{Binding OkCommand}" IsDefault="True" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
