<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shorekeeper.Desktop.ViewModels"
        x:Class="Shorekeeper.Desktop.Views.TextPromptWindow"
        x:DataType="vm:TextPromptViewModel"
        Title="{Binding Title}"
        Icon="/Assets/shorekeeper.png"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="{Binding Label}" />
    <TextBox Text="{Binding Text}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Hủy" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Content="Lưu" Command="{Binding OkCommand}" IsDefault="True" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
