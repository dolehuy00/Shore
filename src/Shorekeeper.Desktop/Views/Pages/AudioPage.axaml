<!-- Âm thanh: this computer's sound for contacts, and the contacts' sound here. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Shorekeeper.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shorekeeper.Desktop.ViewModels"
             xmlns:ui="using:Shorekeeper.UI.ViewModels"
             x:Class="Shorekeeper.Desktop.Views.Pages.AudioPage"
             x:DataType="vm:MainWindowViewModel">
  <StackPanel Classes="page" IsVisible="{Binding IsAudioVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
    <TextBlock Classes="h2" Text="{l:T 'Âm thanh'}" />

    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="tile">
            <PathIcon Data="{StaticResource Icon.Speaker}" Width="22" Height="22" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{l:T 'Phát âm thanh'}" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{l:T 'Máy đã kết nối thấy máy này đang phát và tự bấm Nghe khi muốn. Tắt là mọi máy đang nghe đều dừng.'}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" IsChecked="{Binding Audio.IsPlaying}" IsEnabled="{Binding Audio.CanPlay}" OnContent="" OffContent=""
                        MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Phát âm thanh'}" />
        </Grid>

        <!-- Optional password: a listener types it once, then its device remembers it. -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource Icon.Lock}" Width="16" Height="16" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="8,0,12,0" VerticalAlignment="Center"
                     Text="{l:T 'Không có mật khẩu: máy đã kết nối nào cũng nghe được.'}" IsVisible="{Binding !Audio.HasPassword}" />
          <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="8,0,12,0" VerticalAlignment="Center"
                     Text="{l:T 'Có mật khẩu: máy muốn nghe nhập một lần, sau đó tự nhớ.'}" IsVisible="{Binding Audio.HasPassword}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Content="{l:T 'Đặt mật khẩu…'}" Command="{Binding Audio.SetPasswordCommand}" IsVisible="{Binding !Audio.HasPassword}" />
            <Button Content="{l:T 'Đổi mật khẩu…'}" Command="{Binding Audio.SetPasswordCommand}" IsVisible="{Binding Audio.HasPassword}" />
            <Button Content="{l:T 'Bỏ mật khẩu'}" Command="{Binding Audio.RemovePasswordCommand}" IsVisible="{Binding Audio.HasPassword}" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="6" IsVisible="{Binding Audio.IsPlaying}">
          <TextBlock Classes="h3" Text="{l:T 'Đang nghe'}" />
          <TextBlock Classes="muted" Text="{l:T 'Chưa ai nghe'}" IsVisible="{Binding !Audio.HasListeners}" FontSize="12" />
          <ItemsControl ItemsSource="{Binding Audio.Listeners}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ui:AudioListenerItem">
                <!-- What the host may do, for this listener alone. -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                  <Panel VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="16" Height="16" />
                    <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="16" Height="16" />
                  </Panel>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <ToggleButton Classes="icon" IsChecked="{Binding AllowsControl}" IsVisible="{Binding CanOfferControl}"
                                  ToolTip.Tip="{l:T 'Cho điều khiển'}" AutomationProperties.Name="{l:T 'Cho điều khiển'}">
                      <PathIcon Data="{StaticResource Icon.PlayPause}" Width="16" Height="16" />
                    </ToggleButton>
                    <Button Classes="icon" Command="{Binding StopCommand}" ToolTip.Tip="{l:T 'Ngừng phát'}" AutomationProperties.Name="{l:T 'Ngừng phát'}">
                      <PathIcon Data="{StaticResource Icon.SpeakerOff}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon" Command="{Binding KeepOutCommand}" ToolTip.Tip="{l:T 'Không cho nghe'}" AutomationProperties.Name="{l:T 'Không cho nghe'}">
                      <PathIcon Data="{StaticResource Icon.Block}" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- What the icons of each listener do. -->
          <StackPanel Spacing="3" IsVisible="{Binding Audio.HasListeners}">
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Audio.CanOfferControl}">
              <PathIcon Data="{StaticResource Icon.PlayPause}" Width="12" Height="12" Opacity="0.7" VerticalAlignment="Top" Margin="0,2,6,0" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Cho điều khiển: máy đó bấm được Phát/Dừng, chuyển bài và âm lượng ở máy này.'}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource Icon.SpeakerOff}" Width="12" Height="12" Opacity="0.7" VerticalAlignment="Top" Margin="0,2,6,0" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Ngừng phát: ngắt máy đó, máy đó bấm Nghe lại được.'}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource Icon.Block}" Width="12" Height="12" Opacity="0.7" VerticalAlignment="Top" Margin="0,2,6,0" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Không cho nghe: máy đó không vào lại được cho tới khi bạn tắt rồi bật lại Phát âm thanh.'}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Nghe: contacts with "Phát âm thanh" on. -->
    <Border Classes="card" IsVisible="{Binding Audio.CanListen}">
      <StackPanel Spacing="12">
        <StackPanel Spacing="2">
          <TextBlock Text="{l:T 'Nghe'}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:T 'Máy đã kết nối đang bật Phát âm thanh hiện ở đây.'}" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{l:T 'Chưa máy nào đang phát.'}" IsVisible="{Binding Audio.HasNoSources}" FontSize="12" />
        <ItemsControl ItemsSource="{Binding Audio.Sources}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:AudioSourceItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                <Panel VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="16" Height="16" />
                  <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="16" Height="16" />
                </Panel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <PathIcon Data="{StaticResource Icon.Lock}" Width="12" Height="12" IsVisible="{Binding IsLocked}" VerticalAlignment="Center"
                            ToolTip.Tip="{l:T 'Cần mật khẩu'}" />
                  <Border Classes="tag" IsVisible="{Binding IsListening}" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Đang nghe'}" FontSize="11" />
                  </Border>
                </StackPanel>
                <Panel Grid.Column="2">
                  <Button Content="{l:T 'Nghe'}" Command="{Binding ListenCommand}" IsVisible="{Binding CanListen}" Classes="accent" />
                  <Button Content="{l:T 'Dừng nghe'}" Command="{Binding StopListeningCommand}" IsVisible="{Binding IsListening}" />
                </Panel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Âm lượng: this computer's own level for what it listens to, apart from Windows' and the source's. -->
        <StackPanel Spacing="4" IsVisible="{Binding Audio.IsListening}">
          <TextBlock Text="{l:T 'Âm lượng trên máy này'}" />
          <Grid ColumnDefinitions="Auto,*,48">
            <Panel VerticalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Speaker}" IsVisible="{Binding !Audio.IsListenMuted}" Width="16" Height="16" />
              <PathIcon Data="{StaticResource Icon.SpeakerOff}" IsVisible="{Binding Audio.IsListenMuted}" Width="16" Height="16" />
            </Panel>
            <Slider Grid.Column="1" Minimum="0" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                    Value="{Binding Audio.ListenVolume}" Margin="10,0" VerticalAlignment="Center"
                    AutomationProperties.Name="{l:T 'Âm lượng trên máy này'}" />
            <TextBlock Grid.Column="2" Text="{Binding Audio.ListenVolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:T 'Chỉ đổi tiếng ở máy này, nhớ riêng cho từng máy phát; máy phát và người khác đang nghe không bị ảnh hưởng.'}" />
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- Thống kê: how listening goes, every second. -->
    <Border Classes="card" IsVisible="{Binding Audio.IsListening}">
      <StackPanel Spacing="10">
        <TextBlock Text="{l:T 'Thống kê'}" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Classes="dot" Classes.busy="{Binding Audio.IsStatusWarning}" Classes.error="{Binding Audio.IsStatusBad}" />
          <TextBlock Text="{Binding Audio.StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Audio.Stats}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:AudioStatItem">
              <Grid ColumnDefinitions="220,*" Margin="0,2">
                <TextBlock Classes="muted" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Nâng cao: what most people never change, closed until opened (docs/17-ui-cleanup.md §4). -->
    <Expander Header="{l:T 'Nâng cao'}" HorizontalAlignment="Stretch">
    <StackPanel Spacing="14">
    <Border Classes="card" IsVisible="{Binding Audio.CanListen}">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{l:T 'Thấp trễ ít nhưng đôi khi hụt tiếng lúc Wi-Fi chập chờn; Ổn định trễ hơn một chút nhưng ít hụt; Bảo toàn xin gửi lại gói bị mất và chịu trễ thêm (có khi vài giây) khi mạng kém để không hụt nhịp nào. Áp dụng từ lần nghe sau.'}">
            <TextBlock Text="{l:T 'Độ trễ khi nghe'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Ít trễ thì dễ hụt tiếng khi Wi-Fi kém. Áp dụng từ lần nghe sau.'}" />
          </StackPanel>
          <ComboBox Grid.Column="1" SelectedIndex="{Binding Audio.LatencyIndex}" MinWidth="200" VerticalAlignment="Center">
            <ComboBoxItem Content="{l:T 'Thấp: cho game'}" />
            <ComboBoxItem Content="{l:T 'Ổn định: cho nghe nhạc'}" />
            <ComboBoxItem Content="{l:T 'Bảo toàn: không hụt tiếng, trễ hơn'}" />
          </ComboBox>
        </Grid>

        <!-- Phát ra: a virtual cable's input here makes what we hear a microphone for this computer's apps. -->
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Audio.CanChooseOutput}">
          <StackPanel Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{l:T 'Dùng điện thoại làm micro: cài VB-CABLE (miễn phí, vb-audio.com), chọn CABLE Input ở đây, điện thoại chọn nguồn Micro rồi bật Phát âm thanh, máy này bấm Nghe; trong Zoom, Discord, OBS… chọn micro CABLE Output. Áp dụng từ lần nghe sau.'}">
            <TextBlock Text="{l:T 'Phát ra'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Loa hay tai nghe để nghe; CABLE Input để dùng điện thoại làm micro.'}" />
          </StackPanel>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Audio.OutputChoices}" SelectedIndex="{Binding Audio.OutputIndex}"
                    MinWidth="200" MaxWidth="320" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Nhận âm thanh qua Bluetooth: paired phones play into this computer (Windows' A2DP sink). -->
    <Border Classes="card" IsVisible="{Binding Audio.CanReceiveBluetooth}">
      <StackPanel Spacing="12">
        <StackPanel Spacing="2" Background="Transparent" ToolTip.Tip="{l:T 'Điện thoại đã ghép đôi Bluetooth với máy này phát ra loa máy tính như phát ra tai nghe, không cần chung Wi-Fi hay Shorekeeper trên điện thoại. Trễ khoảng nửa giây: hợp nghe nhạc, không hợp xem phim hay chơi game.'}">
          <TextBlock Text="{l:T 'Nhận âm thanh qua Bluetooth'}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Điện thoại ghép đôi Bluetooth phát ra loa máy này, trễ khoảng nửa giây.'}" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{l:T 'Chưa có điện thoại nào ghép đôi Bluetooth với máy này.'}" IsVisible="{Binding Audio.HasNoBluetoothSources}" FontSize="12" />
        <ItemsControl ItemsSource="{Binding Audio.BluetoothSources}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:BluetoothSourceItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                <PathIcon Data="{StaticResource Icon.Phone}" Width="16" Height="16" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Classes="tag" IsVisible="{Binding IsConnected}" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Đã kết nối'}" FontSize="11" />
                  </Border>
                  <TextBlock Classes="muted" Text="{l:T 'Đang chờ điện thoại…'}" IsVisible="{Binding IsWaiting}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Panel Grid.Column="2">
                  <Button Content="{l:T 'Kết nối'}" Command="{Binding ConnectCommand}" IsVisible="{Binding IsOff}" Classes="accent" />
                  <Button Content="{l:T 'Ngắt'}" Command="{Binding DisconnectCommand}" IsVisible="{Binding !IsOff}" />
                </Panel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{l:T 'Ghép đôi điện thoại…'}" Command="{Binding Audio.OpenBluetoothSettingsCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
               Text="{l:T 'Phát lấy tiếng từ loa mặc định của Windows; Nghe phát ra thiết bị chọn ở Phát ra. Bật nhanh Phát âm thanh từ biểu tượng khay.'}" />
    </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
