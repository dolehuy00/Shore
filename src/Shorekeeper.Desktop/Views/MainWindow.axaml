<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shorekeeper.Desktop.ViewModels"
        x:Class="Shorekeeper.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Shorekeeper"
        Icon="/Assets/shorekeeper.png"
        Width="960" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,0,16,10" />
    </Style>
    <Style Selector="SelectableTextBlock.value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Status dots: green by default, amber when busy, gray when hidden/stale, red for errors. -->
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="#22C55E" />
    </Style>
    <Style Selector="Ellipse.dot.busy">
      <Setter Property="Fill" Value="#F59E0B" />
    </Style>
    <Style Selector="Ellipse.dot.muted">
      <Setter Property="Fill" Value="#9CA3AF" />
    </Style>
    <Style Selector="Ellipse.dot.error">
      <Setter Property="Fill" Value="#EF4444" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Width" Value="230" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#33808080" />
    </Style>
    <Style Selector="Border.card.inactive">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="#3B82F6" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.card.droptarget">
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="#1A22C55E" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#33808080" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#EF4444" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#EF4444" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="#33F59E0B" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- One card for contacts and for everyone else; actions depend on IsTrusted. -->
    <DataTemplate x:Key="PeerCard" x:DataType="vm:PeerCardViewModel">
      <Border Classes="card" Classes.inactive="{Binding IsInactive}" Classes.selected="{Binding IsSelected}" Classes.droptarget="{Binding IsDropTarget}"
              Background="Transparent" DragDrop.AllowDrop="True">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Gửi file…" Command="{Binding SendFilesCommand}" IsVisible="{Binding IsTrusted}" />
            <MenuItem Header="Gửi thư mục…" Command="{Binding SendFolderCommand}" IsVisible="{Binding IsTrusted}" />
            <MenuItem Header="Tự nhận file (tối đa 2 GB)" Command="{Binding ToggleAutoAcceptCommand}" IsVisible="{Binding IsTrusted}"
                      ToggleType="CheckBox" IsChecked="{Binding IsAutoAccept, Mode=OneWay}" />
            <MenuItem Header="Kết nối" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" />
            <MenuItem Header="Đặt tên gợi nhớ…" Command="{Binding RenameCommand}" IsVisible="{Binding IsTrusted}" />
            <MenuItem Header="Ngắt kết nối" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsTrusted}" />
            <MenuItem Header="Chặn" Command="{Binding BlockCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding IsInactive}" />
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180" />
          </StackPanel>
          <TextBlock Text="{Binding Subtitle}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StatusText}" Opacity="0.8" FontSize="12" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanConnect}" Margin="0,4,0,0">
            <Border Classes="tag" VerticalAlignment="Center">
              <TextBlock Text="Chưa kết nối" FontSize="11" />
            </Border>
            <Button Grid.Column="1" Content="Kết nối" Command="{Binding ConnectCommand}" Padding="10,3" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="200,*">

    <!-- Header -->
    <Border Grid.ColumnSpan="2" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="#33808080">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Image Source="/Assets/shorekeeper.png" Width="28" Height="28" />
          <TextBlock Text="Shorekeeper" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding IsHidden}" />
          <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" MinWidth="96">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StatusOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DeviceIdShort}" Opacity="0.55" FontFamily="Consolas,monospace" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Navigation -->
    <ListBox Grid.Row="1"
             ItemsSource="{Binding NavItems}"
             SelectedItem="{Binding SelectedNavItem}"
             Background="Transparent"
             BorderThickness="0,0,1,0" BorderBrush="#33808080"
             Padding="6">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:NavItem">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Title}" Padding="6,4" />
            <Border Classes="badge" IsVisible="{Binding HasBadge}">
              <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="28,24" Spacing="18">

        <!-- Pages not built yet -->
        <Border IsVisible="{Binding IsComingSoonVisible}" Padding="14,10" CornerRadius="8" Background="#1A808080" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="{Binding ComingSoonText}" Opacity="0.8" TextWrapping="Wrap" />
        </Border>

        <!-- Xóm -->
        <StackPanel IsVisible="{Binding IsNeighborhoodVisible}" Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Xóm" />
            <Button Grid.Column="1" Content="+ Thêm máy khác" Command="{Binding Neighborhood.AddPeerCommand}" />
          </Grid>

          <TextBlock IsVisible="{Binding Neighborhood.IsEmpty}" Opacity="0.65" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                     Text="Chưa thấy ai trong mạng. Nếu máy khác đã mở Shorekeeper mà vẫn không thấy, xem Cài đặt → Mạng. Máy ở mạng khác thì dùng nút Thêm máy khác." />

          <StackPanel IsVisible="{Binding Neighborhood.HasContacts}" Spacing="8">
            <TextBlock Text="{Binding Neighborhood.ContactsHeader}" FontWeight="SemiBold" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding Neighborhood.Contacts}" ItemTemplate="{StaticResource PeerCard}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Neighborhood.OthersHeader}" FontWeight="SemiBold" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding Neighborhood.Others}" ItemTemplate="{StaticResource PeerCard}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                     Text="Kéo file hoặc thư mục vào một người đã kết nối để gửi, hoặc click chọn người rồi nhấn Ctrl+V để gửi file đã copy. Ctrl+click để chọn nhiều người. Chuột phải để gửi file, tự nhận file, đặt tên gợi nhớ, ngắt kết nối hoặc chặn." />
        </StackPanel>

        <!-- Hộp nhận -->
        <StackPanel IsVisible="{Binding IsInboxVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <TextBlock Classes="h2" Text="Hộp nhận" />
          <TextBlock IsVisible="{Binding Inbox.IsEmpty}" Opacity="0.65" Text="Chưa có ai gửi gì cho bạn." />
          <ItemsControl ItemsSource="{Binding Inbox.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InboxItemViewModel">
                <Border Classes="panel">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Text="{Binding SenderName}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="{Binding Note}" IsVisible="{Binding HasNote}" FontStyle="Italic" Opacity="0.75" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="3" Spacing="4" Margin="0,4,0,0">
                      <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsDownloading}" />
                      <TextBlock Text="{Binding StatusText}" Classes.error="{Binding IsError}" Opacity="0.85" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.RowSpan="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Button Content="{Binding DownloadText}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Classes="accent" />
                      <Button Content="Chọn file…" Command="{Binding PickFilesCommand}" IsVisible="{Binding CanPick}" />
                      <Button Content="Bỏ qua" Command="{Binding DeclineCommand}" IsVisible="{Binding IsNew}" />
                      <Button Content="Hủy" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" />
                      <Button Content="Mở" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                      <Button Content="Mở thư mục" Command="{Binding OpenFolderCommand}" IsVisible="{Binding CanOpen}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Đã gửi -->
        <StackPanel IsVisible="{Binding IsSentVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <TextBlock Classes="h2" Text="Đã gửi" />
          <TextBlock IsVisible="{Binding !Sent.Items.Count}" Opacity="0.65" Text="Bạn chưa gửi gì. Kéo file vào một người ở trang Xóm để gửi." />
          <ItemsControl ItemsSource="{Binding Sent.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SentItemViewModel">
                <Border Classes="panel">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Opacity="0.7" FontSize="12" />
                    <TextBlock Grid.Row="2" Text="{Binding RecipientsText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" IsVisible="{Binding HasChangedFiles}" Classes="error" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="File gốc đã bị sửa sau khi gửi: ai chưa tải sẽ không tải được bản cũ. Hãy gửi lại." />
                    <Button Grid.Column="1" Grid.RowSpan="4" Content="Thu hồi" Command="{Binding WithdrawCommand}" IsVisible="{Binding CanWithdraw}"
                            VerticalAlignment="Center" Margin="12,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Cài đặt -->
        <StackPanel IsVisible="{Binding IsSettingsVisible}" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Classes="h2" Text="Thiết bị này" />

          <Border Padding="18,16,18,6" CornerRadius="8" BorderThickness="1" BorderBrush="#33808080">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Classes="label" Text="Tên hiển thị" />
              <SelectableTextBlock Classes="value" Grid.Column="1" Text="{Binding DisplayName}" />

              <TextBlock Classes="label" Grid.Row="1" Text="DeviceId" />
              <SelectableTextBlock Classes="value" Grid.Row="1" Grid.Column="1" Text="{Binding DeviceId}" FontFamily="Consolas,monospace" />

              <TextBlock Classes="label" Grid.Row="2" Text="Thư mục nhận" />
              <SelectableTextBlock Classes="value" Grid.Row="2" Grid.Column="1" Text="{Binding DownloadDirectory}" />

              <TextBlock Classes="label" Grid.Row="3" Text="Dữ liệu ứng dụng" />
              <SelectableTextBlock Classes="value" Grid.Row="3" Grid.Column="1" Text="{Binding DataDirectory}" />

              <TextBlock Classes="label" Grid.Row="4" Text="Phiên bản" />
              <SelectableTextBlock Classes="value" Grid.Row="4" Grid.Column="1" Text="{Binding AppVersion}" />
            </Grid>
          </Border>

          <TextBlock Classes="h2" Text="Gửi &amp; nhận" />
          <Border Padding="18,16" CornerRadius="8" BorderThickness="1" BorderBrush="#33808080">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Tên hiển thị" Opacity="0.7" />
                <TextBox Text="{Binding Settings.DisplayName}" MaxLength="64" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Thư mục nhận" Opacity="0.7" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding Settings.DownloadDirectory}" IsReadOnly="{Binding Settings.IsDownloadDirectoryLocked}" Margin="0,0,8,0" />
                  <Button Grid.Column="1" Content="Chọn…" Command="{Binding Settings.PickDownloadDirectoryCommand}"
                          IsEnabled="{Binding !Settings.IsDownloadDirectoryLocked}" />
                </Grid>
                <TextBlock Text="Do quản trị viên đặt" IsVisible="{Binding Settings.IsDownloadDirectoryLocked}" FontSize="12" Opacity="0.6" />
              </StackPanel>

              <CheckBox IsChecked="{Binding Settings.CreateSenderSubfolders}" Content="Tạo thư mục con theo tên người gửi" />

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Text="File tôi gửi mở trong" VerticalAlignment="Center" Margin="0,0,12,8" Opacity="0.7" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Settings.OfferLifetimeChoices}" SelectedItem="{Binding Settings.OfferLifetime}" MinWidth="140" Margin="0,0,0,8">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Text="Chờ kết nối lại khi rớt mạng" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.7" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Settings.ReconnectChoices}" SelectedItem="{Binding Settings.ReconnectWindow}"
                          IsEnabled="{Binding !Settings.IsReconnectWindowLocked}" MinWidth="140">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <CheckBox IsChecked="{Binding Settings.AlwaysSnapshotBeforeSend}">
                <TextBlock TextWrapping="Wrap" Text="Luôn sao chép tạm trước khi gửi (để sửa tiếp file gốc ngay; tốn thêm dung lượng)" />
              </CheckBox>

              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Lưu" Command="{Binding Settings.SaveCommand}" Classes="accent" />
                <TextBlock Text="{Binding Settings.StatusText}" VerticalAlignment="Center" Opacity="0.8" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Mạng" />
            <Button Grid.Column="1" Content="Kiểm tra lại" Command="{Binding Diagnostics.RefreshCommand}" IsEnabled="{Binding !Diagnostics.IsRefreshing}" />
          </Grid>

          <Border Padding="18,14" CornerRadius="8" BorderThickness="1" BorderBrush="#33808080">
            <ItemsControl ItemsSource="{Binding Diagnostics.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiagnosticItem">
                  <Grid ColumnDefinitions="Auto,170,*" Margin="0,4">
                    <Ellipse Classes="dot" Classes.muted="{Binding !IsOk}" Classes.busy="{Binding IsWarning}" Classes.error="{Binding IsError}"
                             Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <TextBlock Classes="h2" Text="Đã chặn" />
          <TextBlock IsVisible="{Binding !Blocked.Items.Count}" Opacity="0.65" Text="Chưa chặn ai." />
          <ItemsControl ItemsSource="{Binding Blocked.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BlockedPeerItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Name}" FontWeight="SemiBold" />
                    <Run Text="{Binding HostName}" Foreground="Gray" />
                  </TextBlock>
                  <Button Grid.Column="1" Content="Bỏ chặn" Command="{Binding UnblockCommand}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="h2" Text="Máy đã thêm thủ công" />
          <TextBlock IsVisible="{Binding !Blocked.ManualTargets.Count}" Opacity="0.65" TextWrapping="Wrap"
                     Text="Chưa có. Dùng nút Thêm máy khác ở trang Xóm để thêm máy ở mạng khác." />
          <ItemsControl ItemsSource="{Binding Blocked.ManualTargets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ManualTargetItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock Text="{Binding Target}" VerticalAlignment="Center" FontFamily="Consolas,monospace" />
                  <Button Grid.Column="1" Content="Xóa" Command="{Binding RemoveCommand}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
