<Window xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Shorekeeper.Desktop.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shorekeeper.Desktop.ViewModels"
        xmlns:v="using:Shorekeeper.Desktop.Views"
        x:Class="Shorekeeper.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Shorekeeper"
        Icon="/Assets/shorekeeper.png"
        Width="960" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,0,16,10" />
    </Style>
    <Style Selector="SelectableTextBlock.value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Status dots: green by default, amber when busy, gray when hidden/stale, red for errors. -->
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="#22C55E" />
    </Style>
    <Style Selector="Ellipse.dot.busy">
      <Setter Property="Fill" Value="#F59E0B" />
    </Style>
    <Style Selector="Ellipse.dot.muted">
      <Setter Property="Fill" Value="#9CA3AF" />
    </Style>
    <Style Selector="Ellipse.dot.error">
      <Setter Property="Fill" Value="#EF4444" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <Style Selector="Border.card.inactive">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="#3B82F6" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.card.droptarget">
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="#1A22C55E" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.panel.droptarget">
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="#1A22C55E" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#EF4444" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#EF4444" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Navigation: icon + title, the selected page in the Windows accent color. -->
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <!-- Square behind a device or file icon. -->
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Sk.TileBackground}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A recipient of a sent offer. -->
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Sk.TileBackground}" />
    </Style>
    <Style Selector="PathIcon.done">
      <Setter Property="Foreground" Value="#22C55E" />
    </Style>
    <!-- The row a search result pointed at, for a moment. -->
    <Style Selector="Border.found">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Sk.MutedText}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="#33F59E0B" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- One card for contacts and for everyone else; actions depend on IsTrusted. -->
    <DataTemplate x:Key="PeerCard" x:DataType="vm:PeerCardViewModel">
      <Border Classes="card" Classes.inactive="{Binding IsInactive}" Classes.selected="{Binding IsSelected}" Classes.droptarget="{Binding IsDropTarget}"
              DragDrop.AllowDrop="True">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{l:T 'Gửi file…'}" Command="{Binding SendFilesCommand}" IsVisible="{Binding CanSend}" />
            <MenuItem Header="{l:T 'Gửi thư mục…'}" Command="{Binding SendFolderCommand}" IsVisible="{Binding CanSend}" />
            <MenuItem Header="{l:T 'Tự nhận file (tối đa 2 GB)'}" Command="{Binding ToggleAutoAcceptCommand}" IsVisible="{Binding IsTrusted}"
                      ToggleType="CheckBox" IsChecked="{Binding IsAutoAccept, Mode=OneWay}" />
            <MenuItem Header="{l:T 'Kết nối'}" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" />
            <MenuItem Header="{l:T 'Đặt tên gợi nhớ…'}" Command="{Binding RenameCommand}" IsVisible="{Binding IsTrusted}" />
            <MenuItem Header="{l:T 'Ngắt kết nối'}" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsTrusted}" />
            <MenuItem Header="{l:T 'Chặn'}" Command="{Binding BlockCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Panel>
            <Border Classes="tile">
              <Panel>
                <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="22" Height="22" />
                <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="22" Height="22" />
              </Panel>
            </Border>
            <Border Classes="tile" ClipToBounds="True" IsVisible="{Binding HasAvatar}">
              <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
            </Border>
          </Panel>

          <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Border Classes="tag" IsVisible="{Binding CanConnect}" VerticalAlignment="Center">
                <TextBlock Text="{l:T 'Chưa kết nối'}" FontSize="11" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding IsInactive}" Width="8" Height="8" />
              <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" />
              <TextBlock Classes="muted" Text="·" FontSize="12" />
              <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding Department}" IsVisible="{Binding HasDepartment}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding GroupText}" IsVisible="{Binding HasGroup}" FontSize="12" Foreground="{DynamicResource AccentButtonBackground}" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Command="{Binding SendFilesCommand}" IsVisible="{Binding CanSend}" AutomationProperties.Name="{l:T 'Gửi file…'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Send}" Width="16" Height="16" />
                <TextBlock Text="{l:T 'Gửi file…'}" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Content="{l:T 'Kết nối'}" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" />
            <Button Click="OnPeerMore" ToolTip.Tip="{l:T 'Thêm'}" AutomationProperties.Name="{l:T 'Thêm'}" Padding="9,7">
              <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*">

    <!-- Header -->
    <Border Grid.ColumnSpan="2" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Sk.Divider}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Image Source="/Assets/shorekeeper.png" Width="28" Height="28" />
          <TextBlock Text="Shorekeeper" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Ctrl+K: people, groups, received and sent files. -->
        <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="460" Margin="24,0" Text="{Binding Search.Query}"
                 PlaceholderText="{l:T 'Tìm người, máy, nhóm, file…'}" AutomationProperties.Name="{l:T 'Tìm kiếm'}">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource Icon.Search}" Width="16" Height="16" Margin="10,0,0,0" Opacity="0.7" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Border Classes="chip" Margin="0,0,6,0" VerticalAlignment="Center">
              <TextBlock Classes="muted" Text="Ctrl K" FontSize="11" />
            </Border>
          </TextBox.InnerRightContent>
        </TextBox>
        <Popup Grid.Column="1" PlacementTarget="{Binding #SearchBox}" Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
               IsOpen="{Binding Search.IsOpen, Mode=TwoWay}" IsLightDismissEnabled="True" Width="{Binding #SearchBox.Bounds.Width}">
          <Border Background="{DynamicResource Sk.CardBackground}" BorderBrush="{DynamicResource Sk.CardBorder}" BorderThickness="1"
                  CornerRadius="10" Padding="6" MaxHeight="440">
            <Panel>
              <TextBlock Classes="muted" Text="{l:T 'Không tìm thấy kết quả.'}" IsVisible="{Binding Search.HasNoResults}" Margin="10,8" />
              <ListBox x:Name="SearchResults" ItemsSource="{Binding Search.Results}" SelectedItem="{Binding Search.Selected}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SearchResult">
                    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" Tapped="OnSearchResultTapped">
                      <Panel Width="20" Height="20" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon.People}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SearchKind.Person}}" Width="18" Height="18" />
                        <PathIcon Data="{StaticResource Icon.Team}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SearchKind.Group}}" Width="18" Height="18" />
                        <PathIcon Data="{StaticResource Icon.Download}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SearchKind.Received}}" Width="18" Height="18" />
                        <PathIcon Data="{StaticResource Icon.Upload}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SearchKind.Sent}}" Width="18" Height="18" />
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{Binding ActionText}" IsVisible="{Binding HasAction}" VerticalAlignment="Center" Padding="10,4"
                              Command="{Binding #SearchResults.((vm:MainWindowViewModel)DataContext).Search.RunActionCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Border>
        </Popup>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding IsHidden}" />
          <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" MinWidth="96">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StatusOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="{Binding DeviceIdShort}" FontSize="12" FontFamily="Consolas,monospace" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Navigation, and this device at the bottom -->
    <Border Grid.Row="1" Background="{DynamicResource Sk.SidebarBackground}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Sk.Divider}">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Margin="10" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource Icon.Laptop}" Width="22" Height="22" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding IsHidden}" Width="8" Height="8" />
                  <TextBlock Classes="muted" Text="{Binding SelectedStatus.Label}" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <StackPanel Spacing="4" IsVisible="{Binding HasStorage}" ToolTip.Tip="{Binding DownloadDirectory}">
              <ProgressBar Value="{Binding StorageUsed}" Maximum="1" Height="4" MinHeight="4" MinWidth="0" CornerRadius="2"
                           Background="{DynamicResource Sk.Track}" />
              <TextBlock Classes="muted" Text="{Binding StorageText}" FontSize="11" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ListBox Classes="nav"
                 ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNavItem}"
                 Background="Transparent"
                 Padding="10,8">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}">
                  <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="28,24" Spacing="18">

        <!-- Pages not built yet -->
        <Border IsVisible="{Binding IsComingSoonVisible}" Padding="14,10" CornerRadius="8" Background="#1A808080" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="{Binding ComingSoonText}" Opacity="0.8" TextWrapping="Wrap" />
        </Border>

        <!-- Xóm -->
        <StackPanel IsVisible="{Binding IsNeighborhoodVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{l:T 'Xóm'}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="accent" Command="{Binding Neighborhood.AddPeerCommand}" AutomationProperties.Name="{l:T 'Thêm máy khác'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Add}" Width="16" Height="16" />
                <TextBlock Text="{l:T 'Thêm máy khác'}" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Mới nhận: the latest offers, with their main action, without leaving the page. -->
          <StackPanel IsVisible="{Binding Inbox.HasRecent}" Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Download}" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Classes="section" Text="{l:T 'Mới nhận'}" />
              <Button Grid.Column="2" Content="{l:T 'Xem tất cả'}" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:NavPage.Inbox}"
                      Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentButtonBackground}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Inbox.Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InboxItemViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Panel>
                        <Border Classes="tile" Width="36" Height="36" CornerRadius="8">
                          <Panel>
                            <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Files}}" Width="18" Height="18" />
                            <PathIcon Data="{StaticResource Icon.Image}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Images}}" Width="18" Height="18" />
                            <PathIcon Data="{StaticResource Icon.FolderOpen}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Folder}}" Width="18" Height="18" />
                          </Panel>
                        </Border>
                        <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" IsVisible="{Binding HasThumbnail}">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="muted" Text="{Binding SenderName}" FontSize="12" />
                          <TextBlock Classes="muted" Text="·" FontSize="12" />
                          <TextBlock Classes="muted" Classes.error="{Binding IsError}" Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="accent" Content="{Binding DownloadText}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" />
                        <Button Content="{l:T 'Mở'}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Nobody at all -->
          <StackPanel IsVisible="{Binding Neighborhood.IsEmpty}" Spacing="6" Margin="0,40" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.People}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Chưa thấy ai trong mạng'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                       Text="{l:T 'Nếu máy khác đã mở Shorekeeper mà vẫn không thấy, xem Cài đặt → Mạng. Máy ở mạng khác thì dùng nút Thêm máy khác.'}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding Neighborhood.HasContacts}" Spacing="8">
            <TextBlock Classes="section" Text="{Binding Neighborhood.ContactsHeader}" />
            <ItemsControl x:Name="ContactsList" ItemsSource="{Binding Neighborhood.Contacts}" ItemTemplate="{StaticResource PeerCard}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding !Neighborhood.IsEmpty}" Spacing="8">
            <TextBlock Classes="section" Text="{Binding Neighborhood.OthersHeader}" />
            <ItemsControl x:Name="OthersList" ItemsSource="{Binding Neighborhood.Others}" ItemTemplate="{StaticResource PeerCard}" />
            <TextBlock Classes="muted" IsVisible="{Binding !Neighborhood.HasOthers}" FontSize="12"
                       Text="{l:T 'Không có máy nào khác đang online.'}" />
          </StackPanel>

          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:T 'Kéo file hoặc thư mục vào một người để gửi. Click chọn người rồi nhấn Ctrl+V để gửi file đã copy; Ctrl+click để chọn nhiều người.'}" />
        </StackPanel>

        <!-- Hộp nhận -->
        <StackPanel IsVisible="{Binding IsInboxVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <TextBlock Classes="h2" Text="{l:T 'Hộp nhận'}" />
          <StackPanel IsVisible="{Binding Inbox.IsEmpty}" Spacing="6" Margin="0,40" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Download}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Chưa có ai gửi gì cho bạn.'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </StackPanel>
          <ItemsControl x:Name="InboxList" ItemsSource="{Binding Inbox.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InboxItemViewModel">
                <Border Classes="panel">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel VerticalAlignment="Top">
                      <Border Classes="tile" Width="56" Height="56" VerticalAlignment="Top">
                        <Panel>
                          <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Files}}" Width="24" Height="24" />
                          <PathIcon Data="{StaticResource Icon.Image}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Images}}" Width="24" Height="24" />
                          <PathIcon Data="{StaticResource Icon.FolderOpen}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Folder}}" Width="24" Height="24" />
                        </Panel>
                      </Border>
                      <Border Width="56" Height="56" CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasThumbnail}" VerticalAlignment="Top">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                    </Panel>

                    <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SenderName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <!-- "app.zip + 2 mục" names only the first: the button opens the whole list. -->
                      <StackPanel DataContext="{Binding Contents}" x:DataType="vm:OfferContents" IsVisible="{Binding CanExpand}" Spacing="2">
                        <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Padding="0,2" FontSize="12" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentButtonBackground}" />
                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <!-- The bullet keeps its own column, so a long name wraps under itself, not below the bullet. -->
                              <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="•" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontStyle="Italic" Opacity="0.75" TextWrapping="Wrap" />
                      <WrapPanel>
                        <TextBlock Classes="muted" Text="{Binding Details}" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <PathIcon Classes="done" Data="{StaticResource Icon.CheckCircle}" IsVisible="{Binding IsCompleted}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Classes.error="{Binding IsError}" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Text="{Binding Ago, StringFormat=' · {0}'}" FontSize="12" VerticalAlignment="Center" />
                      </WrapPanel>
                      <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsDownloading}" MinWidth="0" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="{Binding DownloadText}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Classes="accent" />
                      <Button Content="{l:T 'Chọn file…'}" Command="{Binding PickFilesCommand}" IsVisible="{Binding CanPick}" />
                      <Button Content="{l:T 'Bỏ qua'}" Command="{Binding DeclineCommand}" IsVisible="{Binding IsNew}" />
                      <Button Content="{l:T 'Hủy'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" />
                      <Button Content="{l:T 'Mở'}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                      <Button Command="{Binding OpenFolderCommand}" IsVisible="{Binding CanOpen}" AutomationProperties.Name="{l:T 'Mở thư mục'}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
                          <TextBlock Text="{l:T 'Mở thư mục'}" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Đã gửi -->
        <StackPanel IsVisible="{Binding IsSentVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <TextBlock Classes="h2" Text="{l:T 'Đã gửi'}" />
          <StackPanel IsVisible="{Binding !Sent.Items.Count}" Spacing="6" Margin="0,40" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Upload}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Bạn chưa gửi gì.'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{l:T 'Kéo file vào một người ở trang Xóm để gửi.'}" HorizontalAlignment="Center" />
          </StackPanel>
          <ItemsControl x:Name="SentList" ItemsSource="{Binding Sent.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SentItemViewModel">
                <Border Classes="panel">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="tile" Width="56" Height="56" VerticalAlignment="Top">
                        <Panel>
                          <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Files}}" Width="24" Height="24" />
                          <PathIcon Data="{StaticResource Icon.Image}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Images}}" Width="24" Height="24" />
                          <PathIcon Data="{StaticResource Icon.FolderOpen}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Folder}}" Width="24" Height="24" />
                        </Panel>
                      </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <!-- "app.zip + 2 mục" names only the first: the button opens the whole list. -->
                      <StackPanel DataContext="{Binding Contents}" x:DataType="vm:OfferContents" IsVisible="{Binding CanExpand}" Spacing="2">
                        <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Padding="0,2" FontSize="12" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentButtonBackground}" />
                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <!-- The bullet keeps its own column, so a long name wraps under itself, not below the bullet. -->
                              <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="•" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap">
                        <Run Text="{Binding Details}" />
                        <Run Text=" · " />
                        <Run Text="{Binding StatusText}" />
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding Recipients}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SentRecipientItem">
                            <Border Classes="chip">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Classes="done" Data="{StaticResource Icon.CheckCircle}" IsVisible="{Binding IsDone}" Width="13" Height="13" />
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Classes.error="{Binding IsFailed}" Text="{Binding State}" FontSize="12" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock IsVisible="{Binding HasChangedFiles}" Classes="error" FontSize="12" TextWrapping="Wrap"
                                 Text="{l:T 'File gốc đã bị sửa sau khi gửi: ai chưa tải sẽ không tải được bản cũ. Hãy gửi lại.'}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="{l:T 'Thu hồi'}" Command="{Binding WithdrawCommand}" IsVisible="{Binding CanWithdraw}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Nhóm -->
        <StackPanel IsVisible="{Binding IsGroupsVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{l:T 'Nhóm'}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="accent" Command="{Binding Groups.CreateCommand}" IsVisible="{Binding Groups.IsEnabled}"
                    AutomationProperties.Name="{l:T 'Tạo nhóm'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Add}" Width="16" Height="16" />
                <TextBlock Text="{l:T 'Tạo nhóm'}" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Classes="muted" IsVisible="{Binding !Groups.IsEnabled}" Text="{l:T 'Quản trị viên đã tắt tính năng nhóm trên máy này.'}" />

          <!-- What happened lately -->
          <ItemsControl ItemsSource="{Binding Groups.Notices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NoticeViewModel">
                <Border Classes="panel" Background="#143B82F6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissCommand}" Padding="8,2" Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="{l:T 'Đóng'}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Groups.Invitations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InvitationViewModel">
                <Border Classes="panel">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Content="{l:T 'Đồng ý'}" Command="{Binding AcceptCommand}" Classes="accent" />
                      <Button Content="{l:T 'Từ chối'}" Command="{Binding DeclineCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="section" Text="{l:T 'Nhóm của tôi'}" IsVisible="{Binding Groups.HasMyGroups}" />
          <StackPanel IsVisible="{Binding !Groups.HasMyGroups}" Spacing="6" Margin="0,24" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Team}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Bạn chưa ở trong nhóm nào.'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                       Text="{l:T 'Tạo nhóm, hoặc xin vào một nhóm trong mạng: thành viên cùng nhóm gửi file cho nhau được mà không cần Kết nối từng người.'}" />
          </StackPanel>
          <ItemsControl x:Name="MyGroupsList" ItemsSource="{Binding Groups.MyGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupCardViewModel">
                <Border Classes="panel" Classes.droptarget="{Binding IsDropTarget}" DragDrop.AllowDrop="True">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="tile">
                        <PathIcon Data="{StaticResource Icon.Team}" Width="22" Height="22" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="12" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{Binding SendFilesCommand}" Classes="accent" IsVisible="{Binding CanDrop}" AutomationProperties.Name="{l:T 'Gửi file cho nhóm'}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Send}" Width="16" Height="16" />
                            <TextBlock Text="{l:T 'Gửi file cho nhóm'}" />
                          </StackPanel>
                        </Button>
                        <Button Content="{l:T 'Mời…'}" Command="{Binding InviteCommand}" IsVisible="{Binding IsHost}" />
                        <Button Padding="9,7" ToolTip.Tip="{l:T 'Thêm'}" AutomationProperties.Name="{l:T 'Thêm'}">
                          <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16" />
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem Header="{l:T 'Gửi thư mục cho nhóm…'}" Command="{Binding SendFolderCommand}" IsVisible="{Binding CanDrop}" />
                              <MenuItem Header="{l:T 'Đổi tên nhóm…'}" Command="{Binding RenameCommand}" IsVisible="{Binding IsHost}" />
                              <MenuItem Header="{l:T 'Đóng nhóm…'}" Command="{Binding CloseCommand}" IsVisible="{Binding IsHost}" />
                              <MenuItem Header="{Binding LeaveText}" Command="{Binding LeaveCommand}" IsVisible="{Binding CanLeave}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </Grid>

                    <TextBlock Classes="muted" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" FontSize="12" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Members}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemberViewModel">
                          <Border Classes="chip">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Ellipse Classes="dot" Classes.muted="{Binding !IsOnline}" Width="8" Height="8" />
                              <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                              <Button Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" ToolTip.Tip="{l:T 'Loại khỏi nhóm'}"
                                      Padding="4,0" MinHeight="0" FontSize="10" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                      AutomationProperties.Name="{l:T 'Loại khỏi nhóm'}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Requests}" IsVisible="{Binding HasRequests}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:JoinRequestViewModel">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsInvited}">
                              <Button Content="{l:T 'Duyệt'}" Command="{Binding ApproveCommand}" Padding="10,3" />
                              <Button Content="{l:T 'Từ chối'}" Command="{Binding DeclineCommand}" Padding="10,3" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="section" Text="{l:T 'Nhóm trong mạng'}" IsVisible="{Binding Groups.HasNetworkGroups}" />
          <ItemsControl x:Name="NetworkGroupsList" ItemsSource="{Binding Groups.NetworkGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NetworkGroupViewModel">
                <Border Classes="panel">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="tile">
                      <PathIcon Data="{StaticResource Icon.Team}" Width="22" Height="22" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{l:T 'Xin vào'}" Command="{Binding JoinCommand}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:T 'Kéo file vào một nhóm để gửi cho các thành viên (chọn được từng người). Thành viên vẫn gửi file cho nhau được khi Host offline.'}" />
        </StackPanel>

        <!-- Cài đặt -->
        <StackPanel IsVisible="{Binding IsSettingsVisible}" Spacing="18" MaxWidth="860" HorizontalAlignment="Stretch">
          <TextBlock Classes="h2" Text="{l:T 'Thiết bị này'}" />

          <Border Padding="18,16,18,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Classes="label" Text="{l:T 'Tên hiển thị'}" />
              <SelectableTextBlock Classes="value" Grid.Column="1" Text="{Binding DisplayName}" />

              <TextBlock Classes="label" Grid.Row="1" Text="DeviceId" />
              <SelectableTextBlock Classes="value" Grid.Row="1" Grid.Column="1" Text="{Binding DeviceId}" FontFamily="Consolas,monospace" />

              <TextBlock Classes="label" Grid.Row="2" Text="{l:T 'Thư mục nhận'}" />
              <SelectableTextBlock Classes="value" Grid.Row="2" Grid.Column="1" Text="{Binding DownloadDirectory}" />

              <TextBlock Classes="label" Grid.Row="3" Text="{l:T 'Dữ liệu ứng dụng'}" />
              <SelectableTextBlock Classes="value" Grid.Row="3" Grid.Column="1" Text="{Binding DataDirectory}" />

              <TextBlock Classes="label" Grid.Row="4" Text="{l:T 'Phiên bản'}" />
              <SelectableTextBlock Classes="value" Grid.Row="4" Grid.Column="1" Text="{Binding AppVersion}" />
            </Grid>
          </Border>

          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{l:T 'Sao lưu danh tính…'}" Command="{Binding Settings.BackupCommand}" />
              <Button Content="{l:T 'Khôi phục…'}" Command="{Binding Settings.RestoreCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                       Text="{l:T 'Bản sao lưu (có mật khẩu) giữ DeviceId, liên hệ và nhóm: cài lại Windows hay đổi máy không phải Kết nối lại với ai.'}" />
          </StackPanel>

          <TextBlock Classes="h2" Text="{l:T 'Gửi &amp; nhận'}" />
          <Border Padding="18,16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="{l:T 'Tên hiển thị'}" />
                <TextBox Text="{Binding Settings.DisplayName}" MaxLength="64" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="{l:T 'Thư mục nhận'}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding Settings.DownloadDirectory}" IsReadOnly="{Binding Settings.IsDownloadDirectoryLocked}" Margin="0,0,8,0" />
                  <Button Grid.Column="1" Content="{l:T 'Chọn…'}" Command="{Binding Settings.PickDownloadDirectoryCommand}"
                          IsEnabled="{Binding !Settings.IsDownloadDirectoryLocked}" />
                </Grid>
                <TextBlock Classes="muted" Text="{l:T 'Do quản trị viên đặt'}" IsVisible="{Binding Settings.IsDownloadDirectoryLocked}" FontSize="12" />
              </StackPanel>

              <CheckBox IsChecked="{Binding Settings.CreateSenderSubfolders}" Content="{l:T 'Tạo thư mục con theo tên người gửi'}" />

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Classes="muted" Text="{l:T 'File tôi gửi mở trong'}" VerticalAlignment="Center" Margin="0,0,12,8" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Settings.OfferLifetimeChoices}" SelectedItem="{Binding Settings.OfferLifetime}" MinWidth="140" Margin="0,0,0,8">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Classes="muted" Grid.Row="1" Text="{l:T 'Chờ kết nối lại khi rớt mạng'}" VerticalAlignment="Center" Margin="0,0,12,8" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Settings.ReconnectChoices}" SelectedItem="{Binding Settings.ReconnectWindow}"
                          IsEnabled="{Binding !Settings.IsReconnectWindowLocked}" MinWidth="140" Margin="0,0,0,8">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Classes="muted" Grid.Row="2" Text="{l:T 'Ngôn ngữ'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static l:LanguageChoice.All}" SelectedItem="{Binding Settings.Language}" MinWidth="140">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="l:LanguageChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <CheckBox IsChecked="{Binding Settings.AlwaysSnapshotBeforeSend}">
                <TextBlock TextWrapping="Wrap" Text="{l:T 'Luôn sao chép tạm trước khi gửi (để sửa tiếp file gốc ngay; tốn thêm dung lượng)'}" />
              </CheckBox>

              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox IsChecked="{Binding Settings.QuickSendHotkey}" Content="{l:T 'Phím tắt mở cửa sổ Gửi nhanh'}" />
                  <v:ShortcutRecorder Shortcut="{Binding Settings.QuickSendShortcut}" IsRecording="{Binding Settings.IsRecordingShortcut}"
                                      IsEnabled="{Binding Settings.QuickSendHotkey}" MinWidth="120" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                      ToolTip.Tip="{l:T 'Bấm rồi nhấn tổ hợp phím mới'}" />
                </StackPanel>
                <TextBlock Classes="muted" Text="{l:T 'Nhấn Ctrl hoặc Alt (thêm Shift nếu muốn) cùng một chữ cái, số hoặc F1–F12. Esc để hủy.'}"
                           IsVisible="{Binding Settings.IsRecordingShortcut}" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Text="{Binding Settings.HotkeyWarning}" IsVisible="{Binding Settings.HotkeyWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                           TextWrapping="Wrap" FontSize="12" Foreground="#C77C00" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{l:T 'Lưu'}" Command="{Binding Settings.SaveCommand}" Classes="accent" />
                <TextBlock Text="{Binding Settings.StatusText}" VerticalAlignment="Center" Opacity="0.8" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Classes="h2" Text="{l:T 'Máy ở mạng khác'}" />
          <Border Padding="18,16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}">
            <StackPanel Spacing="12">
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{l:T 'Máy cùng mạng tự thấy nhau. Máy ở subnet/VLAN khác thấy nhau khi bạn đã kết nối với một máy bên đó, khi có máy làm cầu nối, hoặc khi dò dải IP.'}" />

              <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding Settings.EnableBridge}" IsEnabled="{Binding !Settings.IsBridgeLocked}">
                  <TextBlock TextWrapping="Wrap" Text="{l:T 'Làm cầu nối cho mạng: máy ở mọi subnet đăng ký qua máy này để thấy nhau (nên bật trên máy hay mở)'}" />
                </CheckBox>
                <TextBlock Classes="muted" Text="{l:T 'Do quản trị viên đặt'}" IsVisible="{Binding Settings.IsBridgeLocked}" FontSize="12" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="{l:T 'Cầu nối đã biết: tên máy hoặc IP, mỗi dòng một máy'}" />
                <TextBox Text="{Binding Settings.BridgeAddresses}" AcceptsReturn="True" MinHeight="56" PlaceholderText="PC-BUILD-01"
                         IsReadOnly="{Binding Settings.IsBridgeAddressesLocked}" FontFamily="Consolas,monospace" />
                <TextBlock Classes="muted" Text="{l:T 'Do quản trị viên đặt'}" IsVisible="{Binding Settings.IsBridgeAddressesLocked}" FontSize="12" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="{l:T 'Dò dải IP: mỗi dòng một dải, tối đa /22 (1.024 địa chỉ), quét 10 phút một lần'}" />
                <TextBox Text="{Binding Settings.ProbeSubnets}" AcceptsReturn="True" MinHeight="56" PlaceholderText="10.1.5.0/24"
                         IsReadOnly="{Binding Settings.IsProbeSubnetsLocked}" FontFamily="Consolas,monospace" />
                <TextBlock Classes="muted" Text="{l:T 'Do quản trị viên đặt'}" IsVisible="{Binding Settings.IsProbeSubnetsLocked}" FontSize="12" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{l:T 'Lưu'}" Command="{Binding Settings.SaveNetworkCommand}" Classes="accent" />
                <TextBlock Text="{Binding Settings.NetworkStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{l:T 'Mạng'}" />
            <Button Grid.Column="1" Content="{l:T 'Kiểm tra lại'}" Command="{Binding Diagnostics.RefreshCommand}" IsEnabled="{Binding !Diagnostics.IsRefreshing}" />
          </Grid>

          <Border Padding="18,14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}">
            <ItemsControl ItemsSource="{Binding Diagnostics.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiagnosticItem">
                  <Grid ColumnDefinitions="Auto,170,*" Margin="0,4">
                    <Ellipse Classes="dot" Classes.muted="{Binding !IsOk}" Classes.busy="{Binding IsWarning}" Classes.error="{Binding IsError}"
                             Margin="0,5,10,0" VerticalAlignment="Top" />
                    <TextBlock Classes="muted" Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <TextBlock Classes="h2" Text="{l:T 'Đã chặn'}" />
          <TextBlock Classes="muted" IsVisible="{Binding !Blocked.Items.Count}" Text="{l:T 'Chưa chặn ai.'}" />
          <ItemsControl ItemsSource="{Binding Blocked.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BlockedPeerItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Name}" FontWeight="SemiBold" />
                    <Run Text="{Binding HostName}" Foreground="Gray" />
                  </TextBlock>
                  <Button Grid.Column="1" Content="{l:T 'Bỏ chặn'}" Command="{Binding UnblockCommand}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="h2" Text="{l:T 'Máy đã thêm thủ công'}" />
          <TextBlock Classes="muted" IsVisible="{Binding !Blocked.ManualTargets.Count}" TextWrapping="Wrap"
                     Text="{l:T 'Chưa có. Dùng nút Thêm máy khác ở trang Xóm để thêm máy ở mạng khác.'}" />
          <ItemsControl ItemsSource="{Binding Blocked.ManualTargets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ManualTargetItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock Text="{Binding Target}" VerticalAlignment="Center" FontFamily="Consolas,monospace" />
                  <Button Grid.Column="1" Content="{l:T 'Xóa'}" Command="{Binding RemoveCommand}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
