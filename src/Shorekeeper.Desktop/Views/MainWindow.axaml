<Window xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Shorekeeper.Desktop.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shorekeeper.Desktop.ViewModels"
        xmlns:v="using:Shorekeeper.Desktop.Views"
        x:Class="Shorekeeper.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Shorekeeper"
        Icon="/Assets/shorekeeper.png"
        Width="960" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,0,16,10" />
    </Style>
    <Style Selector="SelectableTextBlock.value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Status dots: green by default, amber when busy, gray when hidden/stale, red for errors. -->
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="#22C55E" />
    </Style>
    <Style Selector="Ellipse.dot.busy">
      <Setter Property="Fill" Value="#F59E0B" />
    </Style>
    <Style Selector="Ellipse.dot.muted">
      <Setter Property="Fill" Value="#9CA3AF" />
    </Style>
    <Style Selector="Ellipse.dot.error">
      <Setter Property="Fill" Value="#EF4444" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <Style Selector="Border.card.inactive">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="#3B82F6" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.card.droptarget">
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="#1A22C55E" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <!-- A checked offer in "Chọn nhiều" (Hộp nhận, Đã gửi); the change is animated in Themes/Motion.axaml. -->
    <!-- File: a list, not cards (docs/17-ui-cleanup.md §4). -->
    <Style Selector="Border.panel.offer">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.dayhead">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sk.MutedText}" />
      <Setter Property="Margin" Value="2,8,0,6" />
    </Style>
    <Style Selector="Border.panel.picked">
      <!-- A light wash of the accent blue, so the icon tile still stands out in light and dark themes. -->
      <Setter Property="Background" Value="#263B82F6" />
    </Style>
    <Style Selector="Border.panel.droptarget">
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="#1A22C55E" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#EF4444" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#EF4444" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Navigation: icon + title, the selected page in the Windows accent color. -->
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <!-- Square behind a device or file icon. -->
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Sk.TileBackground}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A recipient of a sent offer. -->
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Sk.TileBackground}" />
    </Style>
    <Style Selector="PathIcon.done">
      <Setter Property="Foreground" Value="#22C55E" />
    </Style>
    <!-- The row a search result pointed at, for a moment. -->
    <Style Selector="Border.found">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- File: "Nhận | Đã gửi", a segmented switch, the chosen side raised like a card (as on the phone). -->
    <Style Selector="Border.segments">
      <Setter Property="Background" Value="{DynamicResource Sk.TileBackground}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.segment.on">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.segment.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Sk.MutedText}" />
    </Style>
    <!-- A page fades in and rises a few pixels as it appears, like a short CSS transition: only opacity and a
         translation, which the GPU composes without laying anything out again. -->
    <Style Selector="StackPanel.page">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="StackPanel.page[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="10" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Tin nhắn: a row of the list (the open one washed in the accent blue), and the bubbles, ours on the right. -->
    <Style Selector="Button.person">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.person.current /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#263B82F6" />
    </Style>
    <Style Selector="TextBlock.unread">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.bubble">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MaxWidth" Value="520" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <Style Selector="Border.bubble.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <Style Selector="Border.bubble.mine TextBlock, Border.bubble.mine SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <!-- The box at the bottom of a conversation: one rounded bar, its outline in the accent color while typing. -->
    <Style Selector="Border.composer">
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <!-- 📎 🎤 ✕ in the bar: bare round buttons, lit only under the mouse. -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The same, on and off ("Cho điều khiển"): lit with the accent while on. -->
    <Style Selector="ToggleButton.icon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- ➤: a round accent button, faded (not gray) while there is nothing to send. -->
    <Style Selector="Button.send">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="Button.send:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <!-- The text box inside the bar: no frame or fill of its own, whatever its state. -->
    <Style Selector="TextBox.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="6,7" />
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- A picture in a file card: no button chrome, only the picture. -->
    <Style Selector="Button.picture">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Files dragged over a conversation: dropped, they go to that person. -->
    <Style Selector="Border.dropzone">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.dropzone.droptarget">
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="Background" Value="#1A22C55E" />
    </Style>
    <!-- A message checked in "Chọn nhiều": its row washed in the accent blue, as the offers are. -->
    <!-- Transparent, not empty, so a tap between the bubble and the edge still reaches the row. Set here rather than on
         the row itself, where it would win over "picked". -->
    <Style Selector="Grid.chatrow">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.chatrow.picked">
      <Setter Property="Background" Value="#263B82F6" />
    </Style>
    <!-- A web address in a message: underlined, in the accent color (white on our own bubbles). -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Border.bubble.mine Button.link TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <!-- Files sent between the two: a card among the messages, on the sender's side. -->
    <Style Selector="Border.filecard">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <Style Selector="Border.filecard.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- A voice message: ▶ on a disc, the waveform (played part in full color), the length. -->
    <Style Selector="Button.play">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="Border.bubble.mine Button.play">
      <Setter Property="Background" Value="{DynamicResource AccentButtonForeground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <Style Selector="Rectangle.bar">
      <Setter Property="Width" Value="2" />
      <Setter Property="RadiusX" Value="1" />
      <Setter Property="RadiusY" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <Style Selector="Border.bubble.mine Rectangle.bar">
      <Setter Property="Fill" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="Border.bubble.unknown TextBlock.body, Border.bubble.unknown SelectableTextBlock.body">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="#33F59E0B" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- One card for contacts and for everyone else; actions depend on IsTrusted. -->
    <DataTemplate x:Key="PeerCard" x:DataType="vm:PeerCardViewModel">
      <Border Classes="card" Classes.inactive="{Binding IsInactive}" Classes.selected="{Binding IsSelected}" Classes.droptarget="{Binding IsDropTarget}"
              DragDrop.AllowDrop="True">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{l:T 'Nhắn tin'}" Command="{Binding MessageCommand}" IsVisible="{Binding IsTrusted}" />
            <MenuItem Header="{l:T 'Gửi file…'}" Command="{Binding SendFilesCommand}" IsVisible="{Binding CanSend}" />
            <MenuItem Header="{l:T 'Gửi thư mục…'}" Command="{Binding SendFolderCommand}" IsVisible="{Binding CanSend}" />
            <MenuItem Header="{l:T 'Gửi văn bản…'}" Command="{Binding SendTextCommand}" IsVisible="{Binding CanSend}" />
            <MenuItem Header="{l:T 'Tự nhận file…'}" Command="{Binding ChooseAutoAcceptCommand}" IsVisible="{Binding IsTrusted}"
                      ToggleType="CheckBox" IsChecked="{Binding IsAutoAccept, Mode=OneWay}" />
            <MenuItem Header="{l:T 'Kết nối'}" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" />
            <MenuItem Header="{l:T 'Đặt tên gợi nhớ…'}" Command="{Binding RenameCommand}" IsVisible="{Binding IsTrusted}" />
            <MenuItem Header="{l:T 'Ngắt kết nối'}" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsTrusted}" />
            <MenuItem Header="{l:T 'Chặn'}" Command="{Binding BlockCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Panel>
            <Border Classes="tile">
              <Panel>
                <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="22" Height="22" />
                <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="22" Height="22" />
              </Panel>
            </Border>
            <Border Classes="tile" ClipToBounds="True" IsVisible="{Binding HasAvatar}">
              <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
            </Border>
          </Panel>

          <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Border Classes="tag" IsVisible="{Binding CanConnect}" VerticalAlignment="Center">
                <TextBlock Text="{l:T 'Chưa kết nối'}" FontSize="11" />
              </Border>
              <Border Classes="tag" IsVisible="{Binding IsListening}" VerticalAlignment="Center">
                <TextBlock Text="{l:T 'Đang nghe'}" FontSize="11" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding IsInactive}" Width="8" Height="8" />
              <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" />
              <TextBlock Classes="muted" Text="·" FontSize="12" />
              <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding Department}" IsVisible="{Binding HasDepartment}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding GroupText}" IsVisible="{Binding HasGroup}" FontSize="12" Foreground="{DynamicResource AccentButtonBackground}" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Command="{Binding MessageCommand}" IsVisible="{Binding IsTrusted}" Padding="9,7"
                    ToolTip.Tip="{l:T 'Nhắn tin'}" AutomationProperties.Name="{l:T 'Nhắn tin'}">
              <PathIcon Data="{StaticResource Icon.Chat}" Width="16" Height="16" />
            </Button>
            <Button Command="{Binding SendFilesCommand}" IsVisible="{Binding CanSend}" AutomationProperties.Name="{l:T 'Gửi file…'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Send}" Width="16" Height="16" />
                <TextBlock Text="{l:T 'Gửi file…'}" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Content="{l:T 'Kết nối'}" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" />
            <Button Click="OnPeerMore" ToolTip.Tip="{l:T 'Thêm'}" AutomationProperties.Name="{l:T 'Thêm'}" Padding="9,7">
              <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*">

    <!-- Header -->
    <Border Grid.ColumnSpan="2" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Sk.Divider}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Image Source="/Assets/shorekeeper.png" Width="28" Height="28" />
          <TextBlock Text="Shorekeeper" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Ctrl+K: people, groups, received and sent files. -->
        <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="460" Margin="24,0" Text="{Binding Search.Query}"
                 PlaceholderText="{l:T 'Tìm người, máy, nhóm, file…'}" AutomationProperties.Name="{l:T 'Tìm kiếm'}">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource Icon.Search}" Width="16" Height="16" Margin="10,0,0,0" Opacity="0.7" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Border Classes="chip" Margin="0,0,6,0" VerticalAlignment="Center">
              <TextBlock Classes="muted" Text="Ctrl K" FontSize="11" />
            </Border>
          </TextBox.InnerRightContent>
        </TextBox>
        <Popup Grid.Column="1" PlacementTarget="{Binding #SearchBox}" Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
               IsOpen="{Binding Search.IsOpen, Mode=TwoWay}" IsLightDismissEnabled="True" Width="{Binding #SearchBox.Bounds.Width}">
          <Border Background="{DynamicResource Sk.CardBackground}" BorderBrush="{DynamicResource Sk.CardBorder}" BorderThickness="1"
                  CornerRadius="10" Padding="6" MaxHeight="440">
            <Panel>
              <TextBlock Classes="muted" Text="{l:T 'Không tìm thấy kết quả.'}" IsVisible="{Binding Search.HasNoResults}" Margin="10,8" />
              <ListBox x:Name="SearchResults" ItemsSource="{Binding Search.Results}" SelectedItem="{Binding Search.Selected}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SearchResult">
                    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" Tapped="OnSearchResultTapped">
                      <Panel Width="20" Height="20" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon.People}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SearchKind.Person}}" Width="18" Height="18" />
                        <PathIcon Data="{StaticResource Icon.Team}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SearchKind.Group}}" Width="18" Height="18" />
                        <PathIcon Data="{StaticResource Icon.Download}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SearchKind.Received}}" Width="18" Height="18" />
                        <PathIcon Data="{StaticResource Icon.Upload}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SearchKind.Sent}}" Width="18" Height="18" />
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{Binding ActionText}" IsVisible="{Binding HasAction}" VerticalAlignment="Center" Padding="10,4"
                              Command="{Binding #SearchResults.((vm:MainWindowViewModel)DataContext).Search.RunActionCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Border>
        </Popup>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding IsHidden}" />
          <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" MinWidth="96">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StatusOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="{Binding DeviceIdShort}" FontSize="12" FontFamily="Consolas,monospace" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Navigation, and the drive received files go to at the bottom (this device itself is at the top right). -->
    <Border Grid.Row="1" Background="{DynamicResource Sk.SidebarBackground}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Sk.Divider}">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Margin="10" Padding="12,10" CornerRadius="8" BorderThickness="1" IsVisible="{Binding HasStorage}"
                BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}" ToolTip.Tip="{Binding DownloadDirectory}">
          <StackPanel Spacing="6">
            <TextBlock Text="{l:T 'Ổ nhận file'}" FontSize="12" FontWeight="SemiBold" />
            <ProgressBar Value="{Binding StorageUsed}" Maximum="1" Height="4" MinHeight="4" MinWidth="0" CornerRadius="2"
                         Background="{DynamicResource Sk.Track}" />
            <TextBlock Classes="muted" Text="{Binding StorageText}" FontSize="11" />
          </StackPanel>
        </Border>

        <ListBox Classes="nav"
                 ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNavItem}"
                 Background="Transparent"
                 Padding="10,8">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}">
                  <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Tin nhắn (docs/15-chat.md §6.1): conversations on the left; the open one on the right, its box pinned at the bottom. -->
    <Panel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsMessagesVisible}">
    <Grid ColumnDefinitions="290,*" DataContext="{Binding Chat}" x:DataType="vm:ChatViewModel">
      <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Sk.Divider}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{l:T 'Tin nhắn'}" Margin="20,20,20,10" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" IsVisible="{Binding !HasConversations}" TextWrapping="Wrap" Margin="20,0"
                     Text="{l:T 'Kết nối với một máy ở Xóm để nhắn tin cho nhau.'}" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Conversations}" Margin="8,0,8,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatPersonViewModel">
                  <Button Classes="person" Classes.current="{Binding IsCurrent}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Panel>
                        <Border Classes="tile" Width="40" Height="40">
                          <Panel>
                            <PathIcon Data="{StaticResource Icon.Team}" IsVisible="{Binding IsGroup}" Width="20" Height="20" />
                            <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding IsComputer}" Width="20" Height="20" />
                            <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="20" Height="20" />
                          </Panel>
                        </Border>
                        <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" IsVisible="{Binding IsOnline}" Width="11" Height="11"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                 Stroke="{DynamicResource Sk.WindowBackground}" StrokeThickness="2" />
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes.muted="{Binding !HasUnread}" Classes.unread="{Binding HasUnread}" Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                          <PathIcon Data="{StaticResource Icon.Muted}" IsVisible="{Binding IsMuted}" Width="12" Height="12" Opacity="0.6"
                                    ToolTip.Tip="{l:T 'Đã tắt thông báo'}" />
                          <TextBlock Classes="muted" Text="{Binding TimeText}" FontSize="11" />
                        </StackPanel>
                        <Border Classes="badge" IsVisible="{Binding HasUnread}" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding Unread}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Panel Grid.Column="1">
        <StackPanel IsVisible="{Binding !IsOpen}" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource Icon.Chat}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="{l:T 'Chọn một người để nhắn tin.'}" HorizontalAlignment="Center" />
        </StackPanel>

        <DockPanel IsVisible="{Binding IsOpen}">
          <!-- Who, and whether they are there; ⋮ for the conversation. -->
          <Border DockPanel.Dock="Top" Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Sk.Divider}">
            <Grid ColumnDefinitions="*,Auto">
            <Button Grid.Column="1" Padding="9,7" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Thêm'}" AutomationProperties.Name="{l:T 'Thêm'}">
              <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="{l:T 'Thành viên'}" Command="{Binding ShowMembersCommand}" IsVisible="{Binding Current.IsGroup, FallbackValue=False}" />
                  <MenuItem Header="{Binding Current.MuteText, FallbackValue=''}" Command="{Binding ToggleMuteCommand}" IsVisible="{Binding Current.IsGroup, FallbackValue=False}" />
                  <MenuItem Header="{l:T 'Xóa hội thoại…'}" Command="{Binding DeleteConversationCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <StackPanel DataContext="{Binding Current}" x:DataType="vm:ChatPersonViewModel">
              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding !IsOnline}" IsVisible="{Binding !IsGroup}" Width="8" Height="8" />
                <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" />
              </StackPanel>
            </StackPanel>
            </Grid>
          </Border>

          <!-- "Chọn nhiều": what to do with the checked messages. -->
          <Border DockPanel.Dock="Top" Classes="selectionbar" IsVisible="{Binding IsSelecting}" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Sk.Divider}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <CheckBox IsChecked="{Binding AllSelected}" Content="{l:T 'Chọn tất cả'}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SelectedText}" FontSize="12" Margin="12,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Content="{l:T 'Xóa'}" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}" />
                <Button Content="{l:T 'Xong'}" Command="{Binding StopSelectingCommand}" Classes="accent" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- The box: Enter sends, Shift+Enter starts a new line. -->
          <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Sk.Divider}">
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" FontSize="12" TextWrapping="Wrap" />
              <!-- One rounded bar, as chat apps have. Writing: 📎 🎤 [box] ➤ (Ctrl+V of files or a picture sends them too).
                   Recording: ✕ ● 0:07 [level] ➤. -->
              <Border Classes="composer">
                <Panel>
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsComposing}">
                    <Button Classes="icon" Command="{Binding AttachCommand}" IsEnabled="{Binding CanAttach}" VerticalAlignment="Bottom"
                            ToolTip.Tip="{l:T 'Gửi file… (hoặc kéo thả, Ctrl+V)'}" AutomationProperties.Name="{l:T 'Gửi file…'}">
                      <PathIcon Data="{StaticResource Icon.Attach}" Width="18" Height="18" />
                    </Button>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding RecordCommand}" IsVisible="{Binding HasMicrophone}" IsEnabled="{Binding CanWrite}"
                            VerticalAlignment="Bottom" ToolTip.Tip="{l:T 'Ghi tin nhắn thoại'}" AutomationProperties.Name="{l:T 'Ghi tin nhắn thoại'}">
                      <PathIcon Data="{StaticResource Icon.Mic}" Width="18" Height="18" />
                    </Button>
                    <TextBox Grid.Column="2" Classes="bare" x:Name="ChatBox" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                             IsEnabled="{Binding CanWrite}" VerticalContentAlignment="Center" Margin="4,0"
                             PlaceholderText="{l:T 'Nhập tin nhắn…'}" ToolTip.Tip="{l:T 'Enter để gửi, Shift+Enter xuống dòng'}" AutomationProperties.Name="{l:T 'Tin nhắn'}" />
                    <Button Grid.Column="3" Classes="send" Command="{Binding SendCommand}" VerticalAlignment="Bottom"
                            ToolTip.Tip="{l:T 'Gửi'}" AutomationProperties.Name="{l:T 'Gửi'}">
                      <PathIcon Data="{StaticResource Icon.Send}" Width="16" Height="16" />
                    </Button>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="{Binding IsRecording}">
                    <Button Classes="icon" Command="{Binding CancelRecordingCommand}" ToolTip.Tip="{l:T 'Hủy'}" AutomationProperties.Name="{l:T 'Hủy ghi âm'}">
                      <PathIcon Data="{StaticResource Icon.Dismiss}" Width="14" Height="14" />
                    </Button>
                    <Ellipse Grid.Column="1" Classes="dot error" Classes.recording="{Binding IsRecording}" Margin="10,0,8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding RecordingText}" VerticalAlignment="Center" FontFamily="Consolas,monospace" />
                    <ProgressBar Grid.Column="3" Value="{Binding RecordingLevel}" Maximum="100" MinWidth="0" Margin="14,0" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Classes="send" Command="{Binding SendRecordingCommand}"
                            ToolTip.Tip="{l:T 'Gửi'}" AutomationProperties.Name="{l:T 'Gửi tin nhắn thoại'}">
                      <PathIcon Data="{StaticResource Icon.Send}" Width="16" Height="16" />
                    </Button>
                  </Grid>
                </Panel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="dropzone" Classes.droptarget="{Binding IsDropTarget}">
          <Panel>
            <TextBlock Classes="muted" IsVisible="{Binding HasNoMessages}" Text="{l:T 'Chưa có tin nhắn. Gửi lời chào đi!'}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Classes="panel" ZIndex="1" IsVisible="{Binding HasDetails}" Width="300" MaxHeight="420" Margin="16"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                  <TextBlock Text="{Binding DetailsTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="icon" Command="{Binding CloseDetailsCommand}" ToolTip.Tip="{l:T 'Đóng'}" AutomationProperties.Name="{l:T 'Đóng'}">
                    <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
                  </Button>
                </Grid>
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding Details}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChatMemberViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" Text="{Binding StateText}" FontSize="12" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="{l:T 'Gửi lại'}" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}"
                                  Padding="8,2" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <ScrollViewer x:Name="ChatScroller">
              <ItemsControl ItemsSource="{Binding Messages}" Margin="20,10">
                <ItemsControl.DataTemplates>
                  <DataTemplate DataType="{x:Type vm:ChatBubbleViewModel}" x:DataType="vm:ChatBubbleViewModel">
                    <StackPanel>
                      <TextBlock Classes="muted" Text="{Binding DayText}" IsVisible="{Binding HasDay}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,6" />
                      <!-- While choosing, a click anywhere on the row checks or unchecks the message. -->
                      <Grid Classes="chatrow" Classes.picked="{Binding IsSelected}" ColumnDefinitions="Auto,Auto,*" Tapped="OnChatRowTapped">
                      <CheckBox Classes="pick" IsChecked="{Binding IsSelected}" IsVisible="{Binding Owner.IsSelecting}" VerticalAlignment="Center" MinWidth="0" Width="24" Padding="0" Margin="0,0,10,0"
                                AutomationProperties.Name="{l:T 'Chọn'}" />
                      <Panel Grid.Column="1" Width="30" Margin="0,5,8,0" VerticalAlignment="Top" IsVisible="{Binding HasAvatarSpace}">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{Binding AuthorBrush}" IsVisible="{Binding ShowsAuthor}">
                          <TextBlock Text="{Binding AuthorInitial}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Panel>
                      <Border Grid.Column="2" Classes="bubble" Classes.mine="{Binding IsMine}" Classes.unknown="{Binding IsUnknown}">
                        <!-- Right click: copy the words, choose several, or take the message away here. -->
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{l:T 'Sao chép'}" Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}" />
                            <MenuItem Header="{l:T 'Thu hồi'}" Command="{Binding RecallCommand}" IsVisible="{Binding CanRecall}" />
                            <MenuItem Header="{l:T 'Chi tiết'}" Command="{Binding ShowDetailsCommand}" IsVisible="{Binding CanShowDetails}" />
                            <MenuItem Header="{l:T 'Chọn nhiều'}" Command="{Binding SelectManyCommand}" />
                            <MenuItem Header="{l:T 'Xóa tin nhắn'}" Command="{Binding DeleteCommand}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding AuthorName}" Foreground="{Binding AuthorBrush}" IsVisible="{Binding ShowsAuthor}" FontSize="12" FontWeight="SemiBold" />
                          <SelectableTextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding IsText}" ContextFlyout="{x:Null}"
                                               IsHitTestVisible="{Binding !Owner.IsSelecting}" />
                          <ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Button Classes="link" Command="{Binding $parent[ItemsControl].((vm:ChatBubbleViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}"
                                        ToolTip.Tip="{l:T 'Mở'}">
                                  <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Grid ColumnDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsVoice}" Margin="-4,2,0,0">
                            <Button Classes="play" Command="{Binding PlayCommand}" AutomationProperties.Name="{l:T 'Phát'}">
                              <Panel>
                                <PathIcon Data="{StaticResource Icon.Play}" Width="14" Height="14" IsVisible="{Binding !IsPlaying}" Margin="2,0,0,0" />
                                <PathIcon Data="{StaticResource Icon.Pause}" Width="14" Height="14" IsVisible="{Binding IsPlaying}" />
                              </Panel>
                            </Button>
                            <Panel Grid.Column="1" Margin="10,0" Height="26" VerticalAlignment="Center">
                              <ItemsControl ItemsSource="{Binding Bars}" Opacity="0.4">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="x:Double">
                                    <Rectangle Classes="bar" Height="{Binding}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Panel Width="{Binding PlayedWidth}" HorizontalAlignment="Left" ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding Bars}" Width="{x:Static vm:ChatBubbleViewModel.WaveWidth}" HorizontalAlignment="Left">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:Double">
                                      <Rectangle Classes="bar" Height="{Binding}" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Panel>
                            </Panel>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" FontSize="13" />
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                            <Button Content="{l:T 'Gửi lại'}" Command="{Binding RetryCommand}" IsVisible="{Binding IsFailed}" Padding="8,2" FontSize="11" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type vm:ChatFileViewModel}" x:DataType="vm:ChatFileViewModel">
                    <StackPanel>
                      <TextBlock Classes="muted" Text="{Binding DayText}" IsVisible="{Binding HasDay}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,6" />
                      <Border Classes="filecard" Classes.mine="{Binding IsMine}">
                        <!-- Right click: take back what we sent (five minutes), then only stop sharing it; copy text, or see files in Hộp nhận / Đã gửi. -->
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{l:T 'Thu hồi'}" Command="{Binding RecallCommand}" IsVisible="{Binding CanRecall}" />
                            <MenuItem Header="{l:T 'Ngừng chia sẻ'}" Command="{Binding WithdrawCommand}" IsVisible="{Binding CanStopSharing}" />
                            <MenuItem Header="{l:T 'Sao chép'}" Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}" />
                            <MenuItem Header="Xem" Command="{Binding ShowCommand}" IsVisible="{Binding IsFiles}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel Spacing="4">
                        <TextBlock Text="{Binding AuthorName}" Foreground="{Binding AuthorBrush}" IsVisible="{Binding ShowsAuthor}" FontSize="12" FontWeight="SemiBold" />
                        <Panel>
                        <!-- Taken back by its sender: a note, as for a message. -->
                        <StackPanel IsVisible="{Binding IsRecalled}" Spacing="2">
                          <TextBlock Text="{Binding RecalledText}" FontStyle="Italic" TextWrapping="Wrap" />
                          <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="11" HorizontalAlignment="Right" />
                        </StackPanel>
                        <!-- An offer of pictures shows the first few, or all of them small after "+N ảnh"; click one to open it. -->
                        <StackPanel IsVisible="{Binding HasPictures}" Spacing="4">
                          <ItemsControl ItemsSource="{Binding Pictures}" IsVisible="{Binding !IsExpanded}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ChatPicture">
                                <Button Classes="picture" Command="{Binding $parent[ItemsControl].((vm:ChatFileViewModel)DataContext).OpenPictureCommand}" CommandParameter="{Binding}">
                                  <Border CornerRadius="10" ClipToBounds="True">
                                    <Image Source="{Binding Image}" MaxWidth="300" MaxHeight="340" Stretch="Uniform" />
                                  </Border>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding AllPictures}" IsVisible="{Binding IsExpanded}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Columns="3" ColumnSpacing="4" RowSpacing="4" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ChatPicture">
                                <Button Classes="picture" Command="{Binding $parent[ItemsControl].((vm:ChatFileViewModel)DataContext).OpenPictureCommand}" CommandParameter="{Binding}">
                                  <Border CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding Image}" Width="96" Height="96" Stretch="UniformToFill" />
                                  </Border>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="link" Command="{Binding ToggleMoreCommand}" Click="OnMorePictures" IsVisible="{Binding HasMore}" VerticalAlignment="Center">
                              <TextBlock Text="{Binding MoreText}" FontSize="12" />
                            </Button>
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusText}" FontSize="11" />
                          </Grid>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsPlain}">
                          <Border Classes="tile" Width="36" Height="36" CornerRadius="8" VerticalAlignment="Top">
                            <Panel>
                              <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding !IsText}" Width="18" Height="18" />
                              <PathIcon Data="{StaticResource Icon.Text}" IsVisible="{Binding IsText}" Width="18" Height="18" />
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" IsVisible="{Binding IsFiles}" />
                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding CanCopy}" />
                            <TextBlock Classes="muted" Text="{Binding Text}" FontStyle="Italic" IsVisible="{Binding IsEmptyText}" />
                            <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" />
                            <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsDownloading}" MinWidth="0" Margin="0,4" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                              <Button Classes="accent" Content="{l:T 'Tải'}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Padding="12,4" />
                              <Button Content="Xem" Command="{Binding ShowCommand}" Padding="12,4" IsVisible="{Binding IsFiles}" />
                              <Button Content="{l:T 'Sao chép'}" Command="{Binding CopyCommand}" Padding="12,4" IsVisible="{Binding CanCopy}" />
                              <Button Content="{l:T 'Mở'}" Command="{Binding OpenLinkCommand}" Padding="12,4" IsVisible="{Binding IsLink}" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                        </Panel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
          </Border>
        </DockPanel>
      </Panel>
    </Grid>
    </Panel>

    <!-- Content: one scroller for every page, back at the top whenever the page changes. -->
    <ScrollViewer x:Name="PageScroller" Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsPageScrollerVisible}">
      <StackPanel Margin="28,24" Spacing="18">

        <!-- Pages not built yet -->
        <Border IsVisible="{Binding IsComingSoonVisible}" Padding="14,10" CornerRadius="8" Background="#1A808080" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="{Binding ComingSoonText}" Opacity="0.8" TextWrapping="Wrap" />
        </Border>

        <!-- Xóm -->
        <StackPanel Classes="page" IsVisible="{Binding IsNeighborhoodVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="h2" Text="{l:T 'Xóm'}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding Neighborhood.ShowPairingQrCommand}" Margin="0,0,8,0"
                    ToolTip.Tip="{l:T 'Hiện mã QR để điện thoại quét và kết nối ngay'}" AutomationProperties.Name="{l:T 'Mã QR'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.QrCode}" Width="16" Height="16" />
                <TextBlock Text="{l:T 'Mã QR'}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="accent" Command="{Binding Neighborhood.AddPeerCommand}" AutomationProperties.Name="{l:T 'Thêm máy khác'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Add}" Width="16" Height="16" />
                <TextBlock Text="{l:T 'Thêm máy khác'}" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Mới nhận: the latest offers, with their main action, without leaving the page. -->
          <StackPanel IsVisible="{Binding Inbox.HasRecent}" Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Download}" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Classes="section" Text="{l:T 'Mới nhận'}" />
              <Button Grid.Column="2" Content="{l:T 'Xem tất cả'}" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:NavPage.Inbox}"
                      Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentButtonBackground}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Inbox.Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InboxItemViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Panel>
                        <Border Classes="tile" Width="36" Height="36" CornerRadius="8">
                          <Panel>
                            <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Files}}" Width="18" Height="18" />
                            <PathIcon Data="{StaticResource Icon.Image}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Images}}" Width="18" Height="18" />
                            <PathIcon Data="{StaticResource Icon.FolderOpen}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Folder}}" Width="18" Height="18" />
                          </Panel>
                        </Border>
                        <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" IsVisible="{Binding HasThumbnail}">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="muted" Text="{Binding SenderName}" FontSize="12" />
                          <TextBlock Classes="muted" Text="·" FontSize="12" />
                          <TextBlock Classes="muted" Classes.error="{Binding IsError}" Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="accent" Content="{Binding DownloadText}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" />
                        <Button Content="{l:T 'Mở'}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Nobody at all -->
          <StackPanel IsVisible="{Binding Neighborhood.IsEmpty}" Spacing="6" Margin="0,40" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.People}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Chưa thấy ai trong mạng'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                       Text="{l:T 'Nếu máy khác đã mở Shorekeeper mà vẫn không thấy, xem Cài đặt → Mạng. Máy ở mạng khác thì dùng nút Thêm máy khác.'}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding Neighborhood.HasContacts}" Spacing="8">
            <TextBlock Classes="section" Text="{Binding Neighborhood.ContactsHeader}" />
            <ItemsControl x:Name="ContactsList" ItemsSource="{Binding Neighborhood.Contacts}" ItemTemplate="{StaticResource PeerCard}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding !Neighborhood.IsEmpty}" Spacing="8">
            <TextBlock Classes="section" Text="{Binding Neighborhood.OthersHeader}" />
            <ItemsControl x:Name="OthersList" ItemsSource="{Binding Neighborhood.Others}" ItemTemplate="{StaticResource PeerCard}" />
            <TextBlock Classes="muted" IsVisible="{Binding !Neighborhood.HasOthers}" FontSize="12"
                       Text="{l:T 'Không có máy nào khác đang online.'}" />
          </StackPanel>

          <!-- One line; the rest on hover (docs/17-ui-cleanup.md §4). -->
          <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" ToolTip.Tip="{l:T 'Kéo file hoặc thư mục vào một người để gửi. Click chọn người rồi nhấn Ctrl+V để gửi file hoặc đoạn chữ đã copy; Ctrl+click để chọn nhiều người.'}">
            <PathIcon Data="{StaticResource Icon.Info}" Width="14" Height="14" Opacity="0.7" VerticalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Kéo file vào một người để gửi.'}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- File: "Nhận | Đã gửi", as on the phone (docs/17-ui-cleanup.md §2). -->
        <Grid IsVisible="{Binding IsFilesVisible}" ColumnDefinitions="*,Auto" MaxWidth="860" HorizontalAlignment="Stretch">
          <TextBlock Classes="h2" Text="{l:T 'File'}" VerticalAlignment="Center" />
          <Border Grid.Column="1" Classes="segments" Width="240">
            <Grid ColumnDefinitions="*,*">
              <Button Classes="segment" Classes.on="{Binding !IsSentTab}" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:NavPage.Inbox}"
                      Content="{l:T 'Nhận'}" />
              <Button Grid.Column="1" Classes="segment" Classes.on="{Binding IsSentTab}" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:NavPage.Sent}"
                      Content="{l:T 'Đã gửi'}" />
            </Grid>
          </Border>
        </Grid>
        <!-- What the tab shows: a kind, and who or which files (docs/17-ui-cleanup.md §4). -->
        <Grid IsVisible="{Binding IsFilesVisible}" ColumnDefinitions="Auto,*" MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,-6,0,0">
          <Border Classes="segments" Width="340">
            <Grid ColumnDefinitions="*,*,*,*">
              <Button Classes="segment" Classes.on="{Binding FilesFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileFilter.All}}"
                      Command="{Binding SetFilesFilterCommand}" CommandParameter="{x:Static vm:FileFilter.All}" Content="{l:T 'Tất cả'}" />
              <Button Grid.Column="1" Classes="segment" Classes.on="{Binding FilesFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileFilter.Images}}"
                      Command="{Binding SetFilesFilterCommand}" CommandParameter="{x:Static vm:FileFilter.Images}" Content="{l:T 'Ảnh'}" />
              <Button Grid.Column="2" Classes="segment" Classes.on="{Binding FilesFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileFilter.Files}}"
                      Command="{Binding SetFilesFilterCommand}" CommandParameter="{x:Static vm:FileFilter.Files}" Content="{l:T 'File'}" />
              <Button Grid.Column="3" Classes="segment" Classes.on="{Binding FilesFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FileFilter.Folders}}"
                      Command="{Binding SetFilesFilterCommand}" CommandParameter="{x:Static vm:FileFilter.Folders}" Content="{l:T 'Thư mục'}" />
            </Grid>
          </Border>
          <TextBox Grid.Column="1" Text="{Binding FilesQuery}" PlaceholderText="{l:T 'Tìm theo người hoặc tên file'}" Width="260" HorizontalAlignment="Right" Margin="12,0,0,0"
                   VerticalContentAlignment="Center" />
        </Grid>

        <!-- Hộp nhận -->
        <StackPanel Classes="page" IsVisible="{Binding IsInboxVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <!-- "Chọn nhiều" (⋮ on an offer): check boxes on the offers, and what to do with the checked ones. -->
          <Border Classes="panel selectionbar" IsVisible="{Binding Inbox.IsSelecting}" Padding="14,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <CheckBox IsChecked="{Binding Inbox.AllSelected}" Content="{l:T 'Chọn tất cả'}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Inbox.SelectedText}" FontSize="12" Margin="12,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Content="{l:T 'Xóa khỏi lịch sử'}" Command="{Binding Inbox.RemoveSelectedCommand}" IsEnabled="{Binding Inbox.HasSelection}" />
                <Button Content="{l:T 'Xóa kèm file đã nhận…'}" Command="{Binding Inbox.RemoveSelectedWithFilesCommand}" IsEnabled="{Binding Inbox.HasSelection}" />
                <Button Content="{l:T 'Xong'}" Command="{Binding Inbox.StopSelectingCommand}" Classes="accent" />
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel IsVisible="{Binding Inbox.IsEmpty}" Spacing="6" Margin="0,40" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Download}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Chưa có ai gửi gì cho bạn.'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="muted" IsVisible="{Binding Inbox.HasNoMatch}" Text="{l:T 'Không có mục nào khớp.'}" HorizontalAlignment="Center" Margin="0,30" />
          <ItemsControl x:Name="InboxList" ItemsSource="{Binding Inbox.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InboxItemViewModel">
                <StackPanel IsVisible="{Binding IsShown}">
                <TextBlock Classes="dayhead" Text="{Binding DayText}" IsVisible="{Binding HasDay}" />
                <Border Classes="panel offer" Classes.picked="{Binding IsSelected}" Classes.leaving="{Binding IsLeaving}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <CheckBox Classes="pick" IsChecked="{Binding IsSelected}" IsVisible="{Binding Owner.IsSelecting}" VerticalAlignment="Center" MinWidth="0" Width="24" Padding="0" Margin="0,0,10,0"
                              AutomationProperties.Name="{l:T 'Chọn'}" />
                    <Panel Grid.Column="1" VerticalAlignment="Center">
                      <Border Classes="tile" Width="40" Height="40" CornerRadius="8">
                        <Panel>
                          <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Files}}" Width="20" Height="20" />
                          <PathIcon Data="{StaticResource Icon.Image}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Images}}" Width="20" Height="20" />
                          <PathIcon Data="{StaticResource Icon.FolderOpen}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Folder}}" Width="20" Height="20" />
                        </Panel>
                      </Border>
                      <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True" IsVisible="{Binding HasThumbnail}">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                    </Panel>

                    <!-- Two lines: the files, then who · size · state · when. -->
                    <StackPanel Grid.Column="2" Margin="12,0,12,0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <!-- "app.zip + 2 mục" names only the first: the button opens the whole list. -->
                      <StackPanel DataContext="{Binding Contents}" x:DataType="vm:OfferContents" IsVisible="{Binding CanExpand}" Spacing="2">
                        <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Padding="0,2" FontSize="12" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentButtonBackground}" />
                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <!-- The bullet keeps its own column, so a long name wraps under itself, not below the bullet. -->
                              <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="•" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontStyle="Italic" Opacity="0.75" TextWrapping="Wrap" />
                      <WrapPanel>
                        <TextBlock Classes="muted" Text="{Binding SenderName, StringFormat='{}{0} · '}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Text="{Binding Details}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <PathIcon Classes="done" Data="{StaticResource Icon.CheckCircle}" IsVisible="{Binding IsCompleted}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Classes.error="{Binding IsError}" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Text="{Binding Ago, StringFormat=' · {0}'}" FontSize="12" VerticalAlignment="Center" />
                      </WrapPanel>
                      <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsDownloading}" MinWidth="0" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="{Binding DownloadText}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Classes="accent" />
                      <Button Content="{Binding CopyText}" Command="{Binding CopyImageCommand}" IsVisible="{Binding CanCopyImage}"
                              ToolTip.Tip="{l:T 'Chép ảnh để dán vào Zalo, Word…'}" />
                      <Button Content="{l:T 'Chọn file…'}" Command="{Binding PickFilesCommand}" IsVisible="{Binding CanPick}" />
                      <Button Content="{l:T 'Bỏ qua'}" Command="{Binding DeclineCommand}" IsVisible="{Binding IsNew}" />
                      <Button Content="{l:T 'Hủy'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" />
                      <Button Content="{l:T 'Mở'}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                      <Button Command="{Binding OpenFolderCommand}" IsVisible="{Binding CanOpen}" Padding="9,7"
                              ToolTip.Tip="{l:T 'Mở thư mục'}" AutomationProperties.Name="{l:T 'Mở thư mục'}">
                        <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
                      </Button>
                      <Button Padding="9,7" ToolTip.Tip="{l:T 'Thêm'}" AutomationProperties.Name="{l:T 'Thêm'}">
                        <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16" />
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="{l:T 'Chọn nhiều'}" Command="{Binding SelectManyCommand}" />
                            <MenuItem Header="{l:T 'Xóa khỏi lịch sử (giữ file)'}" Command="{Binding RemoveCommand}" IsEnabled="{Binding !IsDownloading}" />
                            <MenuItem Header="{l:T 'Xóa kèm file đã nhận…'}" Command="{Binding RemoveWithFilesCommand}" IsVisible="{Binding HasFiles}" IsEnabled="{Binding !IsDownloading}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Đã gửi -->
        <StackPanel Classes="page" IsVisible="{Binding IsSentVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <!-- "Chọn nhiều" (⋮ on an offer): check boxes on the offers, and what to do with the checked ones. -->
          <Border Classes="panel selectionbar" IsVisible="{Binding Sent.IsSelecting}" Padding="14,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <CheckBox IsChecked="{Binding Sent.AllSelected}" Content="{l:T 'Chọn tất cả'}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Sent.SelectedText}" FontSize="12" Margin="12,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Content="{l:T 'Xóa khỏi lịch sử'}" Command="{Binding Sent.RemoveSelectedCommand}" IsEnabled="{Binding Sent.HasSelection}" />
                <Button Content="{l:T 'Xong'}" Command="{Binding Sent.StopSelectingCommand}" Classes="accent" />
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel IsVisible="{Binding !Sent.Items.Count}" Spacing="6" Margin="0,40" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Upload}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Bạn chưa gửi gì.'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{l:T 'Kéo file vào một người ở trang Xóm để gửi.'}" HorizontalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="muted" IsVisible="{Binding Sent.HasNoMatch}" Text="{l:T 'Không có mục nào khớp.'}" HorizontalAlignment="Center" Margin="0,30" />
          <ItemsControl x:Name="SentList" ItemsSource="{Binding Sent.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SentItemViewModel">
                <StackPanel IsVisible="{Binding IsShown}">
                <TextBlock Classes="dayhead" Text="{Binding DayText}" IsVisible="{Binding HasDay}" />
                <Border Classes="panel offer" Classes.picked="{Binding IsSelected}" Classes.leaving="{Binding IsLeaving}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <CheckBox Classes="pick" IsChecked="{Binding IsSelected}" IsVisible="{Binding Owner.IsSelecting}" VerticalAlignment="Center" MinWidth="0" Width="24" Padding="0" Margin="0,0,10,0"
                              AutomationProperties.Name="{l:T 'Chọn'}" />
                    <Border Grid.Column="1" Classes="tile" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center">
                        <Panel>
                          <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Files}}" Width="20" Height="20" />
                          <PathIcon Data="{StaticResource Icon.Image}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Images}}" Width="20" Height="20" />
                          <PathIcon Data="{StaticResource Icon.FolderOpen}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:TransferKind.Folder}}" Width="20" Height="20" />
                        </Panel>
                      </Border>

                    <StackPanel Grid.Column="2" Margin="12,0,12,0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <!-- "app.zip + 2 mục" names only the first: the button opens the whole list. -->
                      <StackPanel DataContext="{Binding Contents}" x:DataType="vm:OfferContents" IsVisible="{Binding CanExpand}" Spacing="2">
                        <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Padding="0,2" FontSize="12" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentButtonBackground}" />
                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <!-- The bullet keeps its own column, so a long name wraps under itself, not below the bullet. -->
                              <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="•" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap">
                        <Run Text="{Binding Details}" />
                        <Run Text=" · " />
                        <Run Text="{Binding StatusText}" />
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding Recipients}" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SentRecipientItem">
                            <Border Classes="chip">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Classes="done" Data="{StaticResource Icon.CheckCircle}" IsVisible="{Binding IsDone}" Width="13" Height="13" />
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Classes.error="{Binding IsFailed}" Text="{Binding State}" FontSize="12" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock IsVisible="{Binding HasChangedFiles}" Classes="error" FontSize="12" TextWrapping="Wrap"
                                 Text="{l:T 'File gốc đã bị sửa sau khi gửi: ai chưa tải sẽ không tải được bản cũ. Hãy gửi lại.'}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="{l:T 'Thu hồi'}" Command="{Binding WithdrawCommand}" IsVisible="{Binding CanWithdraw}" />
                      <Button Padding="9,7" ToolTip.Tip="{l:T 'Thêm'}" AutomationProperties.Name="{l:T 'Thêm'}">
                        <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16" />
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="{l:T 'Chọn nhiều'}" Command="{Binding SelectManyCommand}" />
                            <MenuItem Header="{l:T 'Xóa khỏi lịch sử'}" Command="{Binding RemoveCommand}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Nhóm -->
        <StackPanel Classes="page" IsVisible="{Binding IsGroupsVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{l:T 'Nhóm'}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="accent" Command="{Binding Groups.CreateCommand}" IsVisible="{Binding Groups.IsEnabled}"
                    AutomationProperties.Name="{l:T 'Tạo nhóm'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Add}" Width="16" Height="16" />
                <TextBlock Text="{l:T 'Tạo nhóm'}" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Classes="muted" IsVisible="{Binding !Groups.IsEnabled}" Text="{l:T 'Quản trị viên đã tắt tính năng nhóm trên máy này.'}" />

          <!-- What happened lately -->
          <ItemsControl ItemsSource="{Binding Groups.Notices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NoticeViewModel">
                <Border Classes="panel" Background="#143B82F6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissCommand}" Padding="8,2" Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="{l:T 'Đóng'}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Groups.Invitations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InvitationViewModel">
                <Border Classes="panel">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Content="{l:T 'Đồng ý'}" Command="{Binding AcceptCommand}" Classes="accent" />
                      <Button Content="{l:T 'Từ chối'}" Command="{Binding DeclineCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="section" Text="{l:T 'Nhóm của tôi'}" IsVisible="{Binding Groups.HasMyGroups}" />
          <StackPanel IsVisible="{Binding !Groups.HasMyGroups}" Spacing="6" Margin="0,24" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Team}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Bạn chưa ở trong nhóm nào.'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                       Text="{l:T 'Tạo nhóm, hoặc xin vào một nhóm trong mạng: thành viên cùng nhóm gửi file cho nhau được mà không cần Kết nối từng người.'}" />
          </StackPanel>
          <ItemsControl x:Name="MyGroupsList" ItemsSource="{Binding Groups.MyGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupCardViewModel">
                <Border Classes="panel" Classes.droptarget="{Binding IsDropTarget}" DragDrop.AllowDrop="True">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="tile">
                        <PathIcon Data="{StaticResource Icon.Team}" Width="22" Height="22" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="12" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{Binding ChatCommand}" IsVisible="{Binding CanDrop}" Padding="9,7" ToolTip.Tip="{l:T 'Nhắn tin'}" AutomationProperties.Name="{l:T 'Nhắn tin'}">
                          <PathIcon Data="{StaticResource Icon.Chat}" Width="16" Height="16" />
                        </Button>
                        <Button Command="{Binding SendFilesCommand}" Classes="accent" IsVisible="{Binding CanDrop}" AutomationProperties.Name="{l:T 'Gửi file cho nhóm'}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Send}" Width="16" Height="16" />
                            <TextBlock Text="{l:T 'Gửi file cho nhóm'}" />
                          </StackPanel>
                        </Button>
                        <Button Content="{l:T 'Mời…'}" Command="{Binding InviteCommand}" IsVisible="{Binding IsHost}" />
                        <Button Padding="9,7" ToolTip.Tip="{l:T 'Thêm'}" AutomationProperties.Name="{l:T 'Thêm'}">
                          <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16" />
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem Header="{l:T 'Gửi thư mục cho nhóm…'}" Command="{Binding SendFolderCommand}" IsVisible="{Binding CanDrop}" />
                              <MenuItem Header="{l:T 'Gửi văn bản cho nhóm…'}" Command="{Binding SendTextCommand}" IsVisible="{Binding CanDrop}" />
                              <MenuItem Header="{l:T 'Sửa nhóm…'}" Command="{Binding EditCommand}" IsVisible="{Binding IsHost}" />
                              <MenuItem Header="{l:T 'Đóng nhóm…'}" Command="{Binding CloseCommand}" IsVisible="{Binding IsHost}" />
                              <MenuItem Header="{Binding LeaveText}" Command="{Binding LeaveCommand}" IsVisible="{Binding CanLeave}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </Grid>

                    <TextBlock Classes="muted" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" FontSize="12" TextWrapping="Wrap" />

                    <!-- One row per member: device, name, Host/Bạn, status and where they are on the network. -->
                    <ItemsControl ItemsSource="{Binding Members}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemberViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                            <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource Sk.TileBackground}" VerticalAlignment="Center">
                              <Panel>
                                <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="16" Height="16" />
                                <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="16" Height="16" />
                              </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Classes="tag" IsVisible="{Binding IsHost}" VerticalAlignment="Center">
                                  <TextBlock Text="Host" FontSize="11" />
                                </Border>
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding !IsOnline}" Width="8" Height="8" />
                                <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" />
                                <TextBlock Classes="muted" Text="·" FontSize="12" IsVisible="{Binding HasDetail}" />
                                <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDetail}" />
                              </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" ToolTip.Tip="{l:T 'Loại khỏi nhóm'}"
                                    Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:T 'Loại khỏi nhóm'}">
                              <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Requests}" IsVisible="{Binding HasRequests}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:JoinRequestViewModel">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsInvited}">
                              <Button Content="{l:T 'Duyệt'}" Command="{Binding ApproveCommand}" Padding="10,3" />
                              <Button Content="{l:T 'Từ chối'}" Command="{Binding DeclineCommand}" Padding="10,3" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="section" Text="{l:T 'Nhóm trong mạng'}" IsVisible="{Binding Groups.HasNetworkGroups}" />
          <ItemsControl x:Name="NetworkGroupsList" ItemsSource="{Binding Groups.NetworkGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NetworkGroupViewModel">
                <Border Classes="panel">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="tile">
                      <PathIcon Data="{StaticResource Icon.Team}" Width="22" Height="22" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{l:T 'Xin vào'}" Command="{Binding JoinCommand}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- One line; the rest on hover (docs/17-ui-cleanup.md §4). -->
          <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" ToolTip.Tip="{l:T 'Kéo file vào một nhóm để gửi cho các thành viên (chọn được từng người). Thành viên vẫn gửi file cho nhau được khi Host offline.'}">
            <PathIcon Data="{StaticResource Icon.Info}" Width="14" Height="14" Opacity="0.7" VerticalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Kéo file vào một nhóm để gửi cho các thành viên.'}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- Âm thanh: this computer's sound for contacts, and the contacts' sound here. -->
        <StackPanel Classes="page" IsVisible="{Binding IsAudioVisible}" Spacing="14" MaxWidth="860" HorizontalAlignment="Stretch">
          <TextBlock Classes="h2" Text="{l:T 'Âm thanh'}" />

          <Border Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="tile">
                  <PathIcon Data="{StaticResource Icon.Speaker}" Width="22" Height="22" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{l:T 'Phát âm thanh'}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="{l:T 'Máy đã kết nối thấy máy này đang phát và tự bấm Nghe khi muốn. Tắt là mọi máy đang nghe đều dừng.'}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding Audio.IsPlaying}" IsEnabled="{Binding Audio.CanPlay}" OnContent="" OffContent=""
                              MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Phát âm thanh'}" />
              </Grid>

              <!-- Optional password: a listener types it once, then its device remembers it. -->
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{StaticResource Icon.Lock}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="8,0,12,0" VerticalAlignment="Center"
                           Text="{l:T 'Không có mật khẩu: máy đã kết nối nào cũng nghe được.'}" IsVisible="{Binding !Audio.HasPassword}" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="8,0,12,0" VerticalAlignment="Center"
                           Text="{l:T 'Có mật khẩu: máy muốn nghe nhập một lần, sau đó tự nhớ.'}" IsVisible="{Binding Audio.HasPassword}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Button Content="{l:T 'Đặt mật khẩu…'}" Command="{Binding Audio.SetPasswordCommand}" IsVisible="{Binding !Audio.HasPassword}" />
                  <Button Content="{l:T 'Đổi mật khẩu…'}" Command="{Binding Audio.SetPasswordCommand}" IsVisible="{Binding Audio.HasPassword}" />
                  <Button Content="{l:T 'Bỏ mật khẩu'}" Command="{Binding Audio.RemovePasswordCommand}" IsVisible="{Binding Audio.HasPassword}" />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="6" IsVisible="{Binding Audio.IsPlaying}">
                <TextBlock Classes="h3" Text="{l:T 'Đang nghe'}" />
                <TextBlock Classes="muted" Text="{l:T 'Chưa ai nghe'}" IsVisible="{Binding !Audio.HasListeners}" FontSize="12" />
                <ItemsControl ItemsSource="{Binding Audio.Listeners}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AudioListenerItem">
                      <!-- What the host may do, for this listener alone. -->
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                        <Panel VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="16" Height="16" />
                          <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="16" Height="16" />
                        </Panel>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                          <ToggleButton Classes="icon" IsChecked="{Binding AllowsControl}" IsVisible="{Binding CanOfferControl}"
                                        ToolTip.Tip="{l:T 'Cho điều khiển'}" AutomationProperties.Name="{l:T 'Cho điều khiển'}">
                            <PathIcon Data="{StaticResource Icon.PlayPause}" Width="16" Height="16" />
                          </ToggleButton>
                          <Button Classes="icon" Command="{Binding StopCommand}" ToolTip.Tip="{l:T 'Ngừng phát'}" AutomationProperties.Name="{l:T 'Ngừng phát'}">
                            <PathIcon Data="{StaticResource Icon.SpeakerOff}" Width="16" Height="16" />
                          </Button>
                          <Button Classes="icon" Command="{Binding KeepOutCommand}" ToolTip.Tip="{l:T 'Không cho nghe'}" AutomationProperties.Name="{l:T 'Không cho nghe'}">
                            <PathIcon Data="{StaticResource Icon.Block}" Width="16" Height="16" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- What the icons of each listener do. -->
                <StackPanel Spacing="3" IsVisible="{Binding Audio.HasListeners}">
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Audio.CanOfferControl}">
                    <PathIcon Data="{StaticResource Icon.PlayPause}" Width="12" Height="12" Opacity="0.7" VerticalAlignment="Top" Margin="0,2,6,0" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Cho điều khiển: máy đó bấm được Phát/Dừng, chuyển bài và âm lượng ở máy này.'}" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Data="{StaticResource Icon.SpeakerOff}" Width="12" Height="12" Opacity="0.7" VerticalAlignment="Top" Margin="0,2,6,0" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Ngừng phát: ngắt máy đó, máy đó bấm Nghe lại được.'}" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Data="{StaticResource Icon.Block}" Width="12" Height="12" Opacity="0.7" VerticalAlignment="Top" Margin="0,2,6,0" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Không cho nghe: máy đó không vào lại được cho tới khi bạn tắt rồi bật lại Phát âm thanh.'}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Nghe: contacts with "Phát âm thanh" on. -->
          <Border Classes="card" IsVisible="{Binding Audio.CanListen}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="{l:T 'Nghe'}" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="{l:T 'Máy đã kết nối đang bật Phát âm thanh hiện ở đây.'}" />
              </StackPanel>
              <TextBlock Classes="muted" Text="{l:T 'Chưa máy nào đang phát.'}" IsVisible="{Binding Audio.HasNoSources}" FontSize="12" />
              <ItemsControl ItemsSource="{Binding Audio.Sources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AudioSourceItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                      <Panel VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="16" Height="16" />
                        <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="16" Height="16" />
                      </Panel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <PathIcon Data="{StaticResource Icon.Lock}" Width="12" Height="12" IsVisible="{Binding IsLocked}" VerticalAlignment="Center"
                                  ToolTip.Tip="{l:T 'Cần mật khẩu'}" />
                        <Border Classes="tag" IsVisible="{Binding IsListening}" VerticalAlignment="Center">
                          <TextBlock Text="{l:T 'Đang nghe'}" FontSize="11" />
                        </Border>
                      </StackPanel>
                      <Panel Grid.Column="2">
                        <Button Content="{l:T 'Nghe'}" Command="{Binding ListenCommand}" IsVisible="{Binding CanListen}" Classes="accent" />
                        <Button Content="{l:T 'Dừng nghe'}" Command="{Binding StopListeningCommand}" IsVisible="{Binding IsListening}" />
                      </Panel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Âm lượng: this computer's own level for what it listens to, apart from Windows' and the source's. -->
              <StackPanel Spacing="4" IsVisible="{Binding Audio.IsListening}">
                <TextBlock Text="{l:T 'Âm lượng trên máy này'}" />
                <Grid ColumnDefinitions="Auto,*,48">
                  <Panel VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Speaker}" IsVisible="{Binding !Audio.IsListenMuted}" Width="16" Height="16" />
                    <PathIcon Data="{StaticResource Icon.SpeakerOff}" IsVisible="{Binding Audio.IsListenMuted}" Width="16" Height="16" />
                  </Panel>
                  <Slider Grid.Column="1" Minimum="0" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                          Value="{Binding Audio.ListenVolume}" Margin="10,0" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T 'Âm lượng trên máy này'}" />
                  <TextBlock Grid.Column="2" Text="{Binding Audio.ListenVolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="{l:T 'Chỉ đổi tiếng ở máy này, nhớ riêng cho từng máy phát; máy phát và người khác đang nghe không bị ảnh hưởng.'}" />
              </StackPanel>

            </StackPanel>
          </Border>

          <!-- Thống kê: how listening goes, every second. -->
          <Border Classes="card" IsVisible="{Binding Audio.IsListening}">
            <StackPanel Spacing="10">
              <TextBlock Text="{l:T 'Thống kê'}" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Classes="dot" Classes.busy="{Binding Audio.IsStatusWarning}" Classes.error="{Binding Audio.IsStatusBad}" />
                <TextBlock Text="{Binding Audio.StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Audio.Stats}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AudioStatItem">
                    <Grid ColumnDefinitions="220,*" Margin="0,2">
                      <TextBlock Classes="muted" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Nâng cao: what most people never change, closed until opened (docs/17-ui-cleanup.md §4). -->
          <Expander Header="{l:T 'Nâng cao'}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="14">
          <Border Classes="card" IsVisible="{Binding Audio.CanListen}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{l:T 'Thấp trễ ít nhưng đôi khi hụt tiếng lúc Wi-Fi chập chờn; Ổn định trễ hơn một chút nhưng ít hụt; Bảo toàn xin gửi lại gói bị mất và chịu trễ thêm (có khi vài giây) khi mạng kém để không hụt nhịp nào. Áp dụng từ lần nghe sau.'}">
                  <TextBlock Text="{l:T 'Độ trễ khi nghe'}" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Ít trễ thì dễ hụt tiếng khi Wi-Fi kém. Áp dụng từ lần nghe sau.'}" />
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedIndex="{Binding Audio.LatencyIndex}" MinWidth="200" VerticalAlignment="Center">
                  <ComboBoxItem Content="{l:T 'Thấp: cho game'}" />
                  <ComboBoxItem Content="{l:T 'Ổn định: cho nghe nhạc'}" />
                  <ComboBoxItem Content="{l:T 'Bảo toàn: không hụt tiếng, trễ hơn'}" />
                </ComboBox>
              </Grid>

              <!-- Phát ra: a virtual cable's input here makes what we hear a microphone for this computer's apps. -->
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Audio.CanChooseOutput}">
                <StackPanel Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{l:T 'Dùng điện thoại làm micro: cài VB-CABLE (miễn phí, vb-audio.com), chọn CABLE Input ở đây, điện thoại chọn nguồn Micro rồi bật Phát âm thanh, máy này bấm Nghe; trong Zoom, Discord, OBS… chọn micro CABLE Output. Áp dụng từ lần nghe sau.'}">
                  <TextBlock Text="{l:T 'Phát ra'}" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Loa hay tai nghe để nghe; CABLE Input để dùng điện thoại làm micro.'}" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Audio.OutputChoices}" SelectedIndex="{Binding Audio.OutputIndex}"
                          MinWidth="200" MaxWidth="320" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Nhận âm thanh qua Bluetooth: paired phones play into this computer (Windows' A2DP sink). -->
          <Border Classes="card" IsVisible="{Binding Audio.CanReceiveBluetooth}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2" Background="Transparent" ToolTip.Tip="{l:T 'Điện thoại đã ghép đôi Bluetooth với máy này phát ra loa máy tính như phát ra tai nghe, không cần chung Wi-Fi hay Shorekeeper trên điện thoại. Trễ khoảng nửa giây: hợp nghe nhạc, không hợp xem phim hay chơi game.'}">
                <TextBlock Text="{l:T 'Nhận âm thanh qua Bluetooth'}" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Điện thoại ghép đôi Bluetooth phát ra loa máy này, trễ khoảng nửa giây.'}" />
              </StackPanel>
              <TextBlock Classes="muted" Text="{l:T 'Chưa có điện thoại nào ghép đôi Bluetooth với máy này.'}" IsVisible="{Binding Audio.HasNoBluetoothSources}" FontSize="12" />
              <ItemsControl ItemsSource="{Binding Audio.BluetoothSources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BluetoothSourceItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                      <PathIcon Data="{StaticResource Icon.Phone}" Width="16" Height="16" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Classes="tag" IsVisible="{Binding IsConnected}" VerticalAlignment="Center">
                          <TextBlock Text="{l:T 'Đã kết nối'}" FontSize="11" />
                        </Border>
                        <TextBlock Classes="muted" Text="{l:T 'Đang chờ điện thoại…'}" IsVisible="{Binding IsWaiting}" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                      <Panel Grid.Column="2">
                        <Button Content="{l:T 'Kết nối'}" Command="{Binding ConnectCommand}" IsVisible="{Binding IsOff}" Classes="accent" />
                        <Button Content="{l:T 'Ngắt'}" Command="{Binding DisconnectCommand}" IsVisible="{Binding !IsOff}" />
                      </Panel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="{l:T 'Ghép đôi điện thoại…'}" Command="{Binding Audio.OpenBluetoothSettingsCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{l:T 'Phát lấy tiếng từ loa mặc định của Windows; Nghe phát ra thiết bị chọn ở Phát ra. Bật nhanh Phát âm thanh từ biểu tượng khay.'}" />
          </StackPanel>
          </Expander>
        </StackPanel>

        <!-- Cài đặt -->
        <StackPanel Classes="page" IsVisible="{Binding IsSettingsVisible}" Spacing="18" MaxWidth="860" HorizontalAlignment="Stretch">
          <!-- One section at a time (docs/17-ui-cleanup.md §4). -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{l:T 'Cài đặt'}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="segments" Width="560">
            <Grid ColumnDefinitions="*,*,*,*,*">
              <Button Classes="segment" Classes.on="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.General}}"
                      Command="{Binding SetSettingsSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.General}" Content="{l:T 'Chung'}" />
              <Button Grid.Column="1" Classes="segment" Classes.on="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.Network}}"
                      Command="{Binding SetSettingsSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Network}" Content="{l:T 'Mạng'}" />
              <Button Grid.Column="2" Classes="segment" Classes.on="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.Security}}"
                      Command="{Binding SetSettingsSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Security}" Content="{l:T 'Bảo mật'}" />
              <Button Grid.Column="3" Classes="segment" Classes.on="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.Stats}}"
                      Command="{Binding SetSettingsSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Stats}" Content="{l:T 'Thống kê'}" />
              <Button Grid.Column="4" Classes="segment" Classes.on="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.About}}"
                      Command="{Binding SetSettingsSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.About}" Content="{l:T 'Giới thiệu'}" />
            </Grid>
            </Border>
          </Grid>

          <StackPanel Spacing="18" IsVisible="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.General}}">
            <TextBlock Classes="h2" Text="{l:T 'Gửi &amp; nhận'}" />
            <Border Padding="18,16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Classes="muted" Text="{l:T 'Tên hiển thị'}" />
                  <TextBox Text="{Binding Settings.DisplayName}" MaxLength="64" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Classes="muted" Text="{l:T 'Thư mục nhận'}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding Settings.DownloadDirectory}" IsReadOnly="{Binding Settings.IsDownloadDirectoryLocked}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="{l:T 'Chọn…'}" Command="{Binding Settings.PickDownloadDirectoryCommand}"
                            IsEnabled="{Binding !Settings.IsDownloadDirectoryLocked}" />
                  </Grid>
                  <TextBlock Classes="muted" Text="{l:T 'Do quản trị viên đặt'}" IsVisible="{Binding Settings.IsDownloadDirectoryLocked}" FontSize="12" />
                </StackPanel>

                <CheckBox IsChecked="{Binding Settings.CreateSenderSubfolders}" Content="{l:T 'Tạo thư mục con theo tên người gửi'}" />
                <!-- Applies at once, unlike the fields above. -->
                <CheckBox IsChecked="{Binding Chat.AutoDownloadPictures}" Content="{l:T 'Tự tải ảnh máy đã kết nối gửi (đến 20 MB) để hiện ngay trong Tin nhắn'}" />

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                  <TextBlock Classes="muted" Text="{l:T 'File tôi gửi mở trong'}" VerticalAlignment="Center" Margin="0,0,12,8" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Settings.OfferLifetimeChoices}" SelectedItem="{Binding Settings.OfferLifetime}" MinWidth="140" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Classes="muted" Grid.Row="1" Text="{l:T 'Chờ kết nối lại khi rớt mạng'}" VerticalAlignment="Center" Margin="0,0,12,8" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Settings.ReconnectChoices}" SelectedItem="{Binding Settings.ReconnectWindow}"
                            IsEnabled="{Binding !Settings.IsReconnectWindowLocked}" MinWidth="140" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <!-- For connected devices whose "Tự nhận file…" follows Settings. -->
                  <TextBlock Classes="muted" Grid.Row="2" Text="{l:T 'Tự nhận file tối đa'}" VerticalAlignment="Center" Margin="0,0,12,8" />
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <NumericUpDown Value="{Binding Settings.AutoAcceptLimitGb}" Minimum="0.1" Maximum="10000" Increment="1" FormatString="0.##" Width="140" />
                    <TextBlock Text="GB" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" Text="{l:T 'cho máy đã kết nối có Tự nhận file theo cài đặt chung'}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>

                  <TextBlock Classes="muted" Grid.Row="3" Text="{l:T 'Ngôn ngữ'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static l:LanguageChoice.All}" SelectedItem="{Binding Settings.Language}" MinWidth="140">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="l:LanguageChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <CheckBox IsChecked="{Binding Settings.AlwaysSnapshotBeforeSend}">
                  <TextBlock TextWrapping="Wrap" Text="{l:T 'Luôn sao chép tạm trước khi gửi (để sửa tiếp file gốc ngay; tốn thêm dung lượng)'}" />
                </CheckBox>

                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox IsChecked="{Binding Settings.QuickSendHotkey}" Content="{l:T 'Phím tắt mở cửa sổ Gửi nhanh'}" />
                    <v:ShortcutRecorder Shortcut="{Binding Settings.QuickSendShortcut}" IsRecording="{Binding Settings.IsRecordingShortcut}"
                                        IsEnabled="{Binding Settings.QuickSendHotkey}" MinWidth="120" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                        ToolTip.Tip="{l:T 'Bấm rồi nhấn tổ hợp phím mới'}" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{l:T 'Nhấn Ctrl hoặc Alt (thêm Shift nếu muốn) cùng một chữ cái, số hoặc F1–F12. Esc để hủy.'}"
                             IsVisible="{Binding Settings.IsRecordingShortcut}" TextWrapping="Wrap" FontSize="12" />
                  <TextBlock Text="{Binding Settings.HotkeyWarning}" IsVisible="{Binding Settings.HotkeyWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                             TextWrapping="Wrap" FontSize="12" Foreground="#C77C00" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Content="{l:T 'Lưu'}" Command="{Binding Settings.SaveCommand}" Classes="accent" />
                  <TextBlock Text="{Binding Settings.StatusText}" VerticalAlignment="Center" Opacity="0.8" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="18" IsVisible="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.Network}}">
            <TextBlock Classes="h2" Text="{l:T 'Máy ở mạng khác'}" />
            <Border Padding="18,16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}">
              <StackPanel Spacing="12">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{l:T 'Máy cùng mạng tự thấy nhau. Máy ở subnet/VLAN khác thấy nhau khi bạn đã kết nối với một máy bên đó, khi có máy làm cầu nối, hoặc khi dò dải IP.'}" />

                <StackPanel Spacing="4">
                  <CheckBox IsChecked="{Binding Settings.EnableBridge}" IsEnabled="{Binding !Settings.IsBridgeLocked}">
                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Làm cầu nối cho mạng: máy ở mọi subnet đăng ký qua máy này để thấy nhau (nên bật trên máy hay mở)'}" />
                  </CheckBox>
                  <TextBlock Classes="muted" Text="{l:T 'Do quản trị viên đặt'}" IsVisible="{Binding Settings.IsBridgeLocked}" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Classes="muted" Text="{l:T 'Cầu nối đã biết: tên máy hoặc IP, mỗi dòng một máy'}" />
                  <TextBox Text="{Binding Settings.BridgeAddresses}" AcceptsReturn="True" MinHeight="56" PlaceholderText="PC-BUILD-01"
                           IsReadOnly="{Binding Settings.IsBridgeAddressesLocked}" FontFamily="Consolas,monospace" />
                  <TextBlock Classes="muted" Text="{l:T 'Do quản trị viên đặt'}" IsVisible="{Binding Settings.IsBridgeAddressesLocked}" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Classes="muted" Text="{l:T 'Dò dải IP: mỗi dòng một dải, tối đa /22 (1.024 địa chỉ), quét 10 phút một lần'}" />
                  <TextBox Text="{Binding Settings.ProbeSubnets}" AcceptsReturn="True" MinHeight="56" PlaceholderText="10.1.5.0/24"
                           IsReadOnly="{Binding Settings.IsProbeSubnetsLocked}" FontFamily="Consolas,monospace" />
                  <TextBlock Classes="muted" Text="{l:T 'Do quản trị viên đặt'}" IsVisible="{Binding Settings.IsProbeSubnetsLocked}" FontSize="12" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Content="{l:T 'Lưu'}" Command="{Binding Settings.SaveNetworkCommand}" Classes="accent" />
                  <TextBlock Text="{Binding Settings.NetworkStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="{l:T 'Mạng'}" />
              <Button Grid.Column="1" Content="{l:T 'Kiểm tra lại'}" Command="{Binding Diagnostics.RefreshCommand}" IsEnabled="{Binding !Diagnostics.IsRefreshing}" />
            </Grid>

            <Border Padding="18,14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}">
              <ItemsControl ItemsSource="{Binding Diagnostics.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DiagnosticItem">
                    <Grid ColumnDefinitions="Auto,170,*" Margin="0,4">
                      <Ellipse Classes="dot" Classes.muted="{Binding !IsOk}" Classes.busy="{Binding IsWarning}" Classes.error="{Binding IsError}"
                               Margin="0,5,10,0" VerticalAlignment="Top" />
                      <TextBlock Classes="muted" Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                      <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <TextBlock Classes="h2" Text="{l:T 'Máy đã thêm thủ công'}" />
            <TextBlock Classes="muted" IsVisible="{Binding !Blocked.ManualTargets.Count}" TextWrapping="Wrap"
                       Text="{l:T 'Chưa có. Dùng nút Thêm máy khác ở trang Xóm để thêm máy ở mạng khác.'}" />
            <ItemsControl ItemsSource="{Binding Blocked.ManualTargets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ManualTargetItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <TextBlock Text="{Binding Target}" VerticalAlignment="Center" FontFamily="Consolas,monospace" />
                    <Button Grid.Column="1" Content="{l:T 'Xóa'}" Command="{Binding RemoveCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="18" IsVisible="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.Security}}">
            <TextBlock Classes="h2" Text="{l:T 'Sao lưu danh tính'}" />
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{l:T 'Sao lưu danh tính…'}" Command="{Binding Settings.BackupCommand}" />
                <Button Content="{l:T 'Khôi phục…'}" Command="{Binding Settings.RestoreCommand}" />
              </StackPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                         Text="{l:T 'Bản sao lưu (có mật khẩu) giữ DeviceId, liên hệ và nhóm: cài lại Windows hay đổi máy không phải Kết nối lại với ai.'}" />
            </StackPanel>

            <TextBlock Classes="h2" Text="{l:T 'Đã chặn'}" />
            <TextBlock Classes="muted" IsVisible="{Binding !Blocked.Items.Count}" Text="{l:T 'Chưa chặn ai.'}" />
            <ItemsControl ItemsSource="{Binding Blocked.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BlockedPeerItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <TextBlock VerticalAlignment="Center">
                      <Run Text="{Binding Name}" FontWeight="SemiBold" />
                      <Run Text="{Binding HostName}" Foreground="Gray" />
                    </TextBlock>
                    <Button Grid.Column="1" Content="{l:T 'Bỏ chặn'}" Command="{Binding UnblockCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="18" IsVisible="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.Stats}}">
            <!-- Thống kê (docs/10-ux.md §15): counts kept on this device, and the drive the received files go to. -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="{l:T 'Thống kê'}" />
              <Button Grid.Column="1" Content="{l:T 'Làm mới'}" Command="{Binding Stats.RefreshCommand}" />
            </Grid>
            <Border Padding="18,14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}"
                    DataContext="{Binding Stats}" x:DataType="vm:StatsViewModel">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="110,*,*">
                  <TextBlock Grid.Column="1" Classes="muted" Text="{l:T 'Đã gửi'}" FontSize="12" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="{l:T 'Đã nhận'}" FontSize="12" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Periods}" Margin="0,-8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatsPeriod">
                      <Grid ColumnDefinitions="110,*,*" Margin="0,3">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Sent}" />
                        <TextBlock Grid.Column="2" Text="{Binding Received}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="3">
                  <TextBlock Text="{l:T 'Âm thanh'}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SoundWeek}" />
                  <TextBlock Classes="muted" Text="{Binding SoundTotal}" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="3">
                  <TextBlock Text="{l:T 'Tin nhắn'}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding MessagesWeek}" />
                  <TextBlock Classes="muted" Text="{Binding MessagesTotal}" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="3" IsVisible="{Binding HasPeers}">
                  <TextBlock Text="{l:T 'Theo máy'}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding Peers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StatsPeer">
                        <Grid ColumnDefinitions="170,*" Margin="0,2">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                          <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Text}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{l:T 'Ổ chứa file nhận'}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="{l:T 'Đang đọc ổ đĩa…'}" IsVisible="{Binding IsMeasuring}" FontSize="12" />
                  <StackPanel Spacing="4" IsVisible="{Binding HasDrive}">
                    <ProgressBar Value="{Binding DriveUsed}" Maximum="100" MinWidth="0" />
                    <TextBlock Text="{Binding DriveText}" />
                  </StackPanel>
                  <TextBlock Text="{Binding FolderText}" />
                  <ItemsControl ItemsSource="{Binding Kinds}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StatsKind">
                        <Grid ColumnDefinitions="140,120,*" Margin="0,3">
                          <TextBlock Text="{Binding Name}" />
                          <ProgressBar Grid.Column="1" Value="{Binding Share}" Maximum="100" MinWidth="0" VerticalAlignment="Center" Margin="0,0,12,0" />
                          <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Text}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Classes="muted" Text="{Binding Since}" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="18" IsVisible="{Binding SettingsSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:SettingsSection.About}}">
            <TextBlock Classes="h2" Text="{l:T 'Thiết bị này'}" />

            <Border Padding="18,16,18,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sk.CardBorder}" Background="{DynamicResource Sk.CardBackground}">
              <!-- The name and the download folder are set under "Gửi & nhận", not repeated here (docs/17-ui-cleanup.md §2). -->
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Classes="label" Text="DeviceId" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                  <SelectableTextBlock Text="{Binding DeviceId}" FontFamily="Consolas,monospace" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Content="{l:T 'Sao chép'}" Command="{Binding CopyDeviceIdCommand}" Padding="10,3" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Classes="label" Grid.Row="1" Text="{l:T 'Dữ liệu ứng dụng'}" />
                <SelectableTextBlock Classes="value" Grid.Row="1" Grid.Column="1" Text="{Binding DataDirectory}" />

                <TextBlock Classes="label" Grid.Row="2" Text="{l:T 'Phiên bản'}" />
                <SelectableTextBlock Classes="value" Grid.Row="2" Grid.Column="1" Text="{Binding AppVersion}" />
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
