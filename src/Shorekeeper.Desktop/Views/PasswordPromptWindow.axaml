<Window xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Shorekeeper.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shorekeeper.Desktop.ViewModels"
        x:Class="Shorekeeper.Desktop.Views.PasswordPromptWindow"
        x:DataType="vm:PasswordPromptViewModel"
        Title="{Binding Title}"
        Icon="/Assets/shorekeeper.png"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
    <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="{l:T 'Mật khẩu'}" />
    <TextBox Text="{Binding PasswordAgain}" PasswordChar="•" PlaceholderText="{l:T 'Nhập lại mật khẩu'}" IsVisible="{Binding IsConfirm}" />
    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#EF4444" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{l:T 'Hủy'}" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Content="{Binding OkText}" Command="{Binding OkCommand}" IsDefault="True" Classes="accent" IsEnabled="{Binding !IsBusy}" />
    </StackPanel>
  </StackPanel>
</Window>
