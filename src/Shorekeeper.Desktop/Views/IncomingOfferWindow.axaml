<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shorekeeper.Desktop.ViewModels"
        x:Class="Shorekeeper.Desktop.Views.IncomingOfferWindow"
        x:DataType="vm:IncomingOfferViewModel"
        Title="Có file gửi đến"
        Icon="/Assets/shorekeeper.png"
        Width="380" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False">
  <StackPanel Margin="18" Spacing="8">
    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Xem" Command="{Binding ShowCommand}" />
      <Button Content="Bỏ qua" Command="{Binding DeclineCommand}" />
      <Button Content="Tải" Command="{Binding DownloadCommand}" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
