<Window xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Shorekeeper.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shorekeeper.Desktop.ViewModels"
        x:Class="Shorekeeper.Desktop.Views.IncomingOfferWindow"
        x:DataType="vm:IncomingOfferViewModel"
        Title="{l:T 'Có gửi đến'}"
        Icon="/Assets/shorekeeper.png"
        Width="380" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False">
  <StackPanel Margin="18" Spacing="8">
    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Summary}" IsVisible="{Binding IsFiles}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap" />
    <SelectableTextBlock Text="{Binding Text}" IsVisible="{Binding IsText}" TextWrapping="Wrap" MaxLines="6" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Xem" Command="{Binding ShowCommand}" />
      <Button Content="{l:T 'Bỏ qua'}" Command="{Binding DeclineCommand}" IsVisible="{Binding IsFiles}" />
      <Button Content="{l:T 'Tải'}" Command="{Binding DownloadCommand}" IsVisible="{Binding IsFiles}" Classes="accent" />
      <Button Content="{l:T 'Mở'}" Command="{Binding OpenLinkCommand}" IsVisible="{Binding IsLink}" />
      <Button Content="{l:T 'Sao chép'}" Command="{Binding CopyCommand}" IsVisible="{Binding IsText}" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
