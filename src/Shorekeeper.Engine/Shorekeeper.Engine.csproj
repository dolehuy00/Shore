<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shorekeeper.Engine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shorekeeper.Core\Shorekeeper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- No ASP.NET Core: the engine also runs where it is not available (Android). Kestrel lives in Shorekeeper.Engine.Kestrel. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Storage\Migrations\*.sql" LogicalName="Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shorekeeper.Engine.Tests" />
  </ItemGroup>

</Project>
