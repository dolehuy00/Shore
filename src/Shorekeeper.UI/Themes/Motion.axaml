<!--
  Shared motion of the desktop and Android apps, applied to every control of its kind, so new popups, menus and
  drop-downs get it without anything to add. Like short CSS transitions: only opacity and a transform, which the GPU
  composes without laying anything out again.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- In-page popups (Android): the dimmed backdrop fades in, the dialog fades in and rises. -->
  <Style Selector="Border.overlay[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- The moving parts carry a translation for the animations below to change (RenderTransform itself cannot be animated). -->
  <Style Selector="Border.overlay > Border.dialog, ComboBox /template/ Border#PopupBorder, MenuFlyoutPresenter, FlyoutPresenter, ContextMenu">
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>
  <Style Selector="Border.overlay[IsVisible=True] > Border.dialog">
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="16" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Drop-down lists (ComboBox) and menus (⋮, right-click, flyouts): fade in and slide down a few pixels. -->
  <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder, Popup[IsOpen=True] > MenuFlyoutPresenter, Popup[IsOpen=True] > FlyoutPresenter, ContextMenu:open">
    <Style.Animations>
      <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-6" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Hộp nhận and Đã gửi (docs/10-ux.md §4). The moving parts carry a translation, as above. -->
  <Style Selector="Border.offer, CheckBox.pick, :is(Control).selectionbar">
    <Setter Property="RenderTransform" Value="translateX(0px)" />
  </Style>
  <!-- Offers fade in when they arrive; a checked one changes shade softly (the shade is set next to each card style). -->
  <Style Selector="Border.offer">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Removed offers fade and slide away before they leave the list. -->
  <Style Selector="Border.offer.leaving">
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="CubicEaseIn" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.X" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.X" Value="-40" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!--
    Long press on a card (Android): it sinks a little while held, springs back when choosing starts, and eases back when
    let go early. The classes are set by the view (MainView.axaml.cs).
  -->
  <Style Selector="Border.offer.pressing">
    <Style.Animations>
      <Animation Duration="0:0:0.45" Easing="QuadraticEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.offer.held">
    <Style.Animations>
      <Animation Duration="0:0:0.28" Easing="BackEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.offer.released">
    <Style.Animations>
      <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="0.98" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.98" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Choosing several: the check boxes slide in, the bar of actions drops in. -->
  <Style Selector="CheckBox.pick[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.X" Value="-12" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.X" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).selectionbar[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Recording a voice message: the red dot breathes. The class is set only while recording: an endless animation
       keeps the window drawing every frame, which starved background work on the phone. -->
  <Style Selector="Ellipse.recording">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
