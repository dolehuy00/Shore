<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Shorekeeper.Android.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The desktop's look (linked from Shorekeeper.Desktop/Themes). -->
        <ResourceInclude Source="/Themes/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Touch: taller controls than on the desktop. -->
      <Thickness x:Key="ButtonPadding">16,10,16,10</Thickness>
      <x:Double x:Key="TextControlThemeMinHeight">44</x:Double>
      <Thickness x:Key="TextControlThemePadding">12,11,8,10</Thickness>
      <x:Double x:Key="ComboBoxMinHeight">44</x:Double>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- Popups, menus and drop-downs open with a short animation (linked from Shorekeeper.Desktop/Themes). -->
    <StyleInclude Source="/Themes/Motion.axaml" />
    <StyleInclude Source="/Themes/Menus.axaml" />
    <!--
      Touch: menus and drop-down lists float over the page with a shadow, their items as tall as other controls. The
      popup is as big as what it holds, so the margins leave the shadow room (and keep a menu off the screen's edge).
    -->
    <Style Selector="MenuFlyoutPresenter /template/ Border#LayoutRoot">
      <Setter Property="Margin" Value="8,0,8,12" />
      <Setter Property="BoxShadow" Value="0 4 12 0 #26000000" />
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="BoxShadow" Value="0 6 10 -6 #33000000" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem, ComboBoxItem">
      <Setter Property="Padding" Value="14,12" />
    </Style>
  </Application.Styles>
</Application>
