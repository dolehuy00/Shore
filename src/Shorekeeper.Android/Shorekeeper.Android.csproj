<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Android app (docs/14-android.md). Not in Shorekeeper.sln: it needs the .NET "android" workload.
      dotnet build src/Shorekeeper.Android -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Shorekeeper.Android</RootNamespace>
    <ApplicationId>dev.shorekeeper.app</ApplicationId>
    <ApplicationTitle>Shorekeeper</ApplicationTitle>
    <!-- Version from Directory.Build.props; versionCode must grow with each release: 0.1.0 -> 100, 1.2.3 -> 10203. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <_VersionMajor>$([System.Version]::Parse($(Version)).Major)</_VersionMajor>
    <_VersionMinor>$([System.Version]::Parse($(Version)).Minor)</_VersionMinor>
    <_VersionPatch>$([System.Version]::Parse($(Version)).Build)</_VersionPatch>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Multiply($(_VersionMajor), 10000)), $([MSBuild]::Add($([MSBuild]::Multiply($(_VersionMinor), 100)), $(_VersionPatch)))))</ApplicationVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Release APKs are for phones only (arm64): the emulator's x86_64 libraries were almost half the APK. Debug keeps both.
    All code is compiled ahead of time rather than only the parts in .NET's start-up profile: on an OPPO Reno10 the app
    opens in about 1.9 s instead of 2.9 s, for 9 MB more APK.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shorekeeper.Engine\Shorekeeper.Engine.csproj" />
    <!-- The look, the shared view models and the AXAML translation, as on the desktop. -->
    <ProjectReference Include="..\Shorekeeper.UI\Shorekeeper.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" />
  </ItemGroup>

</Project>
