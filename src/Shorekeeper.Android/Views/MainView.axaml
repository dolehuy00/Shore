<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Shorekeeper.Desktop.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shorekeeper.Android.ViewModels"
             xmlns:dvm="using:Shorekeeper.Desktop.ViewModels"
             x:Class="Shorekeeper.Android.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource Sk.WindowBackground}">
  <UserControl.Styles>
    <!-- Touch scrolling needs no bar, and on a phone the bar sits on top of the content. -->
    <Style Selector="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <!-- Square behind a device, file or group icon. -->
    <!-- "Gửi cho…": a card per person to pick. -->
    <Style Selector="Border.card.pick">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.card.pick.picked">
      <Setter Property="Background" Value="{DynamicResource Sk.TileBackground}" />
    </Style>
    <!-- The round buttons of the choosing bar (Hộp nhận, Đã gửi): ✕ on a light disc, ⋮ bare; off, they only fade. -->
    <Style Selector="Button.round">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.round.close">
      <Setter Property="Background" Value="{DynamicResource Sk.TileBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource Sk.MutedText}" />
    </Style>
    <Style Selector="Button.round:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.round:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- A checked card in "Chọn" (Hộp nhận, Đã gửi); the change is animated in Themes/Motion.axaml. -->
    <Style Selector="Border.card.picked">
      <!-- A light wash of the accent blue, so the icon tile still stands out in light and dark themes. -->
      <Setter Property="Background" Value="#263B82F6" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Sk.TileBackground}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.overlay">
      <Setter Property="Background" Value="#99000000" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Margin" Value="20" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,4" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Sk.MutedText}" />
    </Style>
    <!-- Presence dots: green online, amber busy, gray offline. -->
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="#22C55E" />
    </Style>
    <Style Selector="Ellipse.dot.busy">
      <Setter Property="Fill" Value="#F59E0B" />
    </Style>
    <Style Selector="Ellipse.dot.muted">
      <Setter Property="Fill" Value="#9CA3AF" />
    </Style>
    <Style Selector="Ellipse.dot.error">
      <Setter Property="Fill" Value="#EF4444" />
    </Style>
    <Style Selector="PathIcon.done">
      <Setter Property="Foreground" Value="#22C55E" />
    </Style>
    <!-- Bottom navigation: icon above a short label, the current tab in the accent color, no underline. -->
    <Style Selector="TabControl.nav TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="0,8" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TabControl.nav TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabControl.nav TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <!-- A tab page fades in and rises a few pixels as it appears, like a short CSS transition: only opacity and
         a translation, which the GPU composes without laying anything out again. -->
    <Style Selector="Panel.page">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="Panel.page[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="10" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- File: "Nhận | Đã gửi", a segmented switch, the chosen side raised like a card. -->
    <Style Selector="Border.segments">
      <Setter Property="Background" Value="{DynamicResource Sk.TileBackground}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0,7" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.segment.on">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.segment.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <!-- Tin nhắn: a row of the list, and the bubbles, ours on the right in the accent color. -->
    <Style Selector="Button.person">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.unread">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.bubble">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="MaxWidth" Value="290" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <Style Selector="Border.bubble.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <Style Selector="Border.bubble.mine TextBlock, Border.bubble.mine SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <!-- A picture in a file card: no button chrome, only the picture. -->
    <Style Selector="Button.picture">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- A message checked in "Chọn nhiều": its row washed in the accent blue, as the cards are. -->
    <!-- Transparent, not empty, so a tap between the bubble and the edge still reaches the row. Set here rather than on
         the row itself, where it would win over "picked". -->
    <Style Selector="Grid.chatrow">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.chatrow.picked">
      <Setter Property="Background" Value="#263B82F6" />
    </Style>
    <!-- A web address in a message: underlined, in the accent color (white on our own bubbles). -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Border.bubble.mine Button.link TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <!-- Files sent between the two: a card among the messages, on the sender's side. -->
    <Style Selector="Border.filecard">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="MaxWidth" Value="300" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sk.CardBorder}" />
      <Setter Property="Background" Value="{DynamicResource Sk.CardBackground}" />
    </Style>
    <Style Selector="Border.filecard.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- A voice message: ▶ on a disc, the waveform (played part in full color), the length. -->
    <Style Selector="Button.play">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="Border.bubble.mine Button.play">
      <Setter Property="Background" Value="{DynamicResource AccentButtonForeground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <Style Selector="Rectangle.bar">
      <Setter Property="Width" Value="2" />
      <Setter Property="RadiusX" Value="1" />
      <Setter Property="RadiusY" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <Style Selector="Border.bubble.mine Rectangle.bar">
      <Setter Property="Fill" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <!-- 🎤 is held to record: it swells while it does. -->
    <Style Selector="Border.mic">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <Style Selector="Border.mic.active">
      <Style.Animations>
        <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="1.35" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.35" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Let go: back to its size (the view adds "released"; an animation's value outlives its class). -->
    <Style Selector="Border.mic.released">
      <Style.Animations>
        <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="1.35" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.35" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.mic.cancel">
      <Setter Property="Background" Value="#EF4444" />
    </Style>
    <Style Selector="Border.mic:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Border.bubble.unknown TextBlock.body">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <!-- A notice floats like an Android toast: dark rounded box near the bottom, rising in as it appears. -->
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="#E6323232" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,4,4,4" />
      <Setter Property="Margin" Value="4,0,4,12" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="BoxShadow" Value="0 4 12 0 #40000000" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="Border.toast[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="16" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- The engine starts in the background (database, identity). -->
    <TextBlock Text="{l:T 'Đang khởi động…'}" HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding $parent[UserControl].DataContext, Converter={x:Static ObjectConverters.IsNull}}" />

    <DockPanel Margin="0,28,0,0" IsVisible="{Binding $parent[UserControl].DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
      <!-- Cài đặt: this phone, its name, then its short id and where files land. -->
      <Grid x:Name="Header" DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="16,12,16,8" IsVisible="{Binding IsSettingsTab}">
        <Image Source="/Assets/shorekeeper.png" Width="40" Height="40" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>

      <!-- Every other tab: its name, large. -->
      <TextBlock x:Name="PageTitle" DockPanel.Dock="Top" Text="{Binding PageTitle}" IsVisible="{Binding HasPageTitle}"
                 FontSize="28" FontWeight="Bold" Margin="16,14,16,10" />

      <!-- While another device's sound plays here ("Nghe"), whatever the tab. -->
      <!-- The tab strip only: the pages below stay built and are just shown or hidden, as rebuilding one on every
           switch (what TabControl does with its content) took up to 200 ms on a phone. -->
      <TabControl x:Name="Tabs" Classes="nav" DockPanel.Dock="Bottom" TabStripPlacement="Bottom" Padding="0" SelectedIndex="{Binding SelectedTab}">
        <TabControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </TabControl.ItemsPanel>

        <TabItem AutomationProperties.Name="{l:T 'Xóm'}">
          <TabItem.Header>
            <StackPanel Spacing="3">
              <PathIcon Data="{StaticResource Icon.People}" Width="22" Height="22" HorizontalAlignment="Center" />
              <TextBlock Text="{l:T 'Xóm'}" HorizontalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
        <TabItem AutomationProperties.Name="File">
          <TabItem.Header>
            <StackPanel Spacing="3">
              <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="22" Height="22" HorizontalAlignment="Center" />
              <TextBlock Text="File" HorizontalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
        <TabItem AutomationProperties.Name="{l:T 'Tin nhắn'}">
          <TabItem.Header>
            <StackPanel Spacing="3">
              <!-- A red dot while something is unread. -->
              <Panel HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.Chat}" Width="22" Height="22" />
                <Ellipse Width="8" Height="8" Fill="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-3,0"
                         IsVisible="{Binding Chat.HasUnread}" />
              </Panel>
              <TextBlock Text="{l:T 'Tin nhắn'}" HorizontalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
        <TabItem AutomationProperties.Name="{l:T 'Nhóm'}">
          <TabItem.Header>
            <StackPanel Spacing="3">
              <PathIcon Data="{StaticResource Icon.Team}" Width="22" Height="22" HorizontalAlignment="Center" />
              <TextBlock Text="{l:T 'Nhóm'}" HorizontalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
        <TabItem AutomationProperties.Name="{l:T 'Âm thanh'}">
          <TabItem.Header>
            <StackPanel Spacing="3">
              <!-- A red dot while listening or playing; stopping is on the tab, in the notification and on the widget. -->
              <Panel HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.Speaker}" Width="22" Height="22" />
                <Ellipse Width="8" Height="8" Fill="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-3,0">
                  <Ellipse.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                      <Binding Path="Audio.IsListening" />
                      <Binding Path="Audio.IsPlaying" />
                    </MultiBinding>
                  </Ellipse.IsVisible>
                </Ellipse>
              </Panel>
              <TextBlock Text="{l:T 'Âm thanh'}" HorizontalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
        <TabItem AutomationProperties.Name="{l:T 'Cài đặt'}">
          <TabItem.Header>
            <StackPanel Spacing="3">
              <PathIcon Data="{StaticResource Icon.Settings}" Width="22" Height="22" HorizontalAlignment="Center" />
              <TextBlock Text="{l:T 'Cài đặt'}" HorizontalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
        </TabItem>
      </TabControl>

      <Panel Margin="12,4,12,0">
        <Panel Classes="page" IsVisible="{Binding IsNearbyTab}">
        <Panel>
          <StackPanel IsVisible="{Binding HasNoPeers}" Spacing="6" Margin="16,48" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.People}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{l:T 'Chưa thấy ai trong mạng. Mở Shorekeeper trên máy tính cùng Wi-Fi.'}"
                       TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
          <ScrollViewer>
            <!-- Room at the end so the last card can scroll above the + button. -->
            <ItemsControl ItemsSource="{Binding Peers}" Margin="0,0,0,80">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PeerItemViewModel">
                  <Border Classes="card">
                    <!-- Tall enough that ⋮ (top) and the main action (bottom) do not crowd each other. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="96">
                      <Border Classes="tile" VerticalAlignment="Center">
                        <Panel>
                          <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="22" Height="22" />
                          <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="22" Height="22" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsTrusted}">
                          <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding !IsOnline}" />
                          <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{l:T '⚠ Chưa kết nối'}" IsVisible="{Binding !IsTrusted}" FontSize="12" />
                      </StackPanel>

                      <!-- ⋮ in the corner, the main action below it. -->
                      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                        <Button HorizontalAlignment="Right" Padding="6" Margin="0,-4,-6,0" Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="{l:T 'Thêm'}">
                          <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16">
                            <PathIcon.RenderTransform>
                              <RotateTransform Angle="90" />
                            </PathIcon.RenderTransform>
                          </PathIcon>
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem Header="{l:T 'Nhắn tin'}" Command="{Binding MessageCommand}" IsVisible="{Binding IsTrusted}" />
                              <MenuItem Header="{l:T 'Tự nhận file…'}" Command="{Binding ChooseAutoAcceptCommand}" IsVisible="{Binding IsTrusted}"
                                        ToggleType="CheckBox" IsChecked="{Binding IsAutoAccept, Mode=OneWay}" />
                              <MenuItem Header="{l:T 'Gửi văn bản…'}" Command="{Binding SendTextCommand}" IsVisible="{Binding IsTrusted}" />
                              <MenuItem Header="{l:T 'Đặt tên gợi nhớ…'}" Command="{Binding RenameCommand}" IsVisible="{Binding IsTrusted}" />
                              <MenuItem Header="{l:T 'Ngắt kết nối'}" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsTrusted}" />
                              <MenuItem Header="{l:T 'Chặn'}" Command="{Binding BlockCommand}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                          <Button Command="{Binding MessageCommand}" IsVisible="{Binding IsTrusted}" Padding="9,7"
                                  AutomationProperties.Name="{l:T 'Nhắn tin'}">
                            <PathIcon Data="{StaticResource Icon.Chat}" Width="16" Height="16" />
                          </Button>
                          <Button Content="{l:T 'Kết nối'}" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" Classes="accent"
                                  Padding="12,6" FontSize="13" />
                          <Button Click="OnSendFiles" IsVisible="{Binding CanSend}" Classes="accent" Padding="12,6" FontSize="13"
                                  AutomationProperties.Name="{l:T 'Gửi file…'}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Data="{StaticResource Icon.Send}" Width="14" Height="14" />
                              <TextBlock Text="{l:T 'Gửi file…'}" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <!-- "Thêm máy bằng địa chỉ", for devices the phone cannot see by itself. -->
          <Button Classes="accent" Command="{Binding OpenAddPeerCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Width="44" Height="44" CornerRadius="22" Padding="0" Margin="0,0,6,14"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  AutomationProperties.Name="{l:T 'Thêm máy bằng địa chỉ'}">
            <PathIcon Data="{StaticResource Icon.Add}" Width="20" Height="20" />
          </Button>
        </Panel>
        </Panel>
        <!-- File (docs/15-chat.md §6.2): "Nhận" and "Đã gửi" share one tab, so "Tin nhắn" has room in the tab strip. -->
        <DockPanel IsVisible="{Binding IsFilesTab}">
        <Border DockPanel.Dock="Top" Classes="segments" Margin="0,0,0,10">
          <Grid ColumnDefinitions="*,*">
            <Button Classes="segment" Classes.on="{Binding !FilesShowSent}" Command="{Binding ShowReceivedCommand}" Content="{l:T 'Nhận'}" />
            <Button Grid.Column="1" Classes="segment" Classes.on="{Binding FilesShowSent}" Command="{Binding ShowSentFilesCommand}" Content="{l:T 'Đã gửi'}" />
          </Grid>
        </Border>
        <Panel>
        <Panel Classes="page" IsVisible="{Binding IsInboxTab}">
        <Panel>
          <StackPanel IsVisible="{Binding HasNoOffers}" Spacing="6" Margin="16,48" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Download}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{l:T 'Chưa có ai gửi gì cho bạn.'}" TextAlignment="Center" />
          </StackPanel>
          <DockPanel>
          <!-- While choosing (long press on a card): "Chọn tất cả", the count and what to do with the checked cards. -->
          <StackPanel DockPanel.Dock="Top" DataContext="{Binding OfferSelection}" x:DataType="vm:ListSelection" Margin="0,0,0,8" IsVisible="{Binding IsOn}" Classes="selectionbar">
            <Border Classes="card" IsVisible="{Binding IsOn}" Margin="0" Padding="12,6">
              <!-- [☐ Chọn tất cả] Đã chọn N … [✕ end choosing] [⋮ what to do with the checked cards]. -->
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <CheckBox IsChecked="{Binding All}" Content="{l:T 'Chọn tất cả'}" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Text}" FontSize="12" Margin="8,0" VerticalAlignment="Center" />
                <!-- A small round close, as on Android chips: a light disc with a thin, muted ✕. -->
                <Button Grid.Column="2" Classes="round close" Command="{Binding StopCommand}" VerticalAlignment="Center" Margin="0,0,6,0"
                        AutomationProperties.Name="{l:T 'Xong'}" ToolTip.Tip="{l:T 'Xong'}">
                  <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
                </Button>
                <Button Grid.Column="3" Classes="round" VerticalAlignment="Center" Margin="0,0,-4,0" IsEnabled="{Binding HasAny}"
                        AutomationProperties.Name="{l:T 'Thêm'}">
                  <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16">
                    <PathIcon.RenderTransform>
                      <RotateTransform Angle="90" />
                    </PathIcon.RenderTransform>
                  </PathIcon>
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{l:T 'Xóa khỏi lịch sử'}" Command="{Binding RemoveCommand}" />
                      <MenuItem Header="{l:T 'Xóa kèm file đã nhận…'}" Command="{Binding RemoveWithFilesCommand}" IsVisible="{Binding CanRemoveWithFiles}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Offers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OfferItemViewModel">
                  <Border Classes="card offer" Classes.picked="{Binding IsSelected}" Classes.leaving="{Binding IsLeaving}" Holding="OnCardHolding" Tapped="OnCardTapped"
                          PointerPressed="OnCardPressed" PointerReleased="OnCardLetGo" PointerCaptureLost="OnCardLetGo">
                    <DockPanel>
                    <CheckBox DockPanel.Dock="Left" Classes="pick" IsChecked="{Binding IsSelected}" IsVisible="{Binding Selection.IsOn}" VerticalAlignment="Center" MinWidth="0" Width="24" Padding="0" Margin="0,0,10,0"
                              AutomationProperties.Name="{l:T 'Chọn'}" />
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="tile">
                        <Panel>
                          <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dvm:TransferKind.Files}}" Width="22" Height="22" />
                          <PathIcon Data="{StaticResource Icon.Image}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dvm:TransferKind.Images}}" Width="22" Height="22" />
                          <PathIcon Data="{StaticResource Icon.FolderOpen}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dvm:TransferKind.Folder}}" Width="22" Height="22" />
                          <PathIcon Data="{StaticResource Icon.Text}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dvm:TransferKind.Text}}" Width="22" Height="22" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" IsVisible="{Binding IsFiles}" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding Text}" IsVisible="{Binding IsText}" TextWrapping="Wrap" MaxLines="8" />
                        <!-- "app.zip + 2 mục" names only the first: the button opens the whole list. -->
                        <StackPanel DataContext="{Binding Contents}" x:DataType="dvm:OfferContents" IsVisible="{Binding CanExpand}" Spacing="2">
                          <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Padding="0,2" FontSize="13" HorizontalAlignment="Left"
                                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentButtonBackground}" />
                          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <!-- The bullet keeps its own column, so a long name wraps under itself, not below the bullet. -->
                                <Grid ColumnDefinitions="Auto,*">
                                  <TextBlock Text="•" FontSize="14" Margin="0,0,6,0" />
                                  <TextBlock Grid.Column="1" Text="{Binding}" FontSize="14" TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontStyle="Italic" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Progress}" IsVisible="{Binding IsDownloading}" MinWidth="0" Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <PathIcon Classes="done" Data="{StaticResource Icon.CheckCircle}" IsVisible="{Binding IsCompleted}" Width="14" Height="14" />
                          <TextBlock Classes="muted" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,6,0,0">
                          <Button Content="{l:T 'Tải'}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Classes="accent" />
                          <Button Content="{l:T 'Bỏ qua'}" Command="{Binding DeclineCommand}" IsVisible="{Binding CanDecline}" />
                          <Button Content="{l:T 'Sao chép'}" Command="{Binding CopyCommand}" IsVisible="{Binding IsText}" Classes="accent" />
                          <Button Content="{l:T 'Mở'}" Command="{Binding OpenLinkCommand}" IsVisible="{Binding IsLink}" />
                        </WrapPanel>
                      </StackPanel>
                      <!-- ⋮: take it out of the list, with or without the files received. -->
                      <Button Grid.Column="2" VerticalAlignment="Top" Padding="6" Margin="4,-4,-6,0" Background="Transparent" BorderThickness="0"
                              AutomationProperties.Name="{l:T 'Thêm'}">
                        <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16">
                          <PathIcon.RenderTransform>
                            <RotateTransform Angle="90" />
                          </PathIcon.RenderTransform>
                        </PathIcon>
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="{l:T 'Chọn nhiều'}" Command="{Binding SelectManyCommand}" />
                            <MenuItem Header="{l:T 'Xóa khỏi lịch sử (giữ file)'}" Command="{Binding RemoveCommand}" IsEnabled="{Binding !IsDownloading}" />
                            <MenuItem Header="{l:T 'Xóa kèm file đã nhận…'}" Command="{Binding RemoveWithFilesCommand}" IsVisible="{Binding HasFiles}" IsEnabled="{Binding !IsDownloading}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </Grid>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </DockPanel>
        </Panel>
        </Panel>
        <Panel Classes="page" IsVisible="{Binding IsSentTab}">
        <Panel>
          <StackPanel IsVisible="{Binding HasNoSent}" Spacing="6" Margin="16,48" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Upload}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{l:T 'Chưa gửi gì. Chạm Gửi file… ở một người đã kết nối, hoặc Chia sẻ từ Thư viện ảnh / Files.'}"
                       TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
          <DockPanel>
          <!-- While choosing (long press on a card): "Chọn tất cả", the count and what to do with the checked cards. -->
          <StackPanel DockPanel.Dock="Top" DataContext="{Binding SentSelection}" x:DataType="vm:ListSelection" Margin="0,0,0,8" IsVisible="{Binding IsOn}" Classes="selectionbar">
            <Border Classes="card" IsVisible="{Binding IsOn}" Margin="0" Padding="12,6">
              <!-- [☐ Chọn tất cả] Đã chọn N … [✕ end choosing] [⋮ what to do with the checked cards]. -->
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <CheckBox IsChecked="{Binding All}" Content="{l:T 'Chọn tất cả'}" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Text}" FontSize="12" Margin="8,0" VerticalAlignment="Center" />
                <!-- A small round close, as on Android chips: a light disc with a thin, muted ✕. -->
                <Button Grid.Column="2" Classes="round close" Command="{Binding StopCommand}" VerticalAlignment="Center" Margin="0,0,6,0"
                        AutomationProperties.Name="{l:T 'Xong'}" ToolTip.Tip="{l:T 'Xong'}">
                  <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
                </Button>
                <Button Grid.Column="3" Classes="round" VerticalAlignment="Center" Margin="0,0,-4,0" IsEnabled="{Binding HasAny}"
                        AutomationProperties.Name="{l:T 'Thêm'}">
                  <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16">
                    <PathIcon.RenderTransform>
                      <RotateTransform Angle="90" />
                    </PathIcon.RenderTransform>
                  </PathIcon>
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{l:T 'Xóa khỏi lịch sử'}" Command="{Binding RemoveCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Sent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SentItemViewModel">
                  <Border Classes="card offer" Classes.picked="{Binding IsSelected}" Classes.leaving="{Binding IsLeaving}" Holding="OnCardHolding" Tapped="OnCardTapped"
                          PointerPressed="OnCardPressed" PointerReleased="OnCardLetGo" PointerCaptureLost="OnCardLetGo">
                    <DockPanel>
                    <CheckBox DockPanel.Dock="Left" Classes="pick" IsChecked="{Binding IsSelected}" IsVisible="{Binding Selection.IsOn}" VerticalAlignment="Center" MinWidth="0" Width="24" Padding="0" Margin="0,0,10,0"
                              AutomationProperties.Name="{l:T 'Chọn'}" />
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="tile">
                        <Panel>
                          <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dvm:TransferKind.Files}}" Width="22" Height="22" />
                          <PathIcon Data="{StaticResource Icon.Image}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dvm:TransferKind.Images}}" Width="22" Height="22" />
                          <PathIcon Data="{StaticResource Icon.FolderOpen}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dvm:TransferKind.Folder}}" Width="22" Height="22" />
                          <PathIcon Data="{StaticResource Icon.Text}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dvm:TransferKind.Text}}" Width="22" Height="22" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <!-- "app.zip + 2 mục" names only the first: the button opens the whole list. -->
                        <StackPanel DataContext="{Binding Contents}" x:DataType="dvm:OfferContents" IsVisible="{Binding CanExpand}" Spacing="2">
                          <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Padding="0,2" FontSize="13" HorizontalAlignment="Left"
                                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentButtonBackground}" />
                          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <!-- The bullet keeps its own column, so a long name wraps under itself, not below the bullet. -->
                                <Grid ColumnDefinitions="Auto,*">
                                  <TextBlock Text="•" FontSize="14" Margin="0,0,6,0" />
                                  <TextBlock Grid.Column="1" Text="{Binding}" FontSize="14" TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Status}" FontSize="12" />
                        <TextBlock Text="{Binding Recipients}" FontSize="13" TextWrapping="Wrap" />
                        <Button Content="{l:T 'Thu hồi'}" Command="{Binding WithdrawCommand}" IsVisible="{Binding CanWithdraw}" Margin="0,6,0,0" />
                      </StackPanel>
                      <Button Grid.Column="2" VerticalAlignment="Top" Padding="6" Margin="4,-4,-6,0" Background="Transparent" BorderThickness="0"
                              AutomationProperties.Name="{l:T 'Thêm'}">
                        <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16">
                          <PathIcon.RenderTransform>
                            <RotateTransform Angle="90" />
                          </PathIcon.RenderTransform>
                        </PathIcon>
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="{l:T 'Chọn nhiều'}" Command="{Binding SelectManyCommand}" />
                            <MenuItem Header="{l:T 'Xóa khỏi lịch sử'}" Command="{Binding RemoveCommand}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </Grid>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </DockPanel>
        </Panel>
        </Panel>
        </Panel>
        </DockPanel>

        <!-- Tin nhắn (docs/15-chat.md §6.2): the list, or one conversation over it; ← and the Back button return to the list. -->
        <Panel Classes="page" IsVisible="{Binding IsChatTab}">
        <Panel DataContext="{Binding Chat}" x:DataType="dvm:ChatViewModel">
          <Panel IsVisible="{Binding !IsOpen}">
            <StackPanel IsVisible="{Binding !HasConversations}" Spacing="6" Margin="16,48" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Chat}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="{l:T 'Kết nối với một máy ở Xóm để nhắn tin cho nhau.'}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Conversations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="dvm:ChatPersonViewModel">
                    <Button Classes="person" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel>
                          <Border Classes="tile" VerticalAlignment="Center">
                            <Panel>
                              <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="22" Height="22" />
                              <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="22" Height="22" />
                            </Panel>
                          </Border>
                          <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" IsVisible="{Binding IsOnline}" Width="12" Height="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                   Stroke="{DynamicResource Sk.WindowBackground}" StrokeThickness="2" />
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes.muted="{Binding !HasUnread}" Classes.unread="{Binding HasUnread}" Text="{Binding Preview}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Classes="muted" Text="{Binding TimeText}" FontSize="12" HorizontalAlignment="Right" />
                          <Border Background="#EF4444" CornerRadius="9" MinWidth="18" Padding="5,0" HorizontalAlignment="Right" IsVisible="{Binding HasUnread}">
                            <TextBlock Text="{Binding Unread}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                          </Border>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>

          <DockPanel IsVisible="{Binding IsOpen}">
            <!-- ← Who, and whether they are there; ⋮ for the conversation. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
              <Button Grid.Column="2" Classes="round" Width="40" Height="40" CornerRadius="20" Margin="0,0,-6,0" AutomationProperties.Name="{l:T 'Thêm'}">
                <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16">
                  <PathIcon.RenderTransform>
                    <RotateTransform Angle="90" />
                  </PathIcon.RenderTransform>
                </PathIcon>
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{l:T 'Xóa hội thoại…'}" Command="{Binding DeleteConversationCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="round" Command="{Binding CloseCommand}" Width="40" Height="40" CornerRadius="20" Margin="-6,0,4,0"
                      AutomationProperties.Name="{l:T 'Quay lại'}">
                <PathIcon Data="{StaticResource Icon.ArrowLeft}" Width="20" Height="20" />
              </Button>
              <StackPanel Grid.Column="1" DataContext="{Binding Current}" x:DataType="dvm:ChatPersonViewModel" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding !IsOnline}" />
                  <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- "Chọn nhiều": [☐ Chọn tất cả] Đã chọn N … [✕ end choosing] [Xóa the checked messages]. -->
            <Border DockPanel.Dock="Top" Classes="card selectionbar" IsVisible="{Binding IsSelecting}" Margin="0,0,0,6" Padding="12,6">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <CheckBox IsChecked="{Binding AllSelected}" Content="{l:T 'Chọn tất cả'}" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SelectedText}" FontSize="12" Margin="8,0" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="round close" Command="{Binding StopSelectingCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                        AutomationProperties.Name="{l:T 'Xong'}">
                  <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
                </Button>
                <Button Grid.Column="3" Content="{l:T 'Xóa'}" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}" Padding="14,5" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- 📎 (files to this person), the box, and ➤; empty, 🎤 instead: hold to record, slide left to cancel, let go to send. -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,10">
              <TextBlock Classes="muted" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" FontSize="12" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="round" Command="{Binding AttachCommand}" IsEnabled="{Binding CanAttach}" Width="40" Height="40" CornerRadius="20" Margin="-6,0,2,1"
                        VerticalAlignment="Bottom" AutomationProperties.Name="{l:T 'Gửi file…'}">
                  <PathIcon Data="{StaticResource Icon.Attach}" Width="20" Height="20" />
                </Button>
                <TextBox Grid.Column="1" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" IsEnabled="{Binding CanWrite}" CornerRadius="20" Padding="14,9"
                         VerticalContentAlignment="Center" TextInputOptions.Multiline="True" TextInputOptions.ReturnKeyType="Return"
                         PlaceholderText="{l:T 'Nhập tin nhắn…'}" AutomationProperties.Name="{l:T 'Tin nhắn'}" IsVisible="{Binding IsComposing}" />
                <Border Grid.Column="1" IsVisible="{Binding IsRecording}" Background="{DynamicResource Sk.TileBackground}" CornerRadius="20" Height="42" Padding="16,0">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <Ellipse Classes="dot error" Classes.recording="{Binding IsRecording}" Width="10" Height="10" />
                    <TextBlock Grid.Column="1" Text="{Binding RecordingText}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{l:T '‹ Vuốt sang trái để hủy'}" IsVisible="{Binding !WillCancel}" FontSize="13"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{l:T 'Thả tay để hủy'}" IsVisible="{Binding WillCancel}" Foreground="#EF4444" FontSize="13"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Panel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom">
                  <Button Classes="accent" Command="{Binding SendCommand}" Width="42" Height="42" CornerRadius="21" Padding="0" IsVisible="{Binding ShowsSend}"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="{l:T 'Gửi'}">
                    <PathIcon Data="{StaticResource Icon.Send}" Width="18" Height="18" />
                  </Button>
                  <Border Classes="mic" Classes.active="{Binding IsRecording}" Classes.cancel="{Binding WillCancel}" IsVisible="{Binding ShowsMicrophone}" IsEnabled="{Binding CanWrite}"
                          PointerPressed="OnMicPressed" PointerMoved="OnMicMoved" PointerReleased="OnMicReleased" PointerCaptureLost="OnMicLost"
                          AutomationProperties.Name="{l:T 'Giữ để ghi tin nhắn thoại'}">
                    <PathIcon Data="{StaticResource Icon.Mic}" Width="20" Height="20" Foreground="{DynamicResource AccentButtonForeground}" />
                  </Border>
                </Panel>
              </Grid>
            </StackPanel>

            <Panel>
              <TextBlock Classes="muted" IsVisible="{Binding HasNoMessages}" Text="{l:T 'Chưa có tin nhắn. Gửi lời chào đi!'}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <ScrollViewer x:Name="ChatScroller">
                <ItemsControl ItemsSource="{Binding Messages}">
                  <!-- Only the messages on screen are built and measured: all of them took a second to lay out. -->
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.DataTemplates>
                    <DataTemplate DataType="{x:Type dvm:ChatBubbleViewModel}" x:DataType="dvm:ChatBubbleViewModel">
                      <StackPanel>
                        <TextBlock Classes="muted" Text="{Binding DayText}" IsVisible="{Binding HasDay}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,6" />
                        <!-- While choosing, a tap anywhere on the row checks or unchecks the message. -->
                        <Grid Classes="chatrow" Classes.picked="{Binding IsSelected}" ColumnDefinitions="Auto,*" Tapped="OnChatRowTapped">
                        <CheckBox Classes="pick" IsChecked="{Binding IsSelected}" IsVisible="{Binding Owner.IsSelecting}" VerticalAlignment="Center" MinWidth="0" Width="24" Padding="0" Margin="0,0,10,0"
                                  AutomationProperties.Name="{l:T 'Chọn'}" />
                        <!-- Long press: copy the words, choose several, or take the message away here. -->
                        <Border Grid.Column="1" Classes="bubble" Classes.mine="{Binding IsMine}" Classes.unknown="{Binding IsUnknown}" Holding="OnBubbleHolding">
                          <FlyoutBase.AttachedFlyout>
                            <MenuFlyout>
                              <MenuItem Header="{l:T 'Sao chép'}" Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}" />
                              <MenuItem Header="{l:T 'Thu hồi'}" Command="{Binding RecallCommand}" IsVisible="{Binding CanRecall}" />
                              <MenuItem Header="{l:T 'Chọn nhiều'}" Command="{Binding SelectManyCommand}" />
                              <MenuItem Header="{l:T 'Xóa tin nhắn'}" Command="{Binding DeleteCommand}" />
                            </MenuFlyout>
                          </FlyoutBase.AttachedFlyout>
                          <StackPanel Spacing="2">
                            <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" IsVisible="{Binding IsText}" />
                            <ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <Button Classes="link" Command="{Binding $parent[ItemsControl].((dvm:ChatBubbleViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsVoice}" Margin="-4,2,0,0">
                              <Button Classes="play" Command="{Binding PlayCommand}" AutomationProperties.Name="{l:T 'Phát'}">
                                <Panel>
                                  <PathIcon Data="{StaticResource Icon.Play}" Width="14" Height="14" IsVisible="{Binding !IsPlaying}" Margin="2,0,0,0" />
                                  <PathIcon Data="{StaticResource Icon.Pause}" Width="14" Height="14" IsVisible="{Binding IsPlaying}" />
                                </Panel>
                              </Button>
                              <Panel Grid.Column="1" Margin="8,0" Height="26" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Bars}" Opacity="0.4">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:Double">
                                      <Rectangle Classes="bar" Height="{Binding}" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Panel Width="{Binding PlayedWidth}" HorizontalAlignment="Left" ClipToBounds="True">
                                  <ItemsControl ItemsSource="{Binding Bars}" Width="{x:Static dvm:ChatBubbleViewModel.WaveWidth}" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:Double">
                                        <Rectangle Classes="bar" Height="{Binding}" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Panel>
                              </Panel>
                              <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" FontSize="13" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                              <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                              <Button Content="{l:T 'Gửi lại'}" Command="{Binding RetryCommand}" IsVisible="{Binding IsFailed}" Padding="8,2" FontSize="12" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type dvm:ChatFileViewModel}" x:DataType="dvm:ChatFileViewModel">
                      <StackPanel>
                        <TextBlock Classes="muted" Text="{Binding DayText}" IsVisible="{Binding HasDay}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,6" />
                        <!-- Long press: take back what we sent (five minutes), then only stop sharing it; or see it in File. -->
                        <Border Classes="filecard" Classes.mine="{Binding IsMine}" Holding="OnFileCardHolding">
                          <FlyoutBase.AttachedFlyout>
                            <MenuFlyout>
                              <MenuItem Header="{l:T 'Thu hồi'}" Command="{Binding RecallCommand}" IsVisible="{Binding CanRecall}" />
                              <MenuItem Header="{l:T 'Ngừng chia sẻ'}" Command="{Binding WithdrawCommand}" IsVisible="{Binding CanStopSharing}" />
                              <MenuItem Header="Xem" Command="{Binding ShowCommand}" />
                            </MenuFlyout>
                          </FlyoutBase.AttachedFlyout>
                          <Panel>
                          <!-- Taken back by its sender: a note, as for a message. -->
                          <StackPanel IsVisible="{Binding IsRecalled}" Spacing="2">
                            <TextBlock Text="{Binding RecalledText}" FontStyle="Italic" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" HorizontalAlignment="Right" />
                          </StackPanel>
                          <!-- An offer of pictures shows the first few, or all of them small after "+N ảnh"; click one to open it. -->
                          <StackPanel IsVisible="{Binding HasPictures}" Spacing="4">
                            <ItemsControl ItemsSource="{Binding Pictures}" IsVisible="{Binding !IsExpanded}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dvm:ChatPicture">
                                  <Button Classes="picture" Command="{Binding $parent[ItemsControl].((dvm:ChatFileViewModel)DataContext).OpenPictureCommand}" CommandParameter="{Binding}">
                                    <Border CornerRadius="10" ClipToBounds="True">
                                      <Image Source="{Binding Image}" MaxWidth="260" MaxHeight="300" Stretch="Uniform" />
                                    </Border>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding AllPictures}" IsVisible="{Binding IsExpanded}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <UniformGrid Columns="3" ColumnSpacing="4" RowSpacing="4" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dvm:ChatPicture">
                                  <Button Classes="picture" Command="{Binding $parent[ItemsControl].((dvm:ChatFileViewModel)DataContext).OpenPictureCommand}" CommandParameter="{Binding}">
                                    <Border CornerRadius="6" ClipToBounds="True">
                                      <Image Source="{Binding Image}" Width="84" Height="84" Stretch="UniformToFill" />
                                    </Border>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto">
                              <Button Classes="link" Command="{Binding ToggleMoreCommand}" Click="OnMorePictures" IsVisible="{Binding HasMore}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MoreText}" FontSize="12" />
                              </Button>
                              <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusText}" FontSize="11" />
                            </Grid>
                          </StackPanel>
                          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsPlain}">
                            <Border Classes="tile" Width="38" Height="38" CornerRadius="9">
                              <Panel>
                                <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding !IsText}" Width="18" Height="18" />
                                <PathIcon Data="{StaticResource Icon.Text}" IsVisible="{Binding IsText}" Width="18" Height="18" />
                              </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" />
                              <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" />
                              <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsDownloading}" MinWidth="0" Margin="0,4" />
                              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Classes="accent" Content="{l:T 'Tải'}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Padding="14,6" />
                                <Button Content="Xem" Command="{Binding ShowCommand}" Padding="14,6" />
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                          </Panel>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </Panel>
        </Panel>
        <Panel Classes="page" IsVisible="{Binding IsGroupsTab}">
        <ScrollViewer DataContext="{Binding Groups}" x:DataType="vm:GroupsTabViewModel">
          <StackPanel Spacing="4" Margin="0,0,0,24">
            <TextBlock Classes="muted" Text="{l:T 'Quản trị viên đã tắt tính năng nhóm.'}" IsVisible="{Binding !IsEnabled}" Margin="4,12" />

            <ItemsControl ItemsSource="{Binding Invitations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InvitationItemViewModel">
                  <Border Classes="card" Background="#1A3B82F6">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                      <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Button Content="{l:T 'Đồng ý'}" Command="{Binding AcceptCommand}" Classes="accent" />
                        <Button Content="{l:T 'Từ chối'}" Command="{Binding DeclineCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="h3" Text="{l:T 'Nhóm của bạn'}" />
            <TextBlock Classes="muted" Text="{l:T 'Chưa ở nhóm nào. Xin vào một nhóm bên dưới, hoặc nhờ Host mời bạn.'}" IsVisible="{Binding !HasMyGroups}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding MyGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupItemViewModel">
                  <!-- As the contact cards: ⋮ in the corner for the rest, one small main action below. -->
                  <Border Classes="card">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="tile" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource Icon.Team}" Width="22" Height="22" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Top" Padding="6" Margin="0,-4,-6,0" Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="{l:T 'Thêm'}">
                          <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16">
                            <PathIcon.RenderTransform>
                              <RotateTransform Angle="90" />
                            </PathIcon.RenderTransform>
                          </PathIcon>
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem Header="{l:T 'Gửi văn bản cho nhóm…'}" Command="{Binding SendTextCommand}" IsVisible="{Binding CanSend}" />
                              <MenuItem Header="{Binding LeaveText}" Command="{Binding LeaveCommand}" IsVisible="{Binding CanLeave}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                  <!-- One row per member: device, name, Host/Bạn, status and where they are on the network. -->
                  <ItemsControl ItemsSource="{Binding Members}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GroupMemberItem">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                          <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Sk.TileBackground}" VerticalAlignment="Center">
                            <Panel>
                              <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="16" Height="16" />
                              <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="16" Height="16" />
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <Border Background="#33F59E0B" CornerRadius="4" Padding="6,1" IsVisible="{Binding IsHost}" VerticalAlignment="Center">
                                <TextBlock Text="Host" FontSize="11" />
                              </Border>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,Auto,*">
                              <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding !IsOnline}" Margin="0,0,6,0" />
                              <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusText}" FontSize="12" />
                              <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Detail, StringFormat=' · {0}'}" IsVisible="{Binding HasDetail}"
                                         FontSize="12" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                      <Button Click="OnSendToGroup" IsVisible="{Binding CanSend}" Classes="accent" Padding="12,6" FontSize="13" HorizontalAlignment="Right"
                              AutomationProperties.Name="{l:T 'Gửi file cho nhóm…'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource Icon.Send}" Width="14" Height="14" />
                          <TextBlock Text="{l:T 'Gửi file…'}" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="h3" Text="{l:T 'Nhóm trong mạng'}" IsVisible="{Binding HasNetworkGroups}" />
            <ItemsControl ItemsSource="{Binding NetworkGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NetworkGroupItemViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="tile">
                        <PathIcon Data="{StaticResource Icon.Team}" Width="22" Height="22" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{l:T 'Xin vào'}" Command="{Binding JoinCommand}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="h3" Text="{l:T 'Gần đây'}" IsVisible="{Binding HasNotices}" />
            <ItemsControl ItemsSource="{Binding Notices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="muted" Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        </Panel>
        <Panel Classes="page" IsVisible="{Binding IsAudioTab}">
        <ScrollViewer DataContext="{Binding Audio}" x:DataType="dvm:AudioViewModel">
          <StackPanel Spacing="6" Margin="0,0,0,24">
            <!-- Phát: this phone's sound for contacts that choose to listen. -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="tile" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Speaker}" Width="22" Height="22" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Phát âm thanh'}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="{l:T 'Máy đã kết nối thấy máy này đang phát và tự bấm Nghe khi muốn. Tắt là mọi máy đang nghe đều dừng.'}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsPlaying}" IsEnabled="{Binding CanPlay}" OnContent="" OffContent=""
                                MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Phát âm thanh'}" />
                </Grid>
                <!-- Nguồn tiếng: what apps play, or the microphone (the phone as a microphone); set while not playing. -->
                <ComboBox SelectedIndex="{Binding SourceIndex}" IsEnabled="{Binding !IsPlaying}" IsVisible="{Binding CanChooseSource}" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="{l:T 'Nguồn: âm thanh đang phát'}" />
                  <ComboBoxItem Content="{l:T 'Nguồn: micro (dùng điện thoại làm micro)'}" />
                </ComboBox>
                <!-- Optional password: a listener types it once, then its device remembers it. -->
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Data="{StaticResource Icon.Lock}" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="{l:T 'Không có mật khẩu: máy đã kết nối nào cũng nghe được.'}" IsVisible="{Binding !HasPassword}" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="{l:T 'Có mật khẩu: máy muốn nghe nhập một lần, sau đó tự nhớ.'}" IsVisible="{Binding HasPassword}" />
                  </Grid>
                  <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <Button Content="{l:T 'Đặt mật khẩu…'}" Command="{Binding SetPasswordCommand}" IsVisible="{Binding !HasPassword}" Padding="12,6" FontSize="13" />
                    <Button Content="{l:T 'Đổi mật khẩu…'}" Command="{Binding SetPasswordCommand}" IsVisible="{Binding HasPassword}" Padding="12,6" FontSize="13" />
                    <Button Content="{l:T 'Bỏ mật khẩu'}" Command="{Binding RemovePasswordCommand}" IsVisible="{Binding HasPassword}" Padding="12,6" FontSize="13" />
                  </WrapPanel>
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding IsPlaying}">
                  <TextBlock Text="{l:T 'Đang nghe'}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Classes="muted" Text="{l:T 'Chưa ai nghe'}" IsVisible="{Binding !HasListeners}" FontSize="12" />
                  <ItemsControl ItemsSource="{Binding Listeners}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dvm:AudioListenerItem">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                          <Panel>
                            <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="16" Height="16" />
                            <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="16" Height="16" />
                          </Panel>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{l:T 'Âm thanh đang phát: mỗi lần bật, Android hỏi cho phép ghi hoặc truyền màn hình (Shorekeeper chỉ lấy âm thanh, không lấy hình); một số app (thường là app phim) không cho thu, cuộc gọi cũng không. Micro: chỉ cần quyền ghi âm; máy tính chọn Phát ra là CABLE Input thì app họp trên máy tính dùng được làm micro. Lần đầu Android hỏi quyền ghi âm.'}" />

            <!-- Nghe: contacts with "Phát âm thanh" on. -->
            <TextBlock Classes="h3" Text="{l:T 'Nghe'}" />
            <TextBlock Classes="muted" Text="{l:T 'Chưa máy nào đang phát.'}" IsVisible="{Binding HasNoSources}" FontSize="12" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dvm:AudioSourceItem">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="tile" VerticalAlignment="Center">
                        <Panel>
                          <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding !IsPhone}" Width="22" Height="22" />
                          <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="22" Height="22" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsListening}">
                          <PathIcon Data="{StaticResource Icon.Lock}" Width="12" Height="12" IsVisible="{Binding IsLocked}" VerticalAlignment="Center" />
                          <TextBlock Classes="muted" Text="{l:T 'Đang phát âm thanh'}" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{l:T 'Đang nghe'}" IsVisible="{Binding IsListening}" FontSize="12"
                                   Foreground="{DynamicResource AccentButtonBackground}" />
                      </StackPanel>
                      <Panel Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="{l:T 'Nghe'}" Command="{Binding ListenCommand}" IsVisible="{Binding CanListen}" Classes="accent" Padding="12,6" FontSize="13" />
                        <Button Content="{l:T 'Dừng nghe'}" Command="{Binding StopListeningCommand}" IsVisible="{Binding IsListening}" Padding="12,6" FontSize="13" />
                      </Panel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Điều khiển: the source's media keys, when it lets us (a computer). -->
            <StackPanel IsVisible="{Binding CanControl}">
              <TextBlock Classes="h3" Text="{Binding ControlTitle}" />
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <UniformGrid Columns="3" ColumnSpacing="8">
                    <Button Command="{Binding PreviousCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                            AutomationProperties.Name="{l:T 'Bài trước'}">
                      <PathIcon Data="{StaticResource Icon.Previous}" Width="20" Height="20" />
                    </Button>
                    <Button Command="{Binding PlayPauseCommand}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                            AutomationProperties.Name="{l:T 'Phát/Dừng'}">
                      <PathIcon Data="{StaticResource Icon.PlayPause}" Width="20" Height="20" />
                    </Button>
                    <Button Command="{Binding NextCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                            AutomationProperties.Name="{l:T 'Bài sau'}">
                      <PathIcon Data="{StaticResource Icon.Next}" Width="20" Height="20" />
                    </Button>
                  </UniformGrid>
                  <UniformGrid Columns="3" ColumnSpacing="8">
                    <Button Content="{l:T 'Nhỏ đi'}" Command="{Binding VolumeDownCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" />
                    <Button Content="{l:T 'Tắt tiếng'}" Command="{Binding MuteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" />
                    <Button Content="{l:T 'To lên'}" Command="{Binding VolumeUpCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" />
                  </UniformGrid>
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="{l:T 'Như bấm phím media trên máy kia: app đang phát nhạc nhận Phát/Dừng và chuyển bài; âm lượng là âm lượng chung của máy đó.'}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Thống kê: how listening goes, every second. -->
            <StackPanel IsVisible="{Binding IsListening}">
              <TextBlock Classes="h3" Text="{l:T 'Thống kê'}" />
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*">
                    <Ellipse Classes="dot" Classes.busy="{Binding IsStatusWarning}" Classes.error="{Binding IsStatusBad}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dvm:AudioStatItem">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                          <TextBlock Classes="muted" Text="{Binding Label}" FontSize="13" Margin="0,0,12,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" TextAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock Classes="h3" Text="{l:T 'Độ trễ khi nghe'}" />
            <ComboBox SelectedIndex="{Binding LatencyIndex}" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="{l:T 'Thấp: cho game'}" />
              <ComboBoxItem Content="{l:T 'Ổn định: cho nghe nhạc'}" />
              <ComboBoxItem Content="{l:T 'Bảo toàn: không hụt tiếng, trễ hơn'}" />
            </ComboBox>
            <TextBlock Classes="muted" Text="{l:T 'Thấp trễ ít nhưng đôi khi hụt tiếng lúc Wi-Fi chập chờn; Ổn định trễ hơn một chút nhưng ít hụt; Bảo toàn xin gửi lại gói bị mất và chịu trễ thêm (có khi vài giây) khi mạng kém để không hụt nhịp nào. Áp dụng từ lần nghe sau.'}"
                       FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        </Panel>
        <Panel Classes="page" IsVisible="{Binding IsSettingsTab}">
        <ScrollViewer DataContext="{Binding Settings}" x:DataType="vm:SettingsTabViewModel">
          <StackPanel Spacing="6" Margin="0,0,0,24">
            <TextBlock Classes="h3" Text="{l:T 'Tên hiển thị'}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding DisplayName}" Margin="0,0,8,0" />
              <Button Grid.Column="1" Content="{l:T 'Lưu'}" Command="{Binding SaveNameCommand}" />
            </Grid>

            <TextBlock Classes="h3" Text="{l:T 'Ngôn ngữ'}" />
            <ComboBox ItemsSource="{x:Static l:LanguageChoice.All}" SelectedItem="{Binding Language}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="l:LanguageChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding NeedsRestart}">
              <TextBlock Classes="muted" Text="{l:T 'Ngôn ngữ mới có hiệu lực sau khi khởi động lại Shorekeeper.'}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Grid.Column="1" Content="{l:T 'Khởi động lại'}" Command="{Binding RestartAppCommand}" Classes="accent" />
            </Grid>

            <TextBlock Classes="h3" Text="{l:T 'Tự nhận file tối đa'}" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <NumericUpDown Value="{Binding AutoAcceptLimitGb}" Minimum="0.1" Maximum="10000" Increment="1" FormatString="0.##" ShowButtonSpinner="False" />
              <TextBlock Grid.Column="1" Text="GB" VerticalAlignment="Center" Margin="8,0" />
              <Button Grid.Column="2" Content="{l:T 'Lưu'}" Command="{Binding SaveAutoAcceptLimitCommand}" />
            </Grid>
            <TextBlock Classes="muted" Text="{l:T 'Cho máy đã kết nối có Tự nhận file theo cài đặt chung; từng máy có thể đặt riêng ở menu ⋮.'}" FontSize="12" TextWrapping="Wrap" />

            <TextBlock Classes="h3" Text="{l:T 'Tin nhắn'}" />
            <ToggleSwitch IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Chat.AutoDownloadPictures}"
                          OnContent="{l:T 'Tự tải ảnh máy đã kết nối gửi'}" OffContent="{l:T 'Tự tải ảnh máy đã kết nối gửi'}" />
            <TextBlock Classes="muted" Text="{l:T 'Ảnh đến 20 MB tự tải về thư mục nhận để hiện ngay trong Tin nhắn. Tắt thì ảnh chờ bạn bấm Tải như file khác.'}"
                       FontSize="12" TextWrapping="Wrap" />

            <TextBlock Classes="h3" Text="{l:T 'Chạy nền'}" />
            <ToggleSwitch IsChecked="{Binding AlwaysReceive}" OnContent="{l:T 'Luôn nhận file (kể cả khi tắt màn hình)'}" OffContent="{l:T 'Luôn nhận file (kể cả khi tắt màn hình)'}" />
            <TextBlock Classes="muted" Text="{l:T 'Giữ một thông báo thường trực để máy tính gửi được file bất cứ lúc nào. Tốn pin hơn một chút.'}"
                       FontSize="12" TextWrapping="Wrap" />
            <!-- Only while it is on: the system's own battery saver can still stop the app on these phones. -->
            <TextBlock Classes="muted" IsVisible="{Binding AlwaysReceive}" FontSize="12" TextWrapping="Wrap"
                       Text="{l:T 'Máy OPPO, Xiaomi, Vivo… còn có trình tiết kiệm pin riêng: vào Cài đặt → Pin → Shorekeeper và cho phép hoạt động nền, nếu không hệ thống vẫn có thể tắt app.'}" />

            <!-- Tự gửi ảnh: new pictures and videos to one computer, whenever it is online. -->
            <TextBlock Classes="h3" Text="{l:T 'Tự gửi ảnh về máy tính'}" />
            <StackPanel DataContext="{Binding PhotoBackup}" x:DataType="vm:PhotoBackupViewModel" Spacing="8">
              <ToggleSwitch IsChecked="{Binding IsOn}" OnContent="{l:T 'Tự gửi ảnh, video mới'}" OffContent="{l:T 'Tự gửi ảnh, video mới'}" />
              <TextBlock Classes="muted" Text="{l:T 'Chưa kết nối với máy tính nào.'}" IsVisible="{Binding HasNoComputer}" FontSize="12" />
              <!-- A bold label over the box, as the other fields of Cài đặt. -->
              <StackPanel Spacing="6" IsVisible="{Binding !HasNoComputer}">
                <TextBlock Text="{l:T 'Gửi về'}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <ComboBox ItemsSource="{Binding Computers}" SelectedIndex="{Binding ComputerIndex}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComputerOption">
                      <StackPanel Spacing="2" Margin="0,2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Classes="dot" Classes.muted="{Binding !IsOnline}" />
                          <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding StatusText}" /><Run Text=" · " /><Run Text="{Binding Detail}" />
                          </TextBlock>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <CheckBox IsChecked="{Binding CameraPhotos}" Content="{l:T 'Ảnh máy ảnh'}" />
              <CheckBox IsChecked="{Binding CameraVideos}" Content="{l:T 'Video máy ảnh'}" />
              <CheckBox IsChecked="{Binding Screenshots}" Content="{l:T 'Ảnh chụp màn hình'}" />
              <CheckBox IsChecked="{Binding Other}" Content="{l:T 'Ảnh, video khác (tải về, Zalo, Messenger…)'}" />
              <TextBlock Text="{Binding Status}" IsVisible="{Binding IsOn}" FontSize="13" TextWrapping="Wrap" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="{l:T 'Chỉ gửi những gì có từ lúc bật, mỗi khi máy tính online; chạy nền khi bật Luôn nhận file. Trên máy tính, bật Tự nhận file cho điện thoại này (menu ⋮ ở Xóm) để ảnh tự vào thư mục Ảnh từ (tên điện thoại); không thì chúng chờ ở Hộp nhận.'}" />
            </StackPanel>

            <TextBlock Classes="h3" Text="{l:T 'Sao lưu danh tính'}" />
            <TextBlock Classes="muted" Text="{l:T 'Giữ DeviceId, liên hệ và nhóm khi đổi điện thoại: không phải Kết nối lại với ai.'}"
                       FontSize="12" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,4,0,0">
              <Button Content="{l:T 'Sao lưu danh tính…'}" Command="{Binding StartBackupCommand}" />
              <Button Content="{l:T 'Khôi phục…'}" Click="OnPickBackup" />
            </WrapPanel>
            <TextBlock Text="{Binding BackupStatus}" IsVisible="{Binding HasBackupStatus}" FontSize="13" TextWrapping="Wrap" />

            <TextBlock Classes="h3" Text="{l:T 'Đã chặn'}" />
            <TextBlock Classes="muted" Text="{l:T 'Chưa chặn ai.'}" IsVisible="{Binding !Blocked.Items.Count}" FontSize="12" />
            <ItemsControl ItemsSource="{Binding Blocked.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dvm:BlockedPeerItem">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding HostName}" FontSize="12" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="{l:T 'Bỏ chặn'}" Command="{Binding UnblockCommand}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Thống kê (docs/10-ux.md §15): counts kept on this phone, and the storage the received files go to. -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h3" Text="{l:T 'Thống kê'}" />
              <Button Grid.Column="1" Content="{l:T 'Làm mới'}" Command="{Binding Stats.RefreshCommand}" Padding="12,4" FontSize="13" VerticalAlignment="Bottom" />
            </Grid>
            <Border Classes="card" Margin="0" DataContext="{Binding Stats}" x:DataType="dvm:StatsViewModel">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="78,*,*">
                    <TextBlock Grid.Column="1" Classes="muted" Text="{l:T 'Đã gửi'}" FontSize="12" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{l:T 'Đã nhận'}" FontSize="12" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Periods}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dvm:StatsPeriod">
                        <Grid ColumnDefinitions="78,*,*" Margin="0,3">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" />
                          <TextBlock Grid.Column="1" Text="{Binding Sent}" FontSize="13" TextWrapping="Wrap" Margin="0,0,6,0" />
                          <TextBlock Grid.Column="2" Text="{Binding Received}" FontSize="13" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="{l:T 'Âm thanh'}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding SoundWeek}" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding SoundTotal}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="{l:T 'Tin nhắn'}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding MessagesWeek}" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding MessagesTotal}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="2" IsVisible="{Binding HasPeers}">
                  <TextBlock Text="{l:T 'Theo máy'}" FontWeight="SemiBold" FontSize="13" />
                  <ItemsControl ItemsSource="{Binding Peers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dvm:StatsPeer">
                        <StackPanel Margin="0,3">
                          <TextBlock Text="{Binding Name}" FontSize="13" />
                          <TextBlock Classes="muted" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{l:T 'Bộ nhớ chứa file nhận'}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Classes="muted" Text="{l:T 'Đang đọc bộ nhớ…'}" IsVisible="{Binding IsMeasuring}" FontSize="12" />
                  <StackPanel Spacing="4" IsVisible="{Binding HasDrive}">
                    <ProgressBar Value="{Binding DriveUsed}" Maximum="100" MinWidth="0" />
                    <TextBlock Text="{Binding DriveText}" FontSize="13" />
                  </StackPanel>
                  <TextBlock Text="{Binding FolderText}" FontSize="13" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Kinds}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dvm:StatsKind">
                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" Margin="0,3">
                          <TextBlock Text="{Binding Name}" FontSize="13" />
                          <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Text}" FontSize="12" HorizontalAlignment="Right" />
                          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Share}" Maximum="100" MinWidth="0" Margin="0,3,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Classes="muted" Text="{Binding Since}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock Classes="h3" Text="{l:T 'Mạng'}" />
            <TextBlock Text="{Binding NetworkText}" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        </Panel>

        <!-- Short messages, e.g. "2 mục không đọc được đã bị bỏ qua": float over the page just above the tabs, then go. -->
        <Border Classes="toast" IsVisible="{Binding HasNotice}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Notice}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding CloseNoticeCommand}" Background="Transparent" BorderThickness="0" Padding="10"
                    VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Đóng'}">
              <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" Foreground="White" />
            </Button>
          </Grid>
        </Border>
      </Panel>
    </DockPanel>

    <!-- Shared from another app: pick the recipients. -->
    <Border Classes="overlay" IsVisible="{Binding HasShare}">
      <Border Classes="dialog" DataContext="{Binding Share}" x:DataType="vm:ShareViewModel">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{l:T 'Chưa kết nối với ai. Kết nối với máy tính trong tab Xóm trước.'}" IsVisible="{Binding HasNobody}" TextWrapping="Wrap" />
          <TextBox Text="{Binding Text}" IsVisible="{Binding HasText}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" />
          <ScrollViewer MaxHeight="360">
            <ItemsControl ItemsSource="{Binding People}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PickablePerson">
                  <!-- One framed card per person; the whole card toggles, a picked one is shaded. -->
                  <Border Classes="card pick" Classes.picked="{Binding IsChecked}">
                    <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Stretch" Background="Transparent">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding !IsOnline}" />
                          <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#EF4444" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{l:T 'Hủy'}" Command="{Binding CancelCommand}" />
            <Button Content="{l:T 'Gửi'}" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" Classes="accent" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Someone wants to connect: compare the code with theirs. -->
    <Border Classes="overlay" IsVisible="{Binding HasIncoming}">
      <Border Classes="dialog" DataContext="{Binding Incoming}" x:DataType="vm:IncomingPairingViewModel">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding Host}" />
          <TextBlock Text="{l:T 'Chỉ chấp nhận nếu mã này giống mã trên máy kia:'}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Code}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{l:T 'Từ chối'}" Command="{Binding DeclineCommand}" />
            <Button Content="{l:T 'Chấp nhận'}" Command="{Binding AcceptCommand}" Classes="accent" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Backup and restore, one step at a time. -->
    <Border Classes="overlay" IsVisible="{Binding Settings.IsDialogOpen}">
      <Border Classes="dialog" DataContext="{Binding Settings}" x:DataType="vm:SettingsTabViewModel">
        <StackPanel Spacing="12">
          <StackPanel Spacing="12" IsVisible="{Binding IsBackupStep}">
            <TextBlock Text="{l:T 'Sao lưu danh tính'}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BackupPrompt}" TextWrapping="Wrap" />
            <TextBox Text="{Binding BackupPassword}" PasswordChar="•" PlaceholderText="{l:T 'Mật khẩu (ít nhất 8 ký tự)'}" />
            <TextBox Text="{Binding BackupPasswordAgain}" PasswordChar="•" PlaceholderText="{l:T 'Nhập lại mật khẩu'}" />
            <TextBlock Classes="muted" Text="{l:T 'File được lưu vào Download/Shorekeeper.'}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="12" IsVisible="{Binding IsRestorePasswordStep}">
            <TextBlock Text="{l:T 'Khôi phục danh tính'}" FontSize="18" FontWeight="SemiBold" />
            <TextBox Text="{Binding RestorePassword}" PasswordChar="•" PlaceholderText="{l:T 'Mật khẩu của bản sao lưu'}" />
          </StackPanel>
          <StackPanel Spacing="12" IsVisible="{Binding IsRestoreConfirmStep}">
            <TextBlock Text="{l:T 'Khôi phục danh tính'}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RestoreSummary}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="{Binding DialogError}" IsVisible="{Binding HasDialogError}" Foreground="#EF4444" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
            <Button Content="{l:T 'Hủy'}" Command="{Binding CancelDialogCommand}" />
            <Button Content="{Binding DialogOkText}" Command="{Binding DialogOkCommand}" Classes="accent" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- The + on Xóm: a device by name or address. -->
    <Border Classes="overlay" IsVisible="{Binding HasAddPeer}">
      <Border Classes="dialog" DataContext="{Binding AddPeer}" x:DataType="vm:AddPeerViewModel">
        <StackPanel Spacing="12">
          <TextBlock Text="{l:T 'Thêm máy'}" FontSize="18" FontWeight="SemiBold" />
          <!-- The QR code: the computer's addresses and an invitation, connected without comparing the code. -->
          <Button Command="{Binding ScanCommand}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.QrCode}" Width="18" Height="18" />
              <TextBlock Text="{l:T 'Quét mã QR'}" />
            </StackPanel>
          </Button>
          <TextBlock Classes="muted" Text="{l:T 'Trên máy tính: Xóm → Mã QR. Quét xong là kết nối luôn, không cần so mã.'}" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{l:T 'Hoặc nhập tên hay IP của máy tính đang mở Shorekeeper, khi Wi-Fi không cho các máy thấy nhau:'}"
                     FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBox Text="{Binding Address}" PlaceholderText="{l:T 'Tên máy hoặc IP, vd 192.168.1.20'}" />
          <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
            <Button Content="{l:T 'Hủy'}" Command="{Binding CloseCommand}" />
            <Button Content="{l:T 'Tìm'}" Command="{Binding FindCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- "Tự nhận file…" on a contact. -->
    <Border Classes="overlay" IsVisible="{Binding HasAutoAccept}">
      <Border Classes="dialog" DataContext="{Binding AutoAccept}" x:DataType="dvm:AutoAcceptChoiceViewModel">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{l:T 'File gửi đến từ máy này, nếu không quá giới hạn, sẽ tự tải về mà không hỏi.'}" FontSize="13" TextWrapping="Wrap" />
          <RadioButton GroupName="AutoAccept" IsChecked="{Binding IsOff}" Content="{l:T 'Tắt (luôn hỏi trước khi tải)'}" />
          <RadioButton GroupName="AutoAccept" IsChecked="{Binding IsFollow}" Content="{Binding FollowText}" />
          <RadioButton GroupName="AutoAccept" IsChecked="{Binding IsCustom}" Content="{l:T 'Riêng cho máy này, tối đa'}" />
          <Grid ColumnDefinitions="*,Auto" Margin="28,0,0,0">
            <NumericUpDown Value="{Binding CustomGb}" Minimum="0.1" Maximum="10000" Increment="1" FormatString="0.##" ShowButtonSpinner="False" />
            <TextBlock Grid.Column="1" Text="GB" VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="#EF4444" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
            <Button Content="{l:T 'Hủy'}" Command="{Binding CancelCommand}" />
            <Button Content="{l:T 'Lưu'}" Command="{Binding OkCommand}" Classes="accent" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- A confirmation, or a name to type ("Đặt tên gợi nhớ"). -->
    <Border Classes="overlay" IsVisible="{Binding HasQuestion}">
      <Border Classes="dialog" DataContext="{Binding Question}" x:DataType="vm:QuestionViewModel">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />
          <TextBox Text="{Binding Input}" IsVisible="{Binding HasTextInput}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" />
          <TextBox Text="{Binding Input}" IsVisible="{Binding HasPasswordInput}" PasswordChar="●" Classes="revealPasswordButton" />
          <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
            <Button Content="{l:T 'Hủy'}" Command="{Binding CancelCommand}" />
            <Button Content="{Binding OkText}" Command="{Binding OkCommand}" Classes="accent" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- We asked to connect: the other side compares this code. -->
    <Border Classes="overlay" IsVisible="{Binding HasOutgoing}">
      <Border Classes="dialog" DataContext="{Binding Outgoing}" x:DataType="vm:OutgoingPairingViewModel">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Code}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
          <Button Content="{l:T 'Đóng'}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
