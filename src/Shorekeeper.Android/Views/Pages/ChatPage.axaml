<!-- Tin nhắn (docs/15-chat.md §6.2): the list, or one conversation over it; ← and the Back button return to the list. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Shorekeeper.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shorekeeper.Android.ViewModels"
             xmlns:ui="using:Shorekeeper.UI.ViewModels"
             x:Class="Shorekeeper.Android.Views.Pages.ChatPage"
             x:DataType="vm:MainViewModel">
  <Panel Classes="page" IsVisible="{Binding IsChatTab}">
  <Panel DataContext="{Binding Chat}" x:DataType="ui:ChatViewModel">
    <DockPanel IsVisible="{Binding !IsOpen}">
      <!-- Tìm theo nội dung (docs/18-chat-extras.md §3): no accents needed, every word must be there. -->
      <TextBox DockPanel.Dock="Top" Text="{Binding SearchQuery}" PlaceholderText="{l:T 'Tìm trong tin nhắn'}" Margin="0,0,0,8"
               IsVisible="{Binding HasConversations}" AutomationProperties.Name="{l:T 'Tìm trong tin nhắn'}">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource Icon.Search}" Width="16" Height="16" Margin="12,0,0,0" Opacity="0.7" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <Button Classes="round" Command="{Binding ClearSearchCommand}" IsVisible="{Binding IsSearching}" Width="36" Height="36" Margin="0,0,4,0"
                  AutomationProperties.Name="{l:T 'Xóa'}">
            <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
          </Button>
        </TextBox.InnerRightContent>
      </TextBox>
      <Panel>
      <StackPanel IsVisible="{Binding !HasConversations}" Spacing="6" Margin="16,48" HorizontalAlignment="Center">
        <PathIcon Data="{StaticResource Icon.Chat}" Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="{l:T 'Kết nối với một máy ở Xóm để nhắn tin cho nhau.'}" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="muted" Text="{l:T 'Không tìm thấy tin nhắn nào.'}" IsVisible="{Binding HasNoSearchHits}" Margin="16,24"
                 HorizontalAlignment="Center" />
      <ScrollViewer IsVisible="{Binding IsSearching}">
        <ItemsControl ItemsSource="{Binding SearchHits}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:ChatSearchHit">
              <Button Classes="person" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Conversation}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="tile" VerticalAlignment="Center">
                    <Panel>
                      <PathIcon Data="{StaticResource Icon.Team}" IsVisible="{Binding IsGroup}" Width="22" Height="22" />
                      <PathIcon Data="{StaticResource Icon.Chat}" IsVisible="{Binding !IsGroup}" Width="22" Height="22" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Conversation}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding Snippet}" FontSize="13" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="muted" Text="{Binding TimeText}" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <ScrollViewer IsVisible="{Binding !IsSearching}">
        <ItemsControl ItemsSource="{Binding Conversations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:ChatPersonViewModel">
              <Button Classes="person" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Panel>
                    <Border Classes="tile" VerticalAlignment="Center">
                      <Panel>
                        <PathIcon Data="{StaticResource Icon.Team}" IsVisible="{Binding IsGroup}" Width="22" Height="22" />
                        <PathIcon Data="{StaticResource Icon.Laptop}" IsVisible="{Binding IsComputer}" Width="22" Height="22" />
                        <PathIcon Data="{StaticResource Icon.Phone}" IsVisible="{Binding IsPhone}" Width="22" Height="22" />
                      </Panel>
                    </Border>
                    <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" IsVisible="{Binding IsOnline}" Width="12" Height="12"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                             Stroke="{DynamicResource Sk.WindowBackground}" StrokeThickness="2" />
                  </Panel>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes.muted="{Binding !HasUnread}" Classes.unread="{Binding HasUnread}" Text="{Binding Preview}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                      <PathIcon Data="{StaticResource Icon.Muted}" IsVisible="{Binding IsMuted}" Width="13" Height="13" Opacity="0.6" />
                      <TextBlock Classes="muted" Text="{Binding TimeText}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="@" FontWeight="Bold" Foreground="{DynamicResource AccentButtonBackground}" IsVisible="{Binding HasMention}" HorizontalAlignment="Right" />
                    <Border Background="#EF4444" CornerRadius="9" MinWidth="18" Padding="5,0" HorizontalAlignment="Right" IsVisible="{Binding HasUnread}">
                      <TextBlock Text="{Binding Unread}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      </Panel>
    </DockPanel>

    <DockPanel IsVisible="{Binding IsOpen}">
      <!-- ← Who, and whether they are there; ⋮ for the conversation. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
        <Button Grid.Column="2" Classes="round" Width="40" Height="40" CornerRadius="20" Margin="0,0,-6,0" AutomationProperties.Name="{l:T 'Thêm'}">
          <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16">
            <PathIcon.RenderTransform>
              <RotateTransform Angle="90" />
            </PathIcon.RenderTransform>
          </PathIcon>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{l:T 'Đặt tên gợi nhớ…'}" Command="{Binding RenameCurrentCommand}" IsVisible="{Binding !Current.IsGroup, FallbackValue=False}" />
              <MenuItem Header="{l:T 'Thành viên'}" Command="{Binding ShowMembersCommand}" IsVisible="{Binding Current.IsGroup, FallbackValue=False}" />
              <MenuItem Header="{Binding Current.MuteText, FallbackValue=''}" Command="{Binding ToggleMuteCommand}" IsVisible="{Binding Current.IsGroup, FallbackValue=False}" />
              <MenuItem Header="{l:T 'Xóa hội thoại…'}" Command="{Binding DeleteConversationCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Classes="round" Command="{Binding CloseCommand}" Width="40" Height="40" CornerRadius="20" Margin="-6,0,4,0"
                AutomationProperties.Name="{l:T 'Quay lại'}">
          <PathIcon Data="{StaticResource Icon.ArrowLeft}" Width="20" Height="20" />
        </Button>
        <StackPanel Grid.Column="1" DataContext="{Binding Current}" x:DataType="ui:ChatPersonViewModel" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="dot" Classes.busy="{Binding IsBusy}" Classes.muted="{Binding !IsOnline}" IsVisible="{Binding !IsGroup}" />
            <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- "Chọn nhiều": [☐ Chọn tất cả] Đã chọn N … [✕ end choosing] [Xóa the checked messages]. -->
      <Border DockPanel.Dock="Top" Classes="card selectionbar" IsVisible="{Binding IsSelecting}" Margin="0,0,0,6" Padding="12,6">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <CheckBox IsChecked="{Binding AllSelected}" Content="{l:T 'Chọn tất cả'}" />
          <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SelectedText}" FontSize="12" Margin="8,0" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="round close" Command="{Binding StopSelectingCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                  AutomationProperties.Name="{l:T 'Xong'}">
            <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
          </Button>
          <Button Grid.Column="3" Content="{l:T 'Xóa'}" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}" Padding="14,5" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- 📎 (files to this person), the box, and ➤; empty, 🎤 instead: hold to record, slide left to cancel, let go to send. -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,10">
        <TextBlock Classes="muted" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" FontSize="12" TextWrapping="Wrap" />
        <!-- Answering a message (docs/18-chat-extras.md §4): what, and ✕ to stop. -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsReplying}">
          <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentButtonBackground}" Margin="4,2,8,2" />
          <TextBlock Grid.Column="1" Text="{Binding ReplyingText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="round" Command="{Binding CancelReplyCommand}" AutomationProperties.Name="{l:T 'Hủy'}">
            <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
          </Button>
        </Grid>
        <!-- Changing the words of our message (docs/18-chat-extras.md §5): ✕ to stop. -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsEditing}">
          <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentButtonBackground}" Margin="4,2,8,2" />
          <TextBlock Grid.Column="1" Text="{l:T 'Sửa tin nhắn'}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="round" Command="{Binding CancelEditCommand}" AutomationProperties.Name="{l:T 'Hủy'}">
            <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
          </Button>
        </Grid>
        <!-- "@" typed in a group: members to name. -->
        <ItemsControl ItemsSource="{Binding MentionCandidates}" IsVisible="{Binding HasMentionCandidates}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:ChatMentionCandidate">
              <Button Content="{Binding Label}" Command="{Binding $parent[ItemsControl].((ui:ChatViewModel)DataContext).MentionCommand}" CommandParameter="{Binding}"
                      Padding="10,4" Margin="0,0,6,6" Focusable="False" Click="OnMentionChosen" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Classes="round" Command="{Binding AttachCommand}" IsEnabled="{Binding CanAttach}" Width="40" Height="40" CornerRadius="20" Margin="-6,0,2,1"
                  VerticalAlignment="Bottom" AutomationProperties.Name="{l:T 'Gửi file…'}">
            <PathIcon Data="{StaticResource Icon.Attach}" Width="20" Height="20" />
          </Button>
          <TextBox Grid.Column="1" x:Name="ChatBox" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" IsEnabled="{Binding CanWrite}" CornerRadius="20" Padding="14,9"
                   VerticalContentAlignment="Center" TextInputOptions.Multiline="True" TextInputOptions.ReturnKeyType="Return"
                   PlaceholderText="{l:T 'Nhập tin nhắn…'}" AutomationProperties.Name="{l:T 'Tin nhắn'}" IsVisible="{Binding IsComposing}" />
          <Border Grid.Column="1" IsVisible="{Binding IsRecording}" Background="{DynamicResource Sk.TileBackground}" CornerRadius="20" Height="42" Padding="16,0">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <Ellipse Classes="dot error" Classes.recording="{Binding IsRecording}" Width="10" Height="10" />
              <TextBlock Grid.Column="1" Text="{Binding RecordingText}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" />
              <TextBlock Grid.Column="2" Classes="muted" Text="{l:T '‹ Vuốt sang trái để hủy'}" IsVisible="{Binding !WillCancel}" FontSize="13"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{l:T 'Thả tay để hủy'}" IsVisible="{Binding WillCancel}" Foreground="#EF4444" FontSize="13"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Panel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom">
            <Button Classes="accent" Command="{Binding SendCommand}" Width="42" Height="42" CornerRadius="21" Padding="0" IsVisible="{Binding ShowsSend}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="{l:T 'Gửi'}">
              <PathIcon Data="{StaticResource Icon.Send}" Width="18" Height="18" />
            </Button>
            <Border Classes="mic" Classes.active="{Binding IsRecording}" Classes.cancel="{Binding WillCancel}" IsVisible="{Binding ShowsMicrophone}" IsEnabled="{Binding CanWrite}"
                    PointerPressed="OnMicPressed" PointerMoved="OnMicMoved" PointerReleased="OnMicReleased" PointerCaptureLost="OnMicLost"
                    AutomationProperties.Name="{l:T 'Giữ để ghi tin nhắn thoại'}">
              <PathIcon Data="{StaticResource Icon.Mic}" Width="20" Height="20" Foreground="{DynamicResource AccentButtonForeground}" />
            </Border>
          </Panel>
        </Grid>
      </StackPanel>

      <Panel>
        <TextBlock Classes="muted" IsVisible="{Binding HasNoMessages}" Text="{l:T 'Chưa có tin nhắn. Gửi lời chào đi!'}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border Classes="card" ZIndex="1" IsVisible="{Binding HasDetails}" MaxHeight="420" VerticalAlignment="Top" Padding="14,10">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <TextBlock Text="{Binding DetailsTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="round close" Command="{Binding CloseDetailsCommand}" AutomationProperties.Name="{l:T 'Đóng'}">
                <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
              </Button>
            </Grid>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ui:ChatMemberViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding StateText}" FontSize="12" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="{l:T 'Gửi lại'}" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}"
                              Padding="10,4" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="round" IsVisible="{Binding CanRename}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Thêm'}">
                        <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16">
                          <PathIcon.RenderTransform>
                            <RotateTransform Angle="90" />
                          </PathIcon.RenderTransform>
                        </PathIcon>
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="{l:T 'Đặt tên gợi nhớ…'}" Command="{Binding RenameCommand}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <ScrollViewer x:Name="ChatScroller">
          <ItemsControl ItemsSource="{Binding Messages}">
            <!-- Only the messages on screen are built and measured: all of them took a second to lay out. -->
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="{x:Type ui:ChatBubbleViewModel}" x:DataType="ui:ChatBubbleViewModel">
                <StackPanel>
                  <TextBlock Classes="muted" Text="{Binding DayText}" IsVisible="{Binding HasDay}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,6" />
                  <!-- While choosing, a tap anywhere on the row checks or unchecks the message. -->
                  <Grid Classes="chatrow" Classes.picked="{Binding IsSelected}" ColumnDefinitions="Auto,Auto,*" Tapped="OnChatRowTapped">
                  <CheckBox Classes="pick" IsChecked="{Binding IsSelected}" IsVisible="{Binding Owner.IsSelecting}" VerticalAlignment="Center" MinWidth="0" Width="24" Padding="0" Margin="0,0,10,0"
                            AutomationProperties.Name="{l:T 'Chọn'}" />
                  <!-- In a group: the member's initial beside the first of their run of messages. -->
                  <Panel Grid.Column="1" Width="30" Margin="0,5,6,0" VerticalAlignment="Top" IsVisible="{Binding HasAvatarSpace}">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{Binding AuthorBrush}" IsVisible="{Binding ShowsAuthor}">
                      <TextBlock Text="{Binding AuthorInitial}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Panel>
                  <!-- Long press: copy the words, choose several, or take the message away here. -->
                  <Border Grid.Column="2" Classes="bubble" Classes.mine="{Binding IsMine}" Classes.unknown="{Binding IsUnknown}" Classes.mention="{Binding MentionsMe}"
                          Holding="OnBubbleHolding">
                    <FlyoutBase.AttachedFlyout>
                      <MenuFlyout>
                        <MenuItem Header="{l:T 'Trả lời'}" Command="{Binding ReplyCommand}" IsVisible="{Binding CanReply}" />
                        <MenuItem Header="{l:T 'Sửa'}" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" />
                        <MenuItem Header="{l:T 'Sao chép'}" Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}" />
                        <MenuItem Header="{Binding RecallText}" Command="{Binding RecallCommand}" IsVisible="{Binding CanRecall}" />
                        <MenuItem Header="{l:T 'Chi tiết'}" Command="{Binding ShowDetailsCommand}" IsVisible="{Binding CanShowDetails}" />
                        <MenuItem Header="{l:T 'Chọn nhiều'}" Command="{Binding SelectManyCommand}" />
                        <MenuItem Header="{l:T 'Xóa tin nhắn'}" Command="{Binding DeleteCommand}" />
                      </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding AuthorName}" Foreground="{Binding AuthorBrush}" IsVisible="{Binding ShowsAuthor}" FontSize="13" FontWeight="SemiBold" />
                      <!-- What this answers (docs/18-chat-extras.md §4): clicked, the conversation goes to it. -->
                      <Button Classes="quote" Command="{Binding ShowQuoteCommand}" IsVisible="{Binding HasQuote}">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding QuoteAuthor}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding QuoteText}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                      <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" IsVisible="{Binding IsText}" />
                      <ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Classes="link" Command="{Binding $parent[ItemsControl].((ui:ChatBubbleViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}">
                              <TextBlock Text="{Binding}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsVoice}" Margin="-4,2,0,0">
                        <Button Classes="play" Command="{Binding PlayCommand}" AutomationProperties.Name="{l:T 'Phát'}">
                          <Panel>
                            <PathIcon Data="{StaticResource Icon.Play}" Width="14" Height="14" IsVisible="{Binding !IsPlaying}" Margin="2,0,0,0" />
                            <PathIcon Data="{StaticResource Icon.Pause}" Width="14" Height="14" IsVisible="{Binding IsPlaying}" />
                          </Panel>
                        </Button>
                        <Panel Grid.Column="1" Margin="8,0" Height="26" VerticalAlignment="Center">
                          <ItemsControl ItemsSource="{Binding Bars}" Opacity="0.4">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:Double">
                                <Rectangle Classes="bar" Height="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Panel Width="{Binding PlayedWidth}" HorizontalAlignment="Left" ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding Bars}" Width="{x:Static ui:ChatBubbleViewModel.WaveWidth}" HorizontalAlignment="Left">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:Double">
                                  <Rectangle Classes="bar" Height="{Binding}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Panel>
                        </Panel>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" FontSize="13" />
                      </Grid>
                      <!-- Came while its author was out of the group, before this device knew (docs/16-group-chat.md §3.6). -->
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsOutOfGroup}">
                        <PathIcon Data="{StaticResource Icon.Block}" Width="11" Height="11" Foreground="#D97706" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T 'Gửi lúc người này không còn trong nhóm'}" FontSize="12" Foreground="#D97706" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <Button Content="{l:T 'Gửi lại'}" Command="{Binding RetryCommand}" IsVisible="{Binding IsFailed}" Padding="8,2" FontSize="12" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  </Grid>
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="{x:Type ui:ChatFileViewModel}" x:DataType="ui:ChatFileViewModel">
                <StackPanel>
                  <TextBlock Classes="muted" Text="{Binding DayText}" IsVisible="{Binding HasDay}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,6" />
                  <!-- Long press: take back what we sent (five minutes), then only stop sharing it; copy text, or see files in File. -->
                  <Border Classes="filecard" Classes.mine="{Binding IsMine}" Holding="OnFileCardHolding">
                    <FlyoutBase.AttachedFlyout>
                      <MenuFlyout>
                        <MenuItem Header="{l:T 'Trả lời'}" Command="{Binding ReplyCommand}" IsVisible="{Binding !IsRecalled}" />
                        <MenuItem Header="{Binding RecallText}" Command="{Binding RecallCommand}" IsVisible="{Binding CanRecall}" />
                        <MenuItem Header="{l:T 'Ngừng chia sẻ'}" Command="{Binding WithdrawCommand}" IsVisible="{Binding CanStopSharing}" />
                        <MenuItem Header="{l:T 'Sao chép'}" Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}" />
                        <MenuItem Header="Xem" Command="{Binding ShowCommand}" IsVisible="{Binding IsFiles}" />
                      </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                    <StackPanel Spacing="4">
                    <TextBlock Text="{Binding AuthorName}" Foreground="{Binding AuthorBrush}" IsVisible="{Binding ShowsAuthor}" FontSize="13" FontWeight="SemiBold" />
                    <Panel>
                    <!-- Taken back by its sender: a note, as for a message. -->
                    <StackPanel IsVisible="{Binding IsRecalled}" Spacing="2">
                      <TextBlock Text="{Binding RecalledText}" FontStyle="Italic" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" HorizontalAlignment="Right" />
                    </StackPanel>
                    <!-- An offer of pictures shows the first few, or all of them small after "+N ảnh"; click one to open it. -->
                    <StackPanel IsVisible="{Binding HasPictures}" Spacing="4">
                      <ItemsControl ItemsSource="{Binding Pictures}" IsVisible="{Binding !IsExpanded}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="ui:ChatPicture">
                            <Button Classes="picture" Command="{Binding $parent[ItemsControl].((ui:ChatFileViewModel)DataContext).OpenPictureCommand}" CommandParameter="{Binding}">
                              <Border CornerRadius="10" ClipToBounds="True">
                                <Image Source="{Binding Image}" MaxWidth="260" MaxHeight="300" Stretch="Uniform" />
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding AllPictures}" IsVisible="{Binding IsExpanded}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="3" ColumnSpacing="4" RowSpacing="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="ui:ChatPicture">
                            <Button Classes="picture" Command="{Binding $parent[ItemsControl].((ui:ChatFileViewModel)DataContext).OpenPictureCommand}" CommandParameter="{Binding}">
                              <Border CornerRadius="6" ClipToBounds="True">
                                <Image Source="{Binding Image}" Width="84" Height="84" Stretch="UniformToFill" />
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="link" Command="{Binding ToggleMoreCommand}" Click="OnMorePictures" IsVisible="{Binding HasMore}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding MoreText}" FontSize="12" />
                        </Button>
                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusText}" FontSize="11" />
                      </Grid>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsPlain}">
                      <Border Classes="tile" Width="38" Height="38" CornerRadius="9">
                        <Panel>
                          <PathIcon Data="{StaticResource Icon.Document}" IsVisible="{Binding !IsText}" Width="18" Height="18" />
                          <PathIcon Data="{StaticResource Icon.Text}" IsVisible="{Binding IsText}" Width="18" Height="18" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" IsVisible="{Binding IsFiles}" />
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" IsVisible="{Binding CanCopy}" />
                        <TextBlock Classes="muted" Text="{Binding Text}" FontSize="15" FontStyle="Italic" IsVisible="{Binding IsEmptyText}" />
                        <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsDownloading}" MinWidth="0" Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                          <Button Classes="accent" Content="{l:T 'Tải'}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Padding="14,6" />
                          <Button Content="Xem" Command="{Binding ShowCommand}" Padding="14,6" IsVisible="{Binding IsFiles}" />
                          <Button Content="{l:T 'Sao chép'}" Command="{Binding CopyCommand}" Padding="14,6" IsVisible="{Binding CanCopy}" />
                          <Button Content="{l:T 'Mở'}" Command="{Binding OpenLinkCommand}" Padding="14,6" IsVisible="{Binding IsLink}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                    </Panel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </Panel>
  </Panel>
</UserControl>
